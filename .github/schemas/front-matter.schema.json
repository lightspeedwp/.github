  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Front Matter",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string" },
    "slug":  { "type": "string" },
    "series": { "type": ["object","string"] },
