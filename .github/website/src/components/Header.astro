---
import { CATEGORIES } from '../lib/catalogue';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

const isActive = (path: string): boolean => {
  const baseClean = base.replace(/\/$/, '');
  const rawNorm = pathname.replace(/\/$/, '');
  const norm = baseClean && rawNorm.startsWith(baseClean) ? rawNorm.slice(baseClean.length) : rawNorm;
  const p = path.replace(/\/$/, '');
  return norm === p || norm.startsWith(p + '/');
};

/* Icon path data (Heroicons-style, 24×24, 1.6 stroke) */
const icons = {
  chevronDown: `<path d="M6 9l6 6 6-6"/>`,
  search:      `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>`,
  robot:    `<rect x="4" y="8" width="16" height="11" rx="2"/><path d="M12 8V5M9 5h6M9 13h.01M15 13h.01M9 16h6"/>`,
  book:     `<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM19 3v16"/>`,
  chat:     `<path d="M21 12a8 8 0 0 1-8 8H6l-3 2v-5a8 8 0 1 1 18-5z"/><path d="M8 11h8M8 14h5"/>`,
  sparkles: `<path d="M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/>`,
  shield:   `<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8L15 10"/>`,
  workflow: `<rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="15" y="15" width="6" height="6" rx="1.5"/><path d="M6 9v3a3 3 0 0 0 3 3h6"/>`,
  puzzle:   `<path d="M10 4a1.5 1.5 0 0 1 3 0c0 .8.7 1 1.5 1H17v2.5c0 .8.2 1.5 1 1.5a1.5 1.5 0 0 1 0 3c-.8 0-1 .7-1 1.5V17h-2.5c-.8 0-1.5.2-1.5 1a1.5 1.5 0 0 1-3 0c0-.8-.7-1-1.5-1H5v-2.5c0-.8-.2-1.5-1-1.5a1.5 1.5 0 0 1 0-3c.8 0 1-.7 1-1.5V5h2.5C8.3 5 9 4.8 9 4z"/>`,
  wrench:   `<path d="M15 7a4 4 0 0 0-5 5l-6 6 2 2 6-6a4 4 0 0 0 5-5l-2.5 2.5L12 12l-1-2.5z"/>`,
  bolt:     `<path d="M13 3L5 13h6l-1 8 8-10h-6z"/>`,
  download: `<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>`,
  layers:   `<path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5M3 16.5l9 5 9-5"/>`,
  github:   `<path d="M9 19c-4 1.2-4-2-6-2.5M15 21v-3.5c0-1 .2-1.6-.5-2.2 2.3-.3 4.5-1.2 4.5-5a3.9 3.9 0 0 0-1-2.7 3.6 3.6 0 0 0-.1-2.7s-.9-.3-2.9 1a10 10 0 0 0-5 0C7 3.6 6.1 3.9 6.1 3.9a3.6 3.6 0 0 0-.1 2.7A3.9 3.9 0 0 0 5 9.3c0 3.8 2.2 4.7 4.5 5-.5.5-.5 1-.5 1.6V21"/>`,
  external: `<path d="M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>`,
  menu:     `<path d="M4 6h16M4 12h16M4 18h16"/>`,
  close:    `<path d="M6 6l12 12M18 6L6 18"/>`,
};

const catIconMap: Record<string, string> = {
  agents: icons.robot, instructions: icons.book, prompts: icons.chat,
  skills: icons.sparkles, hooks: icons.shield, workflows: icons.workflow,
  plugins: icons.puzzle, tools: icons.wrench,
};

function svg(paths: string, size = 20) {
  return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
}

const resources = [
  { href: `${base}onboarding/`,       icon: icons.bolt,     label: 'Onboarding journey' },
  { href: `${base}getting-started/`,  icon: icons.download, label: 'Getting started'    },
  { href: `${base}why/`,              icon: icons.layers,   label: 'Why this exists'    },
  { href: `${base}glossary/`,         icon: icons.book,     label: 'Glossary'           },
  { href: `${base}references/`,       icon: icons.github,   label: 'References'         },
];
---

<!-- ── Header ──────────────────────────────────────────────────── -->
<header class="nav" role="banner">
  <div class="wrap nav-inner">

    <!-- Brand (always visible) -->
    <a class="nav-brand" href={base} aria-label="Awesome GitHub — home">
      <img class="brand-icon brand-icon-light" src={`${base}assets/LS-Agency-Site-Icon-Blue.svg`} alt="LightSpeed" width="28" height="28" />
      <img class="brand-icon brand-icon-dark"  src={`${base}assets/LS-Agency-Site-Icon-Light-Blue.svg`} alt="" aria-hidden="true" width="28" height="28" />
      <b>Awesome<span class="tld"> GitHub</span></b>
    </a>

    <!-- Desktop primary nav (hidden ≤1024px) -->
    <nav class="nav-primary" aria-label="Main navigation">

      <!-- Browse dropdown -->
      <div class="nav-dropdown-wrap">
        <button class="nav-btn nav-dropdown-trigger" type="button" aria-expanded="false" aria-controls="browse-dropdown">
          Browse
          <span class="chev" set:html={svg(icons.chevronDown, 15)} />
        </button>
        <div class="nav-dropdown dd-cats" id="browse-dropdown">
          {CATEGORIES.map(cat => (
            <a href={`${base}c/${cat.id}/`} class="dd-item">
              <div class="ddi" set:html={svg(catIconMap[cat.id] ?? icons.robot, 16)} />
              <div>
                <b>{cat.label}</b>
                <span>{cat.blurb}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <a href={`${base}cookbook/`} class="nav-btn" aria-current={isActive('/cookbook') ? 'page' : undefined}>Cookbook</a>
      <a href={`${base}learn/`}    class="nav-btn" aria-current={isActive('/learn') ? 'page' : undefined}>Learn</a>

      <!-- Resources dropdown -->
      <div class="nav-dropdown-wrap">
        <button class="nav-btn nav-dropdown-trigger" type="button" aria-expanded="false" aria-controls="resources-dropdown">
          Resources
          <span class="chev" set:html={svg(icons.chevronDown, 15)} />
        </button>
        <div class="nav-dropdown dd-res" id="resources-dropdown">
          {resources.map(r => (
            <a href={r.href} class="dd-simple">
              <span class="ddi" set:html={svg(r.icon, 16)} />
              {r.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Desktop actions (hidden ≤1024px) -->
    <div class="nav-actions">
      <button class="search-trigger" type="button" id="search-trigger-desktop" aria-label="Search resources">
        <span set:html={svg(icons.search, 16)} />
        <span class="stxt">Search resources</span>
        <span class="kbd search-kbd-hint">⌘K</span>
      </button>

      <div class="nav-extra">
        <!-- Branch toggle -->
        <div class="branch-pill" role="group" aria-label="Repository branch">
          <button class="branch-btn" data-branch="main" aria-pressed="true" type="button">
            <span class="bdot"></span>main
          </button>
          <button class="branch-btn" data-branch="develop" aria-pressed="false" type="button">
            <span class="bdot"></span>dev
          </button>
        </div>

        <!-- Theme toggle (desktop) — icon injected by JS -->
        <button class="icon-btn theme-toggle-btn" type="button" aria-label="Toggle theme"></button>

        <!-- GitHub link -->
        <a href="https://github.com/lightspeedwp/.github" target="_blank" rel="noopener noreferrer"
           class="icon-btn" aria-label="GitHub repository" set:html={svg(icons.github, 18)} />
      </div>
    </div>

    <!-- Mobile actions (hidden >1024px): theme → search → burger -->
    <div class="mobile-actions">
      <button class="icon-btn theme-toggle-btn" type="button" aria-label="Toggle theme"></button>
      <button class="icon-btn" type="button" id="search-btn-mobile" aria-label="Search">
        <span set:html={svg(icons.search, 20)} />
      </button>
      <button class="icon-btn burger" type="button" id="burger-btn" aria-label="Open menu" aria-controls="nav-drawer" aria-expanded="false">
        <span set:html={svg(icons.menu, 20)} />
      </button>
    </div>

  </div>
</header>

<!-- Drawer scrim -->
<div id="drawer-scrim" aria-hidden="true"></div>

<!-- Mobile drawer -->
<aside id="nav-drawer" aria-label="Navigation menu" aria-hidden="true" inert>
  <div class="drawer-head">
    <a class="nav-brand" href={base} aria-label="Awesome GitHub — home">
      <img class="brand-icon brand-icon-light" src={`${base}assets/LS-Agency-Site-Icon-Blue.svg`} alt="LightSpeed" width="26" height="26" />
      <img class="brand-icon brand-icon-dark"  src={`${base}assets/LS-Agency-Site-Icon-Light-Blue.svg`} alt="" aria-hidden="true" width="26" height="26" />
      <b>Awesome<span class="tld"> GitHub</span></b>
    </a>
    <button class="icon-btn" type="button" id="drawer-close" aria-label="Close menu" set:html={svg(icons.close, 20)} />
  </div>

  <div class="drawer-body">
    <!-- Search -->
    <div class="drawer-sec">
      <button class="search-trigger" type="button" id="search-btn-drawer" style="width:100%;" aria-label="Search resources">
        <span set:html={svg(icons.search, 16)} />
        <span class="stxt" style="flex:1;text-align:left;">Search resources</span>
      </button>
    </div>

    <!-- Browse -->
    <div class="drawer-sec">
      <h6>BROWSE</h6>
      <div class="drawer-grid">
        {CATEGORIES.map(cat => (
          <a href={`${base}c/${cat.id}/`} class="drawer-link">
            <span class="dli" set:html={svg(catIconMap[cat.id] ?? icons.robot, 18)} />
            <span>{cat.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Cook & Learn -->
    <div class="drawer-sec">
      <h6>COOK &amp; LEARN</h6>
      <a href={`${base}cookbook/`} class="drawer-link">
        <span class="dli" set:html={svg(icons.bolt, 18)} />
        <span>Cookbook</span>
      </a>
      <a href={`${base}learn/`} class="drawer-link">
        <span class="dli" set:html={svg(icons.layers, 18)} />
        <span>Learning Centre</span>
      </a>
    </div>

    <!-- Resources -->
    <div class="drawer-sec">
      <h6>RESOURCES</h6>
      {resources.map(r => (
        <a href={r.href} class="drawer-link">
          <span class="dli" set:html={svg(r.icon, 18)} />
          <span>{r.label}</span>
        </a>
      ))}
    </div>

    <!-- Install source -->
    <div class="drawer-sec">
      <h6>INSTALL SOURCE</h6>
      <div class="drawer-row">
        <span class="rl">Branch</span>
        <div class="branch-pill" role="group" aria-label="Repository branch">
          <button class="branch-btn" data-branch="main" aria-pressed="true" type="button">
            <span class="bdot"></span>main
          </button>
          <button class="branch-btn" data-branch="develop" aria-pressed="false" type="button">
            <span class="bdot"></span>dev
          </button>
        </div>
      </div>
      <div class="drawer-row">
        <span class="rl">Theme</span>
        <!-- Icon injected by JS — uses .theme-toggle-btn class -->
        <button class="icon-btn theme-toggle-btn" type="button" aria-label="Toggle theme"></button>
      </div>
    </div>

    <!-- External -->
    <div class="drawer-sec">
      <h6>EXTERNAL</h6>
      <a href="https://github.com/lightspeedwp/.github" target="_blank" rel="noopener noreferrer" class="drawer-link">
        <span class="dli" set:html={svg(icons.github, 18)} />
        <span>.github repository</span>
        <span class="ext" set:html={svg(icons.external, 14)} />
      </a>
      <a href="https://lightspeedwp.agency/" target="_blank" rel="noopener noreferrer" class="drawer-link">
        <span class="dli" set:html={svg(icons.bolt, 18)} />
        <span>LightSpeed site</span>
        <span class="ext" set:html={svg(icons.external, 14)} />
      </a>
    </div>
  </div>
</aside>

<script>
  import '../scripts/theme-toggle.js';
  import '../scripts/header.js';

  /* Wire drawer search button to same event */
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('search-btn-drawer')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('ag:open-search'));
    });
  });
</script>

<style is:global>
  /* Brand icon CSS swap — no JS, no flicker */
  [data-theme="light"] .brand-icon-dark  { display: none; }
  [data-theme="dark"]  .brand-icon-light { display: none; }
  :root:not([data-theme="dark"]) .brand-icon-dark { display: none; }

  /* Body scroll lock when drawer open */
  body.drawer-open { overflow: hidden; }
</style>

<style>
  /* ── Nav bar ───────────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h, 64px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hair);
    transition: height var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .nav.nav-shrunk {
    height: 52px;
    box-shadow: var(--shadow-sm);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 100%;
    max-width: var(--container-max, 1320px);
    margin: 0 auto;
    padding: 0 var(--gutter, 32px);
  }

  /* ── Brand ──────────────────────────────────────────────────────── */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg-1);
    flex-shrink: 0;
  }

  .nav-brand b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.02em;
  }

  .nav-brand .tld { color: var(--accent); }

  /* ── Primary nav ────────────────────────────────────────────────── */
  .nav-primary {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 10px;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-2);
    background: transparent;
    border: none;
    text-decoration: none;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .nav-btn:hover,
  .nav-btn.open {
    color: var(--fg-1);
    background: var(--panel-2);
  }

  .chev {
    display: flex;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav-dropdown-wrap.open .chev { transform: rotate(180deg); }

  /* ── Dropdowns ──────────────────────────────────────────────────── */
  .nav-dropdown-wrap { position: relative; }

  .nav-dropdown {
    position: absolute;
    top: calc(100% - 4px);
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 10px;
    z-index: 55;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition:
      opacity var(--dur) var(--ease-out),
      visibility var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .nav-dropdown-wrap.open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Browse: 2-col grid */
  .dd-cats {
    left: 0;
    width: min(620px, 92vw);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .dd-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur) var(--ease-out);
  }

  .dd-item:hover { background: var(--panel-2); }

  .dd-item .ddi {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    flex: none;
  }

  .dd-item b {
    font-size: 14px;
    color: var(--fg-1);
    font-family: var(--font-display);
    font-weight: 700;
    display: block;
  }

  .dd-item span {
    font-size: 12px;
    color: var(--fg-3);
    line-height: 1.4;
  }

  /* Resources: simple list */
  .dd-res { width: 250px; }

  .dd-simple {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    font-size: 14px;
    color: var(--fg-1);
    text-decoration: none;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .dd-simple:hover { background: var(--panel-2); color: var(--accent); }
  .dd-simple .ddi { color: var(--fg-3); transition: color var(--dur) var(--ease-out); }
  .dd-simple:hover .ddi { color: var(--accent); }

  /* ── Search trigger ────────────────────────────────────────────── */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: var(--panel-2);
    border: 1px solid var(--hair);
    color: var(--fg-2);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    font-family: var(--font-body);
    font-size: 13px;
    min-width: 200px;
    transition: border-color var(--dur) var(--ease-out);
  }

  .search-trigger:hover { border-color: var(--border-strong); }
  .search-trigger .stxt { flex: 1; text-align: left; }

  .kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--bg);
    border: 1px solid var(--hair);
    color: var(--fg-3);
    margin-left: auto;
  }

  /* ── Nav actions ────────────────────────────────────────────────── */
  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-extra {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Branch pill ──────────────────────────────────────────────── */
  .branch-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hair);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--panel);
  }

  .branch-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-3);
    padding: 7px 11px;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .branch-btn:hover { color: var(--fg-1); }
  .branch-btn[aria-pressed="true"] { background: var(--accent); color: var(--accent-contrast); }

  .bdot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* ── Icon button ────────────────────────────────────────────────── */
  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--hair);
    border-radius: var(--radius-md);
    color: var(--fg-2);
    padding: 0;
    text-decoration: none;
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .icon-btn:hover { color: var(--fg-1); background: var(--panel-2); }

  /* ── Mobile actions ─────────────────────────────────────────────── */
  .mobile-actions {
    display: none;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  /* ── Drawer scrim ───────────────────────────────────────────────── */
  #drawer-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--c-black) 50%, transparent);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur) var(--ease-out), visibility var(--dur) var(--ease-out);
  }

  body.drawer-open #drawer-scrim {
    opacity: 1;
    visibility: visible;
  }

  /* ── Drawer ─────────────────────────────────────────────────────── */
  #nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 91;
    width: min(360px, 87vw);
    background: var(--panel);
    border-left: 1px solid var(--hair);
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 200ms var(--ease-out);
  }

  #nav-drawer[aria-hidden="false"] { transform: translateX(0); }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--hair);
    position: sticky;
    top: 0;
    background: var(--panel);
    z-index: 1;
  }

  .drawer-body { padding: 12px 12px 32px; }

  .drawer-sec { margin-top: 16px; }

  .drawer-sec h6 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    margin: 0 0 4px;
    padding: 0 10px;
    font-weight: 700;
    font-family: var(--font-body);
  }

  .drawer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 10px;
    border-radius: var(--radius-md);
    color: var(--fg-1);
    text-decoration: none;
    font-size: 15px;
    font-family: var(--font-body);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

