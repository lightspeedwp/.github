---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  disabled?: boolean;
  class?: string;
}

const { href, variant = "primary", size = "md", disabled = false, class: className } = Astro.props;
const Element = href && !disabled ? "a" : "button";
---

<Element
  href={Element === "a" ? href : undefined}
  disabled={Element === "button" ? disabled : undefined}
  class={`ag-button ag-button--${variant} ag-button--${size} ${className || ""}`}
  {...(Element === "button" ? { type: "button" } : {})}
>
  <slot />
</Element>

<style>
  .ag-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-body);
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: 1px solid transparent;
    transition: all var(--dur) var(--ease-out);
    white-space: nowrap;
  }

  /* Primary button */
  .ag-button--primary {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
  }

  .ag-button--primary:hover:not(:disabled) {
    background: var(--c-brand-blue-hover);
    border-color: var(--c-brand-blue-hover);
  }

  .ag-button--primary:active:not(:disabled) {
    background: var(--c-brand-blue-press);
    border-color: var(--c-brand-blue-press);
    transform: scale(0.98);
  }

  /* Secondary button (outline) */
  .ag-button--secondary {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }

  .ag-button--secondary:hover:not(:disabled) {
    background: var(--accent-soft);
  }

  .ag-button--secondary:active:not(:disabled) {
    transform: scale(0.98);
  }

  /* Ghost button */
  .ag-button--ghost {
    background: transparent;
    color: var(--fg-link);
    border-color: transparent;
  }

  .ag-button--ghost:hover:not(:disabled) {
    background: var(--accent-soft);
    color: var(--fg-link-hover);
  }

  .ag-button--ghost:active:not(:disabled) {
    transform: scale(0.98);
  }

  /* Sizes */
  .ag-button--sm {
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-body-sm);
  }

  .ag-button--lg {
    padding: var(--space-4) var(--space-6);
    font-size: var(--fs-body);
  }

  /* Disabled state */
  .ag-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Focus state */
  .ag-button:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }
</style>
