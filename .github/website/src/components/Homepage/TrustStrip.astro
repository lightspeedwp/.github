---

<section class="hp-trust-strip" data-screen-label="02 Trust Strip">
  <div class="wrap">
    <div class="hp-trust-grid">
      <div class="hp-stat">
        <div class="hp-stat-value">12+</div>
        <div class="hp-stat-label">Years delivering WordPress platforms</div>
      </div>
      <div class="hp-stat">
        <div class="hp-stat-value">100+</div>
        <div class="hp-stat-label">Projects launched across industries</div>
      </div>
      <div class="hp-stat">
        <div class="hp-stat-value">5★</div>
        <div class="hp-stat-label">Rated on Clutch by verified clients</div>
      </div>
      <div class="hp-stat">
        <div class="hp-stat-value">FSE</div>
        <div class="hp-stat-label">Block-theme specialists since day one</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hp-trust-strip {
    background: var(--bg);
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    transition: background var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .hp-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .hp-stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 24px;
    border-left: 2px solid var(--border);
    transition: border-color var(--dur) var(--ease-out);
  }

  .hp-stat-value {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 36px;
    letter-spacing: -0.03em;
    color: var(--fg-1);
    line-height: 1;
  }

  .hp-stat-label {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
    color: var(--fg-2);
  }

  @media (max-width: 900px) {
    .hp-trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 480px) {
    .hp-trust-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hp-stat {
      padding-left: 0;
      padding-top: 16px;
      border-left: none;
      border-top: 1px solid var(--border);
    }

    .hp-stat:first-child {
      padding-top: 0;
      border-top: none;
    }
  }
</style>
