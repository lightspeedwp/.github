---
interface Props {
  activeSection?: string;
}

const { activeSection } = Astro.props;

const navLinks = [
  { label: "Solutions", href: "#solutions" },
  { label: "FAQ", href: "#faq" },
  { label: "Contact", href: "#contact" },
];
---

<nav class="hp-nav">
  <div class="hp-nav-inner">
    <!-- Logo -->
    <a href="/" class="hp-nav-logo">
      <img
        src="/logos/LS-Agency-Site-Icon-Blue.svg"
        alt="LightSpeed"
        class="hp-nav-icon"
      />
      <span class="hp-nav-wordmark">
        <span class="hp-logo-main">LightSpeed</span>
        <span class="hp-logo-accent">WP</span>
        <span class="hp-logo-muted">.Agency</span>
      </span>
    </a>

    <!-- Centre links (desktop only) -->
    <div class="hp-nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class="hp-nav-link">
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right actions -->
    <div class="hp-nav-actions">
      <button class="hp-theme-toggle" aria-label="Toggle theme" data-theme-toggle>
        <svg
          class="hp-theme-icon hp-theme-icon--light"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="hp-theme-icon hp-theme-icon--dark"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="#contact" class="hp-nav-cta">
        Book a consultation
      </a>

      <!-- Hamburger (mobile) -->
      <button class="hp-nav-burger" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="hp-nav-mobile" data-nav-mobile>
    <div class="hp-nav-mobile-inner">
      {navLinks.map((link) => (
        <a href={link.href} class="hp-nav-mobile-link">
          {link.label}
        </a>
      ))}
      <a href="#contact" class="hp-nav-mobile-cta">
        Book a consultation
      </a>
    </div>
  </div>
</nav>

<style>
  .hp-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 14px 0;
    background: rgba(9, 9, 9, 0.6);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: background var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .hp-nav.scrolled {
    background: rgba(9, 9, 9, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }

  .hp-nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .hp-nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #ffffff;
    transition: opacity var(--dur);
    flex-shrink: 0;
  }

  .hp-nav-logo:hover {
    opacity: 0.8;
  }

  .hp-nav-icon {
    width: 26px;
    height: 26px;
  }

  .hp-nav-wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 15.5px;
    letter-spacing: -0.02em;
    display: flex;
    gap: 2px;
  }

  .hp-logo-accent {
    color: #7be7ff;
  }

  .hp-logo-muted {
    color: rgba(255, 255, 255, 0.32);
    font-weight: var(--weight-regular);
  }

  .hp-nav-links {
    display: none;
    flex: 1;
    gap: 2px;
  }

  @media (min-width: 981px) {
    .hp-nav-links {
      display: flex;
    }
  }

  .hp-nav-link {
    padding: 8px 13px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 14px;
    font-weight: var(--weight-medium);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hp-nav-link:hover,
  .hp-nav-link[aria-current="page"] {
    color: #ffffff;
  }

  .hp-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .hp-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    border-radius: 10px;
    transition: background var(--dur);
  }

  .hp-theme-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .hp-theme-icon {
    width: 18px;
    height: 18px;
    position: absolute;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .hp-theme-icon--light {
    opacity: 1;
  }

  [data-theme="dark"] .hp-theme-icon--light {
    opacity: 0;
  }

  [data-theme="dark"] .hp-theme-icon--dark {
    opacity: 1;
  }

  .hp-nav-cta {
    display: none;
    padding: 10px 20px;
    background: #1e6aff;
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 13px;
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast);
  }

  @media (min-width: 981px) {
    .hp-nav-cta {
      display: block;
    }

    .hp-nav-cta:hover {
      background: #1857d6;
    }
  }

  .hp-nav-burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #ffffff;
    cursor: pointer;
    gap: 6px;
    transition: background var(--dur), border-color var(--dur);
  }

  @media (min-width: 981px) {
    .hp-nav-burger {
      display: none;
    }
  }

  .hp-nav-burger:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .hp-nav-burger span {
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--dur) var(--ease-out);
  }

  .hp-nav-burger[aria-expanded="true"] span:first-child {
    transform: translateY(8px) rotate(45deg);
  }

  .hp-nav-burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .hp-nav-burger[aria-expanded="true"] span:last-child {
    transform: translateY(-8px) rotate(-45deg);
  }

  .hp-nav-mobile {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(9, 9, 9, 0.98);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 12px 0 20px;
    z-index: 100;
  }

  .hp-nav-mobile[data-open] {
    display: block;
  }

  .hp-nav-mobile-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hp-nav-mobile-link {
    padding: 14px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 18px;
    transition: color var(--dur);
  }

  .hp-nav-mobile-link:last-of-type {
    border-bottom: none;
  }

  .hp-nav-mobile-cta {
    display: block;
    padding: 12px 0;
    margin-top: 8px;
    width: 100%;
    background: #1e6aff;
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 15px;
    border-radius: var(--radius-pill);
    text-align: center;
    transition: background var(--dur-fast);
  }

  .hp-nav-mobile-cta:active {
    background: #1857d6;
  }
</style>

<script>
  const burger = document.querySelector(".hp-nav-burger");
  const mobileNav = document.querySelector("[data-nav-mobile]");
  const nav = document.querySelector(".hp-nav");

  if (burger && mobileNav) {
    burger.addEventListener("click", () => {
      const isOpen = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", (!isOpen).toString());
      if (isOpen) {
        mobileNav.removeAttribute("data-open");
        document.body.style.overflow = "";
      } else {
        mobileNav.setAttribute("data-open", "");
        document.body.style.overflow = "hidden";
      }
    });

    // Close menu when link is clicked
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        burger.setAttribute("aria-expanded", "false");
        mobileNav.removeAttribute("data-open");
        document.body.style.overflow = "";
      });
    });
  }

  // Scroll listener for nav background
  if (nav) {
    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY > 40) {
          nav.classList.add("scrolled");
        } else {
          nav.classList.remove("scrolled");
        }
      },
      { passive: true }
    );
  }

  // Theme toggle
  const themeToggle = document.querySelector(".hp-theme-toggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const root = document.documentElement;
      const current = root.getAttribute("data-theme") || "light";
      const next = current === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      root.style.colorScheme = next;
      try {
        localStorage.setItem("lightspeed-theme", next);
      } catch (e) {
        // localStorage may be unavailable in private browsing or due to quota
      }
    });
  }
</script>
