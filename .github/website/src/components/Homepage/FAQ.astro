---
const faqs = [
  {
    question: "What does the AI project planner help with?",
    answer:
      "The planner helps you frame your brief in WordPress terms before committing to anything. It analyses your project description, identifies the likely solution route, highlights key planning considerations, and estimates a rough timeline. It is a starting point for clarity, not a replacement for a proper discovery conversation.",
  },
  {
    question: "Can I still speak to someone instead of using the planner?",
    answer:
      "Yes. The consultation booking link is always visible. The planner is an optional first step — useful if you are still shaping your brief or want a quick read on likely direction before speaking to us.",
  },
  {
    question: "How accurate is the website planning advice?",
    answer:
      "The planner gives directionally sound advice based on your description and our WordPress expertise. It is not a formal scoping document. Specific timelines, costs and technical approaches need a proper discovery session with one of our team before they become commitments.",
  },
  {
    question: "Can the planner help with WooCommerce, publishing, tourism or LMS projects?",
    answer:
      "Yes. The planner is trained on LightSpeed's four core solution paths: WordPress platforms, WooCommerce and subscriptions, publishing and content-heavy sites, and AI readiness. It also recognises sector-specific contexts like tourism, education and membership sites.",
  },
  {
    question: "What kind of organisations does LightSpeed work with?",
    answer:
      "We work with established organisations that need WordPress platforms built to last — typically marketing teams, publishers, eCommerce operators, education providers, tourism businesses and professional services firms. We are not a fit for simple brochure sites or budget-first builds.",
  },
  {
    question: "How do you approach migrations?",
    answer:
      "Carefully. We assess content volume, URL structure, redirect complexity, third-party integrations and SEO risk before committing to a migration approach. Most migrations include a structured content audit, a redirect map, a staging validation phase and a post-launch monitoring period.",
  },
  {
    question: "What happens after I book a consultation?",
    answer:
      "You will receive a short briefing form to complete before the call. The call itself is a structured 30-minute discovery conversation — no sales pitch, just useful questions about your platform, your team and your next priorities. From there we will either share a proposal or tell you if we are not the right fit.",
  },
];
---

<section class="hp-faq" id="faq" data-screen-label="05 FAQ">
  <div class="wrap hp-faq-wrap">
    <span class="hp-eyebrow">QUESTIONS</span>
    <h2 class="hp-h2">Common questions about LightSpeed and the planner</h2>

    <div class="hp-faq-list">
      {faqs.map((faq, idx) => (
        <div class="hp-faq-item" key={idx}>
          <button class="hp-faq-trigger" aria-expanded="false" aria-controls={`faq-panel-${idx}`}>
            <span>{faq.question}</span>
            <svg class="hp-faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="hp-faq-panel" id={`faq-panel-${idx}`} hidden>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hp-faq {
    padding: clamp(64px, 9vw, 96px) 0;
    background: var(--bg);
    transition: background var(--dur) var(--ease-out);
  }

  .hp-faq-wrap {
    max-width: var(--container-prose) !important;
  }

  .hp-faq .hp-eyebrow {
    color: var(--accent);
  }

  .hp-faq .hp-h2 {
    color: var(--fg-1);
    margin-bottom: 44px;
  }

  .hp-faq-list {
    display: flex;
    flex-direction: column;
  }

  .hp-faq-item {
    border-bottom: 1px solid var(--border);
    transition: border-color var(--dur) var(--ease-out);
  }

  .hp-faq-trigger {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 20px 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 16.5px;
    color: var(--fg-1);
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hp-faq-trigger:hover {
    color: var(--accent);
  }

  .hp-faq-chevron {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 3px;
    transition: transform 220ms var(--ease-out);
  }

  .hp-faq-trigger[aria-expanded="true"] .hp-faq-chevron {
    transform: rotate(180deg);
  }

  .hp-faq-panel {
    overflow: hidden;
    animation: hpFadeUp 200ms var(--ease-out);
  }

  .hp-faq-panel[hidden] {
    display: none;
  }

  .hp-faq-panel p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg-2);
    margin: 0 0 20px;
    padding-bottom: 0;
  }

  .hp-faq-panel p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .hp-faq .hp-h2 {
      font-size: clamp(22px, 6vw, 28px);
    }

    .hp-faq-trigger {
      font-size: 15px;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll(".hp-faq-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const isExpanded = trigger.getAttribute("aria-expanded") === "true";
      const panel = trigger.nextElementSibling as HTMLElement | null;
      if (!panel) return;

      if (isExpanded) {
        trigger.setAttribute("aria-expanded", "false");
        panel.hidden = true;
      } else {
        // Close other items
        triggers.forEach((t) => {
          if (t !== trigger) {
            t.setAttribute("aria-expanded", "false");
            const p = t.nextElementSibling as HTMLElement | null;
            if (p) p.hidden = true;
          }
        });

        trigger.setAttribute("aria-expanded", "true");
        panel.hidden = false;
      }
    });
  });
</script>
