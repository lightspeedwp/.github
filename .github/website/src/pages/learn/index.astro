---
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../components/AwesomeGithub/AwesomeGithubButton.astro";
import Icon from "../../components/AwesomeGithub/Icon.astro";
import WapuuHero from "../../components/WapuuHero.astro";
import { LEARN_TRACKS, allLessons } from "../../lib/learn";

const base = import.meta.env.BASE_URL;
const totalLessons = allLessons().length;
---

<AwesomeGithubLayout
  title="Learning Centre — Awesome GitHub"
  description="Short, self-paced tracks built from the real governance docs."
>
  <section class="learn-hero">
    <div class="learn-container">
      <div class="learn-hero-inner">
        <div class="learn-hero-text">
          <div class="learn-eyebrow">Learning Centre</div>
          <h1 class="learn-h1">
            <span class="learn-h1-line">Learn the control plane,</span>
            <span class="learn-h1-line learn-h1-line--accent">at your own pace.</span>
          </h1>
          <p class="learn-lead">
            Short, self-paced tracks built from the real governance docs. Read straight through, or dip into the lesson you need. We keep your place as you go.
          </p>

          <div class="learn-progress">
            <div class="learn-progress-track" aria-hidden="true">
              <div class="learn-progress-fill" data-hero-progress-fill style="width: 0%"></div>
            </div>
            <div class="learn-progress-meta" data-hero-progress-text>0 of {totalLessons} lessons read</div>
          </div>
        </div>

        <WapuuHero page="learn" />
      </div>
    </div>
  </section>

  <section class="learn-section">
    <div class="learn-container">
      <div class="learn-tracks-grid">
        {LEARN_TRACKS.map((track, trackIndex) => {
          const trackId = track.id;

          return (
            <article class="learn-track-card" data-track-card={trackId}>
              <div class="learn-track-header">
                <div class="learn-track-icon" aria-hidden="true">
                  <Icon name={track.icon || "ph:book-open"} size={36} />
                </div>

                <div class="learn-track-copy">
                  <div class="learn-track-number">Track {trackIndex + 1}</div>
                  <h2 class="learn-track-title">{track.label}</h2>
                  <p class="learn-track-blurb">{track.blurb}</p>
                </div>
              </div>

              <div class="learn-track-progress">
                <div class="learn-track-progress-bar" aria-hidden="true">
                  <div class="learn-track-progress-fill" data-track-progress={trackId} style="width: 0%"></div>
                </div>
                <div class="learn-track-progress-meta">
                  <span class="learn-track-progress-count" data-track-count={trackId}>
                    0 / {track.lessons.length}
                  </span>
                </div>
              </div>

              <ol class="learn-lesson-list" aria-label={`Lessons in ${track.label}`}>
                {track.lessons.map((lesson, lessonIndex) => (
                  <li class="learn-lesson-item">
                    <span
                      class="learn-lesson-tick"
                      data-lesson-id={lesson.id}
                      aria-hidden="true"
                    ></span>

                    <a class="learn-lesson-link" href={`${base}learn/${track.id}/${lesson.slug}/`}>
                      <span class="learn-lesson-number">{String(lessonIndex + 1).padStart(2, "0")}</span>
                      <span class="learn-lesson-body">
                        <span class="learn-lesson-title">{lesson.title}</span>
                        <span class="learn-lesson-learn">{lesson.learn}</span>
                      </span>
                      <span class="learn-lesson-meta">{lesson.readTime}</span>
                    </a>
                  </li>
                ))}
              </ol>

              {track.lessons[0] && (
                <div class="learn-track-actions">
                  <AwesomeGithubButton
                    href={`${base}learn/${track.id}/${track.lessons[0].slug}/`}
                    variant="secondary"
                    size="sm"
                  >
                    Start track
                  </AwesomeGithubButton>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<script>
  import {
    READ_TICK,
    UNREAD_TICK,
    loadReadIds,
  } from "../../scripts/learn-progress";

  function updateProgress() {
    const readIds = loadReadIds();
    const allLessonEls = document.querySelectorAll("[data-lesson-id]");
    const allTrackCards = document.querySelectorAll("[data-track-card]");
    const total = allLessonEls.length;
    let completed = 0;

    allLessonEls.forEach((el) => {
      const lessonId = el.dataset.lessonId;
      const isRead = !!lessonId && readIds.has(lessonId);
      el.innerHTML = isRead ? READ_TICK : UNREAD_TICK;
      if (isRead) completed += 1;
    });

    const heroFill = document.querySelector("[data-hero-progress-fill]");
    const heroText = document.querySelector("[data-hero-progress-text]");

    if (heroFill) {
      heroFill.style.width = `${total ? Math.round((completed / total) * 100) : 0}%`;
    }

    if (heroText) {
      heroText.textContent = `${completed} of ${total} lessons read`;
    }

    allTrackCards.forEach((card) => {
      const trackId = card.dataset.trackCard;
      if (!trackId) return;

      const tickCount = card.querySelectorAll(`[data-lesson-id^="${trackId}/"]`).length;
      const readCount = Array.from(card.querySelectorAll("[data-lesson-id]")).filter((el) => {
        const lessonId = el.dataset.lessonId;
        return !!lessonId && readIds.has(lessonId);
      }).length;

      const fill = card.querySelector(`[data-track-progress="${trackId}"]`);
      const count = card.querySelector(`[data-track-count="${trackId}"]`);

      if (fill) {
        fill.style.width = `${tickCount ? Math.round((readCount / tickCount) * 100) : 0}%`;
      }

      if (count) {
        count.textContent = `${readCount} / ${tickCount}`;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    updateProgress();
    window.addEventListener("storage", updateProgress);
  });
</script>

<style>
  .learn-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .learn-hero {
    background: var(--bg);
    color: var(--fg-1);
    padding: var(--space-40) var(--gutter);
  }

  .learn-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .learn-hero-text {
    max-width: 700px;
  }

  .learn-eyebrow {
    display: inline-flex;
    padding: var(--space-2) var(--space-4);
    background: var(--accent-soft);
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    font-size: var(--fs-eyebrow);
    color: var(--accent);
    margin-bottom: var(--space-6);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .learn-h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--fs-h1);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-heading);
  }

  .learn-h1-line {
    display: block;
    color: var(--fg-1);
  }

  .learn-h1-line--accent {
    color: var(--accent);
  }

  .learn-lead {
    max-width: 64ch;
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--c-slate-300);
  }

  .learn-progress {
    margin-top: var(--space-8);
    max-width: 480px;
  }

  .learn-progress-track {
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--panel-2);
    border: 1px solid var(--hair);
  }

  .learn-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width var(--dur) var(--ease-out);
  }

  .learn-progress-meta {
    margin-top: var(--space-3);
    font-size: var(--fs-body-sm);
    color: var(--c-slate-300);
  }

  .learn-section {
    padding: var(--space-24) var(--gutter);
    background: var(--bg);
  }

  .learn-tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: var(--space-8);
  }

  .learn-track-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: box-shadow var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .learn-track-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .learn-track-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .learn-track-icon {
    flex: none;
    color: var(--accent);
  }

  .learn-track-copy {
    min-width: 0;
    flex: 1;
  }

  .learn-track-number {
    margin-bottom: var(--space-2);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .learn-track-title {
    margin: 0;
    font-size: var(--fs-h4);
    line-height: var(--lh-heading);
    color: var(--fg-1);
  }

  .learn-track-blurb {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--fg-2);
  }

  .learn-track-progress {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .learn-track-progress-bar {
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--panel-2);
    border: 1px solid var(--hair);
  }

  .learn-track-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width var(--dur) var(--ease-out);
  }

  .learn-track-progress-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
  }

  .learn-lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .learn-lesson-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .learn-lesson-tick {
    display: inline-flex;
    margin-top: 11px;
    color: var(--fg-3);
  }

  .learn-lesson-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    background: var(--bg-alt);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .learn-lesson-link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .learn-lesson-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-semibold);
  }

  .learn-lesson-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .learn-lesson-title {
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    color: var(--fg-1);
  }

  .learn-lesson-learn {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-loose);
    color: var(--fg-2);
  }

  .learn-lesson-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
    white-space: nowrap;
  }

  .learn-track-actions {
    display: flex;
    justify-content: flex-start;
    padding-top: var(--space-2);
  }

  @media (max-width: 860px) {
    .learn-hero-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .learn-tracks-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
