---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getWceuSlides, wceuAccessibilityGuidance } from "../../../lib/wceuSlides";

const slides = getWceuSlides();
---

<BaseLayout
  title="WCEU 2026 slides - Awesome GitHub"
  description="Browse every WCEU 2026 slide page, with references and accessibility guidance."
>
  <section class="hero">
    <div class="eyebrow">WCEU 2026 slides</div>
    <h1>Browse the full slide set</h1>
    <p class="lede">
      Every slide has its own page, linked back to the main talk page and the public
      source files in <code>wceu-2026/slides/</code>.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="/wceu-2026/">Back to the talk page</a>
      <a
        class="button secondary"
        href="https://github.com/lightspeedwp/.github/tree/develop/wceu-2026/slides"
        target="_blank"
        rel="noreferrer"
      >
        Open source markdown
      </a>
    </div>
  </section>

  <section class="section">
    <h2>All slides</h2>
    <div class="page-copy">
      <p>{slides.length} slide pages are live, one per talk slide.</p>
    </div>
    <div class="card-grid slide-grid">
      {slides.map((slide) => (
        <article class="card slide-card">
          <div class="eyebrow">Slide {slide.number.toString().padStart(2, "0")}</div>
          <h3>{slide.title.replace(/^Slide \d+ - /, "")}</h3>
          <p>{slide.description}</p>
          <a class="inline-link" href={slide.pageHref}>
            Open slide page
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Accessibility guidance</h2>
    <div class="page-copy">
      <ul>
        {wceuAccessibilityGuidance.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
