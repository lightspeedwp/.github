    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .detail-badge,
  .detail-type-pill,
  .detail-related-mark,
  .v.tb-install,
  .v.tb-workflow,
  .v.tb-guardrail,
  .v.tb-pack,
  .v.tb-script,
  .v.tb-schema,
  .v.tb-recipe,
  .v.tb-aiDefault {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    border-radius: var(--radius-pill);
  }

  .detail-badge,
  .detail-type-pill,
  .detail-related-mark {
    padding: var(--space-2) var(--space-4);
    border: 1px solid currentColor;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .detail-version,
  .detail-updated {
    color: var(--fg-3);
    font-size: var(--fs-body-sm);
  }

  .detail-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-6);
  }

  .detail-lead {
    max-width: 62ch;
    color: var(--fg-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    margin: 0 0 var(--space-4);
  }

  .detail-note {
    max-width: 70ch;
    color: var(--fg-3);
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    margin: 0;
  }

  .detail-hero-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--hair);
    border-radius: var(--radius-xl);
    background: var(--panel);
    box-shadow: var(--shadow-sm);
  }

  .detail-hero-kv {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .detail-hero-k {
    font-size: var(--fs-body-sm);
    color: var(--fg-3);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .detail-hero-v {
    color: var(--fg-1);
    font-size: var(--fs-body);
  }

  .detail-mono {
    font-family: var(--font-mono);
  }

  .detail-body {
    padding: var(--section-y) 0;
    background: var(--bg);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
