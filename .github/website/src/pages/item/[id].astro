---
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";
import {
  ITEMS,
  TYPES,
  getCategoryInfo,
  getItemsByCategory,
  installable,
  itemRouteId,
  urlsFor,
} from "../../lib/catalogue";

const base = import.meta.env.BASE_URL;
const { id } = Astro.params;

export async function getStaticPaths() {
  return ITEMS.map((item) => ({
    params: { id: itemRouteId(item) },
  }));
}

const routeParts = (id ?? "").split("--");
const routeCat = routeParts.shift() ?? "";
const routeSlug = routeParts.join("--");
const item = ITEMS.find((entry) => entry.cat === routeCat && entry.slug === routeSlug);

if (!item) {
  return Astro.redirect(`${base}404/`);
}

const category = getCategoryInfo(item.cat);
const typeInfo = TYPES[item.type];
const relatedItems = getItemsByCategory(item.cat)
  .filter((entry) => entry.id !== item.id)
  .slice(0, 3);

const urls = urlsFor(item, "main");
const sourceText = item.body ?? buildSyntheticSource(item, category?.label ?? item.cat);
const renderHtml = renderMarkdown(sourceText);
const canInstall = installable(item);
const downloadHref = item.tree ? urls.blob : urls.raw;

function buildSyntheticSource(
  currentItem: (typeof ITEMS)[number],
  categoryLabel: string,
): string {
  const metadata = [
    `- Type: ${currentItem.type}`,
    `- Category: ${categoryLabel}`,
    currentItem.tags.length ? `- Tags: ${currentItem.tags.join(", ")}` : null,
    currentItem.path ? `- File path: ${currentItem.path}` : null,
    currentItem.applyTo ? `- Applies to: ${currentItem.applyTo}` : null,
    currentItem.run ? `- Run: ${currentItem.run}` : null,
    currentItem.validates ? `- Validates: ${currentItem.validates}` : null,
    currentItem.duration ? `- Duration: ${currentItem.duration}` : null,
  ].filter((value): value is string => Boolean(value));

  return [
    `# ${currentItem.name}`,
    currentItem.description,
    "## Metadata",
    ...metadata,
  ].join("\n\n");
}

function escapeHtml(text: string): string {
  return text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function renderInline(text: string): string {
  const codeSpans: string[] = [];
  const linkSpans: string[] = [];

  let rendered = escapeHtml(text)
    .replace(/`([^`]+)`/g, (_, code: string) => {
      const placeholder = `\u0000CODE${codeSpans.length}\u0000`;
      codeSpans.push(`<code>${code}</code>`);
      return placeholder;
    })
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label: string, href: string) => {
      const placeholder = `\u0000LINK${linkSpans.length}\u0000`;
      linkSpans.push(`<a href="${href}">${label}</a>`);
      return placeholder;
    })
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>");

  rendered = rendered.replace(/\u0000LINK(\d+)\u0000/g, (_, index: string) => linkSpans[Number(index)] ?? "");
  rendered = rendered.replace(/\u0000CODE(\d+)\u0000/g, (_, index: string) => codeSpans[Number(index)] ?? "");

  return rendered;
}

function renderMarkdown(markdown: string): string {
  const withoutFrontmatter = markdown.replace(/^---\n[\s\S]*?\n---\n?/, "");
  const lines = withoutFrontmatter.replace(/\r\n/g, "\n").trim().split("\n");
  const blocks: string[] = [];
  let i = 0;

  while (i < lines.length) {
    const line = lines[i];

    if (!line.trim()) {
      i += 1;
      continue;
    }

    if (line.startsWith("```")) {
      const codeLines: string[] = [];
      i += 1;

      while (i < lines.length && !lines[i].startsWith("```")) {
        codeLines.push(lines[i]);
        i += 1;
      }

      if (i < lines.length && lines[i].startsWith("```")) {
        i += 1;
      }

      blocks.push(`<pre><code>${escapeHtml(codeLines.join("\n"))}</code></pre>`);
      continue;
    }

    const headingMatch = line.match(/^(#{1,3})\s+(.+)$/);
    if (headingMatch) {
      const level = headingMatch[1].length;
      blocks.push(`<h${level}>${renderInline(headingMatch[2])}</h${level}>`);
      i += 1;
      continue;
    }

    if (/^>\s?/.test(line)) {
      const quoteLines: string[] = [];
      while (i < lines.length && /^>\s?/.test(lines[i])) {
        quoteLines.push(lines[i].replace(/^>\s?/, ""));
        i += 1;
      }
      blocks.push(`<blockquote><p>${renderInline(quoteLines.join(" "))}</p></blockquote>`);
      continue;
    }

    if (/^[-*]\s+/.test(line)) {
      const listItems: string[] = [];
      while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
        listItems.push(`<li>${renderInline(lines[i].replace(/^[-*]\s+/, ""))}</li>`);
        i += 1;
      }
      blocks.push(`<ul>${listItems.join("")}</ul>`);
      continue;
    }

    if (/^\d+\.\s+/.test(line)) {
      const listItems: string[] = [];
      while (i < lines.length && /^\d+\.\s+/.test(lines[i])) {
        listItems.push(`<li>${renderInline(lines[i].replace(/^\d+\.\s+/, ""))}</li>`);
        i += 1;
      }
      blocks.push(`<ol>${listItems.join("")}</ol>`);
      continue;
    }

    const paragraphLines: string[] = [line];
    i += 1;

    while (i < lines.length && lines[i].trim() && !/^(#{1,3}\s+|>\s?|[-*]\s+|\d+\.\s+|```)/.test(lines[i])) {
      paragraphLines.push(lines[i]);
      i += 1;
    }

    blocks.push(`<p>${renderInline(paragraphLines.join(" "))}</p>`);
  }

  return blocks.join("");
}
---

<AwesomeGithubLayout
  title={`${item.name} — Awesome GitHub`}
  description={item.description}
>
  <section class="detail-hero">
    <div class="detail-wrap">
      <nav class="detail-crumb" aria-label="Breadcrumb">
        <a href={`${base}`}>Home</a>
        <span class="detail-crumb-sep" aria-hidden="true">/</span>
        <a href={`${base}c/${item.cat}/`}>{category?.label ?? item.cat}</a>
        <span class="detail-crumb-sep" aria-hidden="true">/</span>
        <span>{item.name}</span>
      </nav>

      <div class="detail-hero-grid">
        <div class="detail-hero-copy">
          <div class="detail-meta-row">
            <span class={`detail-badge tb-${item.type}`}>{typeInfo?.badge ?? item.type}</span>
            <span class="detail-version">{item.version}</span>
            <span class="detail-updated">{item.updated}</span>
          </div>
          <h1 class="detail-title">{item.name}</h1>
          <p class="detail-lead">{item.description}</p>
          {typeInfo && <p class="detail-note">{typeInfo.note}</p>}
        </div>

        <div class="detail-hero-side">
          <div class="detail-hero-kv">
            <span class="detail-hero-k">Category</span>
            <span class="detail-hero-v">{category?.label ?? item.cat}</span>
          </div>
          <div class="detail-hero-kv">
            <span class="detail-hero-k">Source path</span>
            <span class="detail-hero-v detail-mono">{item.path ?? item.id}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-body">
    <div class="detail-wrap detail-grid">
      <div class="detail-main">
        <div class="detail-file-card">
          <div class="detail-file-bar">
            <div class="detail-file-bar-left">
              <span class={`detail-type-pill tb-${item.type}`}>{item.type}</span>
              <span class="detail-file-path">{item.path ?? item.id}</span>
            </div>

            <div class="detail-seg-ctrl" role="group" aria-label="View mode">
              <button class="detail-seg-btn is-active" type="button" data-view-tab="render">
                Render
              </button>
              <button class="detail-seg-btn" type="button" data-view-tab="raw">
                Raw
              </button>
            </div>
          </div>

          <div class="detail-file-content" data-view-panel="render">
            <div class="detail-md" set:html={renderHtml} />
          </div>

          <div class="detail-file-content" data-view-panel="raw" hidden>
            <div class="run-pill">
              <pre><code>{sourceText}</code></pre>
            </div>
          </div>
        </div>

        {relatedItems.length > 0 && (
          <section class="detail-related">
            <h2 class="detail-section-title">More {category?.label ?? item.cat}</h2>
            <div class="detail-related-grid">
              {relatedItems.map((rel) => (
                <a href={`${base}item/${itemRouteId(rel)}/`} class="detail-related-card">
                  <span class={`detail-related-mark tb-${rel.type}`}>{TYPES[rel.type]?.badge ?? rel.type}</span>
                  <h3>{rel.name}</h3>
                  <p>{rel.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="detail-sidebar" aria-label="Install and metadata">
        <div class="install-card">
          <h2 class="install-head">Install</h2>

          <div class="install-actions">
            <button class="btn-primary" type="button" data-copy-raw={sourceText}>
              Copy raw file
            </button>

            {canInstall ? (
              <a class="btn-ghost" href={urls.vscode} data-vscode-link>
                Install in VS Code
              </a>
            ) : (
              <a class="btn-ghost" href={urls.blob} data-gh-link target="_blank" rel="noreferrer noopener">
                View on GitHub
              </a>
            )}

            <a class="btn-ghost" href={downloadHref} data-download-link target="_blank" rel="noreferrer noopener">
              {item.tree ? "Open folder" : "Download raw"}
            </a>

            <button class="btn-soft" type="button" data-branch-toggle>
              <span aria-hidden="true">⎇</span>
              <span data-branch-label>main</span>
            </button>
          </div>

          <div class="install-kv">
            <div class="kv">
              <span class="k">Type</span>
              <span class={`v tb-${item.type}`}>{item.type}</span>
            </div>
            <div class="kv">
              <span class="k">Category</span>
              <a class="v" href={`${base}c/${item.cat}/`}>{category?.label ?? item.cat}</a>
            </div>
            <div class="kv">
              <span class="k">Tags</span>
              <span class="v detail-tags-inline">{item.tags.length ? item.tags.join(", ") : "None"}</span>
            </div>
            <div class="kv">
              <span class="k">File</span>
              <span class="v detail-mono">{item.path ?? item.id}</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</AwesomeGithubLayout>

<script define:vars={{ itemRawUrl: urls.raw, itemBlobUrl: urls.blob, itemVscodeUrl: urls.vscode, itemTree: item.tree }}>
  (() => {
    const branchStorageKey = "github_branch";
    const toggle = document.querySelector<HTMLButtonElement>("[data-branch-toggle]");
    const branchLabel = document.querySelector<HTMLElement>("[data-branch-label]");
    const renderPanel = document.querySelector<HTMLElement>('[data-view-panel="render"]');
    const rawPanel = document.querySelector<HTMLElement>('[data-view-panel="raw"]');
    const renderBtn = document.querySelector<HTMLButtonElement>('[data-view-tab="render"]');
    const rawBtn = document.querySelector<HTMLButtonElement>('[data-view-tab="raw"]');
    const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-raw]");
    const vscodeLink = document.querySelector<HTMLAnchorElement>("[data-vscode-link]");
    const ghLink = document.querySelector<HTMLAnchorElement>("[data-gh-link]");
    const downloadLink = document.querySelector<HTMLAnchorElement>("[data-download-link]");

    const rawUrl = itemRawUrl;
    const blobUrl = itemBlobUrl;
    const vscodeUrl = itemVscodeUrl;

    const computeUrls = (branch: string) => {
      const raw = rawUrl.replace(/\/main\//, `/${branch}/`);
      const blob = blobUrl.replace(/\/main\//, `/${branch}/`);
    const vscode = vscodeUrl.replace(/url=([^&]+)/, () => `url=${encodeURIComponent(raw)}`);

      return { raw, blob, vscode };
    };

    const setTab = (tab: "render" | "raw") => {
      const isRaw = tab === "raw";
      renderPanel?.toggleAttribute("hidden", isRaw);
      rawPanel?.toggleAttribute("hidden", !isRaw);
      renderBtn?.classList.toggle("is-active", !isRaw);
      rawBtn?.classList.toggle("is-active", isRaw);
    };

    renderBtn?.addEventListener("click", () => setTab("render"));
    rawBtn?.addEventListener("click", () => setTab("raw"));

    const copyRaw = async () => {
      const text = copyBtn?.dataset.copyRaw ?? "";
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        if (copyBtn) {
          const previous = copyBtn.textContent;
          copyBtn.textContent = "Copied!";
          window.setTimeout(() => {
            if (copyBtn) copyBtn.textContent = previous;
          }, 1800);
        }
      } catch {
        if (copyBtn) copyBtn.textContent = "Copy failed";
      }
    };

    copyBtn?.addEventListener("click", copyRaw);

    let branch = "main";
    try {
      const saved = localStorage.getItem(branchStorageKey);
      branch = saved === "develop" ? "develop" : "main";
    } catch {
      branch = "main";
    }

    const applyBranch = (nextBranch: string) => {
      const urls = computeUrls(nextBranch);

      if (vscodeLink) vscodeLink.href = urls.vscode;
      if (ghLink) ghLink.href = urls.blob;
      if (downloadLink) downloadLink.href = itemTree ? urls.blob : urls.raw;
      if (branchLabel) branchLabel.textContent = nextBranch;
    };

    applyBranch(branch);

    toggle?.addEventListener("click", () => {
      branch = branch === "main" ? "develop" : "main";
      try {
        localStorage.setItem(branchStorageKey, branch);
      } catch {
        // Ignore storage failures in hardened browsing modes.
      }
      applyBranch(branch);
    });
  })();
</script>

<style>
