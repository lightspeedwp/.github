    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .detail-hero {
    padding: var(--space-8) 0 var(--space-12);
    border-bottom: 1px solid var(--hair);
    background: var(--bg);
  }

  .detail-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-body-sm);
    color: var(--fg-3);
    margin-bottom: var(--space-8);
  }

  .detail-crumb a {
    color: var(--fg-3);
    text-decoration: none;
  }

  .detail-crumb a:hover {
    color: var(--accent);
  }

  .detail-crumb-sep {
    color: var(--fg-3);
  }

  .detail-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-10);
    align-items: start;
  }

