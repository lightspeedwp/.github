---
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";
import WapuuHero from "../../components/WapuuHero.astro";
---

<AwesomeGithubLayout
  title="Tools — Awesome GitHub"
  description="Supporting utilities and helpers for the ecosystem."
>
  <section class="tools-hero">
    <div class="wrap">
      <div class="page-hero-inner tools-hero-inner">
        <div class="page-hero-text">
          <div class="eyebrow">Phase 2c Coming Soon</div>
          <h1 class="page-h1">Tools</h1>
          <p class="lede">
            Supporting utilities and helpers that make working with the LightSpeed ecosystem more productive.
          </p>
          <div class="tools-actions">
            <a class="tools-button" href="/">Return to home</a>
          </div>
        </div>
        <WapuuHero page="tools" class="tools-wapuu" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-copy">
      <p><strong>Phase 2c (coming soon):</strong> This section will feature utility tools and helpers for ecosystem integration.</p>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .tools-hero {
    background: var(--bg);
    color: var(--fg-1);
    padding: var(--space-40) 0;
  }

  .tools-actions {
    margin-top: var(--space-8);
  }

  .tools-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg-1);
    text-decoration: none;
    font-weight: var(--weight-semibold);
    transition: border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .tools-button:hover {
    border-color: var(--c-light-blue);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .tools-hero .eyebrow,
  .tools-hero .page-h1,
  .tools-hero .lede {
    color: inherit;
  }

  .tools-hero .eyebrow {
    display: inline-flex;
    padding: var(--space-2) var(--space-4);
    background: var(--accent-soft);
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    font-size: var(--fs-eyebrow);
    color: var(--accent);
    margin-bottom: var(--space-6);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .tools-hero .page-h1 {
    margin: 0 0 var(--space-6);
  }

  .tools-hero .lede {
    max-width: 60ch;
  }

  @media (max-width: 860px) {
    .tools-hero {
      padding: var(--space-20) 0;
    }
  }
</style>
