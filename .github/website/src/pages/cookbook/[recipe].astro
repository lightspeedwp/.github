---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import matter from "gray-matter";
import { marked, Renderer } from "marked";
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../components/AwesomeGithub/AwesomeGithubButton.astro";
import { adjacentRecipes, liveRecipes, recipeById } from "../../lib/cookbook-data";

const base = import.meta.env.BASE_URL;
const siteBase = base.endsWith("/") ? base : `${base}/`;
const { recipe: recipeId } = Astro.params;

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function stripTitle(markdown: string): string {
  return markdown.replace(/^\s*#\s+.+\n+/, "").trim();
}

function parseCookbookMarkdown(markdown: string): { body: string; toc: Array<{ depth: number; text: string; id: string }> } {
  const body = stripTitle(markdown);
  const headings: Array<{ depth: number; text: string; id: string }> = [];
  const headingCounts = new Map<string, number>();

  for (const token of marked.lexer(body) as any[]) {
    if (token.type !== "heading" || token.depth < 2 || token.depth > 3) continue;

    const rawText = String(token.text ?? "").trim();
    const baseId = slugify(rawText) || `section-${headings.length + 1}`;
    const nextCount = (headingCounts.get(baseId) ?? 0) + 1;
    headingCounts.set(baseId, nextCount);
    const id = nextCount > 1 ? `${baseId}-${nextCount}` : baseId;

    headings.push({ depth: token.depth, text: rawText, id });
  }

  const headingIds = headings.map((heading) => heading.id);
  let headingIndex = 0;
  const renderer = new Renderer();

  renderer.heading = function heading(this: Renderer, token: any) {
    const content = this.parser.parseInline(token.tokens as any);
    if (token.depth >= 2 && token.depth <= 3) {
      const id = headingIds[headingIndex++] ?? slugify(String(token.text ?? ""));
      return `<h${token.depth} id="${id}">${content}</h${token.depth}>\n`;
    }

    return `<h${token.depth}>${content}</h${token.depth}>\n`;
  };

  return {
    body: marked.parse(body, { renderer, mangle: false, headerIds: false }) as string,
    toc: headings,
  };
}

export async function getStaticPaths() {
  return liveRecipes().map((recipe) => ({
    params: { recipe: recipe.id },
  }));
}

const recipe = recipeById(recipeId!);
if (!recipe || recipe.comingSoon || !recipe.src) {
  return Astro.redirect(`${base}cookbook/`);
}

const sourcePath = resolve(process.cwd(), "..", recipe.src);
const raw = await readFile(sourcePath, "utf8");
const parsed = matter(raw);
const markdown = parsed.content.trim();
const { body, toc } = parseCookbookMarkdown(markdown);
const { prev, next } = adjacentRecipes(recipe.id);
const githubUrl = `https://github.com/lightspeedwp/.github/blob/develop/${recipe.src}`;
---

<AwesomeGithubLayout
  title={`${recipe.title} — Cookbook — Awesome GitHub`}
  description={recipe.blurb}
>
  <nav class="recipe-breadcrumb" aria-label="Breadcrumb">
    <div class="wrap">
      <a href={`${siteBase}`}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={`${siteBase}cookbook/`}>Cookbook</a>
      <span aria-hidden="true">/</span>
      <span>{recipe.title}</span>
    </div>
  </nav>

  <header class="recipe-hero section">
    <div class="wrap">
      <div class="recipe-hero-inner">
        <div class="recipe-hero-copy">
          <div class="recipe-kind-wrap">
            <span class={`recipe-kind rk-${recipe.kind}`}>{recipe.kind}</span>
            <span class="recipe-duration">{recipe.duration}</span>
          </div>
          <h1 class="page-h1 recipe-h1">{recipe.title}</h1>
          <p class="page-lead recipe-lead">{recipe.blurb}</p>
          <div class="recipe-actions">
            <AwesomeGithubButton href={githubUrl} variant="ghost" size="sm">
              View source
            </AwesomeGithubButton>
            <button class="btn-soft recipe-progress-btn" type="button" data-cookbook-toggle>
              Mark complete
            </button>
          </div>
          <p class="recipe-progress-note" data-cookbook-status>
            Progress is stored locally in your browser.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="article-layout">
        <article class="article-main">
          <div class="md recipe-markdown" set:html={body} />
        </article>

        {toc.length > 0 && (
          <aside class="article-toc" aria-label="Table of contents">
            <div class="article-toc-card">
              <span class="article-toc-kicker">On this page</span>
              <ul>
                {toc.map((entry) => (
                  <li class={`toc-depth-${entry.depth}`}>
                    <a href={`#${entry.id}`}>{entry.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>

      <footer class="article-foot">
        <div class="article-nav">
          <div class="article-nav-slot article-nav-slot--prev">
            {prev ? (
              <a class="article-nav-link article-nav-link--prev" href={`${siteBase}cookbook/${prev.id}/`}>
                <span class="article-nav-label">Previous</span>
                <span class="article-nav-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
          </div>

          <div class="article-nav-slot article-nav-slot--home">
            <a class="article-nav-home" href={`${siteBase}cookbook/`}>
              All recipes
            </a>
          </div>

          <div class="article-nav-slot article-nav-slot--next">
            {next ? (
              <a class="article-nav-link article-nav-link--next" href={`${siteBase}cookbook/${next.id}/`}>
                <span class="article-nav-label">Next</span>
                <span class="article-nav-title">{next.title}</span>
              </a>
            ) : (
              <span />
            )}
          </div>
        </div>
      </footer>
    </div>
  </section>
</AwesomeGithubLayout>

<script define:vars={{ recipeId }}>
  const storageKey = "ag-cookbook";
  const toggle = document.querySelector("[data-cookbook-toggle]");
  const status = document.querySelector("[data-cookbook-status]");

  if (toggle) {
    const readState = () => {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || "{}");
      } catch {
        return {};
      }
    };

    const writeState = (state) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(state));
      } catch {
        // localStorage unavailable.
      }
    };

    const sync = (done) => {
      toggle.setAttribute("aria-pressed", String(done));
      toggle.textContent = done ? "Completed" : "Mark complete";
      if (status) {
        status.textContent = done
          ? "Marked complete and saved locally."
          : "Progress is stored locally in your browser.";
      }
    };

    const current = readState();
    let done = Boolean(current[recipeId]);
    sync(done);

    toggle.addEventListener("click", () => {
      const state = readState();
      done = !done;

      if (done) {
        state[recipeId] = true;
      } else {
        delete state[recipeId];
      }

      writeState(state);
      sync(done);
    });
  }
</script>

<style>
  .recipe-breadcrumb {
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
    background: var(--bg);
    font-size: 13px;
  }

  .recipe-breadcrumb .wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .recipe-breadcrumb a {
    color: var(--fg-link);
  }

  .recipe-breadcrumb a:hover {
    color: var(--fg-link-hover);
    text-decoration: none;
  }

  .recipe-breadcrumb span:not([aria-hidden]) {
    color: var(--fg-2);
  }

  .recipe-hero {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 8%, var(--bg)) 0%,
      var(--panel-2) 100%
    );
    border-bottom: 1px solid var(--hair);
  }

  .recipe-hero-inner {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .recipe-hero-copy {
    max-width: 780px;
  }

  .recipe-kind-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .recipe-kind {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: none;
  }

  .rk-planning {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .rk-delivery {
    color: var(--c-brand-green-700);
    background: color-mix(in srgb, var(--c-brand-green-700) 14%, transparent);
    border-color: color-mix(in srgb, var(--c-brand-green-700) 24%, transparent);
  }

  .rk-plugin {
    color: var(--c-cta-violet-500);
    background: color-mix(in srgb, var(--c-cta-violet-500) 12%, transparent);
    border-color: color-mix(in srgb, var(--c-cta-violet-500) 22%, transparent);
  }

  .rk-workflow {
    color: var(--c-status-warning);
    background: color-mix(in srgb, var(--c-status-warning) 13%, transparent);
    border-color: color-mix(in srgb, var(--c-status-warning) 22%, transparent);
  }

  .recipe-duration {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-3);
  }

  .recipe-h1 {
    margin-top: 0;
  }

  .recipe-lead {
    max-width: 700px;
  }

  .recipe-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .recipe-progress-btn {
    min-width: 150px;
  }

  .recipe-progress-note {
    margin-top: 12px;
    color: var(--fg-3);
    font-size: 13px;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 32px;
    align-items: start;
  }

  .article-main {
    min-width: 0;
  }

  .recipe-markdown :global(h2),
  .recipe-markdown :global(h3) {
    scroll-margin-top: 110px;
  }

  .article-toc {
    position: sticky;
    top: 112px;
  }

  .article-toc-card {
    padding: 20px;
    background: var(--panel-2);
    border: 1px solid var(--hair);
    border-radius: var(--radius-xl);
  }

  .article-toc-kicker {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }

  .article-toc-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article-toc-card li {
    line-height: 1.4;
  }

  .article-toc-card li.toc-depth-3 {
    padding-left: 14px;
  }

  .article-toc-card a {
    color: var(--fg-2);
    font-size: 14px;
  }

  .article-toc-card a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .article-foot {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
  }

  .article-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }

  .article-nav-slot--prev {
    justify-self: start;
  }

  .article-nav-slot--home {
    justify-self: center;
  }

  .article-nav-slot--next {
    justify-self: end;
  }

  .article-nav-link,
  .article-nav-home {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
  }

  .article-nav-link:hover,
  .article-nav-home:hover {
    text-decoration: none;
  }

  .article-nav-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .article-nav-title {
    color: var(--fg-2);
    max-width: 24ch;
  }

  .article-nav-link:hover .article-nav-title,
  .article-nav-home:hover {
    color: var(--fg-1);
  }

  .article-nav-home {
    font-size: 14px;
    color: var(--fg-link);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-toc {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .recipe-hero-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .article-nav {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .article-nav-slot--home {
      justify-self: start;
    }

    .article-nav-slot--next {
      justify-self: start;
    }
  }
</style>
