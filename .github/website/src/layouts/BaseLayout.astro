---
import '../styles/site-tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Awesome GitHub — LightSpeed .github',
  description = 'Browse the agents, instructions, prompts, skills, and workflows that govern every LightSpeed repository.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-GB" data-theme="light">
<head>
  <!-- MANDATORY: theme guard MUST be first script, before any stylesheet -->
  <script is:inline>
  (function(){
    try {
      var t = localStorage.getItem('ag-theme');
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia && matchMedia('(prefers-color-scheme:dark)').matches
          ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    document.documentElement.style.colorScheme = t;
    } catch(e) {}
  })();
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Design system tokens -->
  <link rel="stylesheet" href={`${base}design-system/colors_and_type.css`} />
  <link rel="stylesheet" href={`${base}design-system/spacing_and_effects.css`} />
  <link rel="stylesheet" href={`${base}design-system/components.css`} />

  <!-- Favicon -->
  <link rel="icon" href={`${base}assets/LS-Agency-Site-Icon-Blue.svg`} type="image/svg+xml" />
</head>
<body>
  <slot />
</body>
</html>
