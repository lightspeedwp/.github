{
  "name": "@lightspeedwp/{agent-name}",
  "version": "1.0.0",
  "description": "{agent-description}",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "agent",
    "lightspeed",
    "{category}",
    "{tag1}",
    "{tag2}"
  ],
  "author": "LightSpeedWP <engineering@lightspeedwp.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/.github.git",
    "directory": "agents/{agent-id}"
  },
  "bugs": {
    "url": "https://github.com/lightspeedwp/.github/issues"
  },
  "homepage": "https://github.com/lightspeedwp/.github/tree/develop/agents/{agent-id}",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts,.js",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "prepublish": "npm run build && npm run test && npm run lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
