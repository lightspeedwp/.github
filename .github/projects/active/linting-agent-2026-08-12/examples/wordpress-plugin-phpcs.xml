<?xml version="1.0"?>
<ruleset name="WordPress Plugin">
  <description>PHPCS configuration for WordPress plugins with strict security enforcement</description>

  <!-- Base standards -->
  <rule ref="WordPress-Core" />
  <rule ref="WordPress-Docs" />

  <!-- File extension to check -->
  <arg name="extensions" value="php" />

  <!-- Exclude vendor, node_modules, tests, and dist -->
  <exclude-pattern>/vendor/</exclude-pattern>
  <exclude-pattern>/node_modules/</exclude-pattern>
  <exclude-pattern>/tests/</exclude-pattern>
  <exclude-pattern>/dist/</exclude-pattern>
  <exclude-pattern>/build/</exclude-pattern>

  <!-- Display colors in output (if available) -->
  <arg name="colors" />

  <!-- Show sniff codes in output -->
  <arg value="ps" />

  <!-- Enforce critical security rules -->
  <rule ref="WordPress.Security.EscapeOutput">
    <severity>5</severity>
  </rule>

  <rule ref="WordPress.DB.PreparedSQL">
    <severity>5</severity>
  </rule>

  <rule ref="WordPress.Security.NonceVerification">
    <severity>4</severity>
  </rule>

  <!-- Enforce naming conventions -->
  <rule ref="WordPress.NamingConventions.ValidVariableName">
    <severity>3</severity>
  </rule>

  <!-- Warn on problematic functions -->
  <rule ref="WordPress.PHP.DiscouragedFunctions">
    <severity>4</severity>
  </rule>

  <!-- Plugin-specific checks -->
  <rule ref="WordPress.WP.DeprecatedFunctions">
    <severity>3</severity>
  </rule>

  <!-- Allow global namespace in plugins -->
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="my_plugin" />
      </property>
    </properties>
  </rule>
</ruleset>
