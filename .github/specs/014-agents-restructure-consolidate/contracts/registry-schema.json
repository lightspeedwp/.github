{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent & Skill Registry Schema",
  "description": "JSON schema for auto-generated agent and skill registries",
  "type": "object",
  "required": ["agents", "skills"],
  "properties": {
    "agents": {
      "type": "array",
      "description": "Consolidated agent registry entries",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "folder_path", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique agent identifier, matches folder name"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable agent name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
            "description": "Semantic version (e.g., 1.0.0)"
          },
          "folder_path": {
            "type": "string",
            "pattern": "^agents/[a-z0-9-]+/?$",
            "description": "Relative path from repo root"
          },
          "status": {
            "type": "string",
            "enum": ["active", "deprecated", "in-restructure", "needs-remediation"],
            "description": "Current restructuring status"
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Skill IDs used by this agent"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agent IDs this depends on"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Consolidated skill registry entries",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "location", "category"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique skill identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable skill name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
            "description": "Semantic version"
          },
          "location": {
            "type": "string",
            "pattern": "^(root|[a-z0-9-]+)$",
            "description": "root or agent ID"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Categorical subfolder (validation, audit, reporting, registry, etc.)"
          },
          "type": {
            "type": "string",
            "enum": ["action", "query", "transform", "utility"],
            "description": "agentskills.io skill type"
          },
          "status": {
            "type": "string",
            "enum": ["active", "deprecated", "in-development"],
            "description": "Skill status"
          },
          "agentskills_compliant": {
            "type": "boolean",
            "description": "Passes agentskills.io validation"
          },
          "used_by": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agent IDs that use this skill"
          }
        }
      }
    }
  }
}
