{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent and Skill Registry Schema",
  "description": "Schema for the combined agent registry and generated consolidated or per-category skill registries.",
  "oneOf": [
    { "$ref": "#/$defs/combinedRegistry" },
    { "$ref": "#/$defs/consolidatedSkillsRegistry" },
    { "$ref": "#/$defs/categorySkillsRegistry" }
  ],
  "$defs": {
    "combinedRegistry": {
      "type": "object",
      "required": ["agents", "skills"],
      "properties": {
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/legacySkill" } }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "name", "version", "folder_path", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "folder_path": { "type": "string", "pattern": "^agents/[a-z0-9-]+/?$" },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "in-restructure", "needs-remediation"]
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } }
      }
    },
    "legacySkill": {
      "type": "object",
      "required": ["id", "name", "version", "location", "category"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "location": { "type": "string", "pattern": "^(root|[a-z0-9-]+)$" },
        "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "type": "string", "enum": ["action", "query", "transform", "utility"] },
        "status": { "type": "string", "enum": ["active", "deprecated", "in-development"] },
        "agentskills_compliant": { "type": "boolean" },
        "used_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consolidatedSkillsRegistry": {
      "type": "object",
      "required": ["timestamp", "version", "schema", "summary", "skills"],
      "properties": {
        "timestamp": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "schema": { "type": "string", "const": "https://agentskills.io/schema/v1" },
        "summary": { "$ref": "#/$defs/consolidatedSummary" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedSkill" }
        }
      }
    },
    "categorySkillsRegistry": {
      "type": "object",
      "required": ["timestamp", "version", "category", "summary", "skills"],
      "properties": {
        "timestamp": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/categorySummary" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedSkill" }
        }
      }
    },
    "generatedSkill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "path",
        "description",
        "type",
        "version",
        "agentskills_io_compliant"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "agentskills_io_compliant": { "$ref": "#/$defs/compliance" }
      }
    },
    "compliance": {
      "type": "object",
      "required": ["compliant", "checks"],
      "properties": {
        "compliant": { "type": "boolean" },
        "checks": {
          "type": "object",
          "required": ["hasName", "hasDescription", "hasInputs", "hasOutputs", "hasExamples"],
          "properties": {
            "hasName": { "type": "boolean" },
            "hasDescription": { "type": "boolean" },
            "hasInputs": { "type": "boolean" },
            "hasOutputs": { "type": "boolean" },
            "hasExamples": { "type": "boolean" }
          }
        }
      }
    },
    "consolidatedSummary": {
      "type": "object",
      "required": ["total", "byCategory", "compliant", "compliancePercentage"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "compliant": { "type": "integer", "minimum": 0 },
        "compliancePercentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "categorySummary": {
      "type": "object",
      "required": ["total", "compliant", "compliancePercentage"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "compliant": { "type": "integer", "minimum": 0 },
        "compliancePercentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
    }
  }
}
