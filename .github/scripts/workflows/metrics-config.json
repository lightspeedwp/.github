{
  "schedule": {
    "cron": "0 2 * * *",
    "timezone": "UTC",
    "description": "Daily metrics collection at 2 AM UTC"
  },
  "execution": {
    "parallelJobs": 1,
    "timeoutMinutes": 30,
    "maxRetries": 3,
    "retryDelaySeconds": 5
  },
  "repositories": [
    {
      "owner": "lightspeedwp",
      "repo": ".github",
      "context": "github-control-plane",
      "enabled": true
    }
  ],
  "storage": {
    "basePath": ".github/reports/metrics",
    "format": "json",
    "timestampFormat": "ISO8601",
    "retention": {
      "days": 365,
      "maxFiles": 366
    }
  },
  "notifications": {
    "onFailure": true,
    "onSuccess": false,
    "channels": [
      "github-issues"
    ]
  },
  "logging": {
    "level": "info",
    "verbose": false,
    "outputPath": ".github/reports/metrics/logs"
  }
}
