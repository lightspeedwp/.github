{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChecklistResult",
  "description": "Output of ChecklistEngine.run. Mirrors the ChecklistResult interface in src/lib/types.ts and the object constructed in src/lib/checklist-engine.ts.",
  "type": "object",
  "required": [
    "id",
    "overall_score",
    "dimension_scores",
    "dimension_status",
    "passed",
    "template",
    "audience",
    "findings",
    "completion_time_ms",
    "generated_at",
    "spec_reference"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique result identifier"
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100 aggregate score"
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "description": "Dimension name to score, 0-100"
    },
    "dimension_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "pass",
          "fail"
        ]
      },
      "description": "Dimension name to pass/fail status"
    },
    "passed": {
      "type": "boolean",
      "description": "True when every dimension passes"
    },
    "template": {
      "type": "string",
      "description": "Checklist template id used for this run"
    },
    "audience": {
      "type": "string",
      "description": "Intended audience of the template used"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Mirrors the Finding interface in src/lib/types.ts.",
        "required": [
          "item_id",
          "dimension",
          "status",
          "message"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "description": "Checklist item this finding relates to"
          },
          "dimension": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "Text quoted from the specification"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings_by_dimension": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "Mirrors the Finding interface in src/lib/types.ts.",
          "required": [
            "item_id",
            "dimension",
            "status",
            "message"
          ],
          "properties": {
            "item_id": {
              "type": "string",
              "description": "Checklist item this finding relates to"
            },
            "dimension": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail"
              ]
            },
            "message": {
              "type": "string"
            },
            "evidence": {
              "type": "string",
              "description": "Text quoted from the specification"
            },
            "suggestion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Findings grouped by dimension name"
    },
    "completion_time_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Run duration in milliseconds"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "spec_reference": {
      "$ref": "specification-reference.schema.json"
    }
  },
  "additionalProperties": false
}
