{
  "name": "@lightspeedwp/requirements-checklist",
  "version": "0.1.0",
  "description": "Requirements Quality Checklist Framework - unit tests for requirements writing",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src tests",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "requirements",
    "quality",
    "checklist",
    "specification",
    "validation"
  ],
  "author": "LightSpeed",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/.github.git",
    "directory": "packages/requirements-checklist"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "marked": "^11.1.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
