{
  "version": "1.0.0",
  "tools": [
    {
      "name": "proposal-create",
      "description": "Generate a complete professional proposal from client requirements, scope, timeline, and pricing information.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string",
            "description": "Name of the client organization"
          },
          "projectTitle": {
            "type": "string",
            "description": "Title of the project or deliverable"
          },
          "scope": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of in-scope deliverables"
          },
          "outOfScope": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of out-of-scope items"
          },
          "estimatedEffort": {
            "type": "integer",
            "description": "Estimated total hours needed"
          },
          "timeline": {
            "type": "string",
            "enum": ["2-weeks", "4-weeks", "8-weeks", "12-weeks", "16-weeks", "20-weeks"],
            "description": "Estimated project timeline"
          },
          "budget": {
            "type": "number",
            "description": "Client budget or estimated total cost"
          },
          "keyDeliverables": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Top 3-5 key deliverables to emphasize"
          },
          "format": {
            "type": "string",
            "enum": ["pdf", "markdown", "word"],
            "description": "Output format for the proposal"
          }
        },
        "required": ["clientName", "projectTitle", "scope", "estimatedEffort", "timeline", "budget"]
      }
    },
    {
      "name": "proposal-template",
      "description": "Load a proposal template from the library and customize it for the specific project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateName": {
            "type": "string",
            "enum": ["web-redesign", "e-commerce", "saas-integration", "mobile-app", "content-strategy", "performance-optimization"],
            "description": "Name of the template to use"
          },
          "clientName": {
            "type": "string",
            "description": "Client organization name"
          },
          "projectScope": {
            "type": "string",
            "description": "Brief description of the project scope"
          },
          "customizations": {
            "type": "object",
            "properties": {
              "timeline": {"type": "string"},
              "budget": {"type": "number"},
              "additionalServices": {"type": "array", "items": {"type": "string"}}
            },
            "description": "Customizations to apply to the template"
          }
        },
        "required": ["templateName", "clientName"]
      }
    },
    {
      "name": "quote-generator",
      "description": "Generate an itemized quote with line-item services, rates, hours, and totals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string",
            "description": "Client organization name"
          },
          "quoteTitle": {
            "type": "string",
            "description": "Title of the quote (e.g., 'Website Optimization Services')"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "service": {"type": "string"},
                "hours": {"type": "number"},
                "hourlyRate": {"type": "number"}
              }
            },
            "description": "Array of services with hours and rates"
          },
          "includeContingency": {
            "type": "boolean",
            "description": "Add 15% contingency buffer"
          },
          "paymentTerms": {
            "type": "string",
            "enum": ["upfront", "50-50", "milestone", "on-delivery"],
            "description": "Payment schedule"
          },
          "validityDays": {
            "type": "integer",
            "description": "Number of days quote is valid (default 30)"
          }
        },
        "required": ["clientName", "quoteTitle", "lineItems"]
      }
    },
    {
      "name": "scope-estimator",
      "description": "Estimate project effort, timeline, resource needs based on deliverables and complexity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deliverables": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of project deliverables"
          },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high", "very-high"],
            "description": "Overall project complexity"
          },
          "teamSize": {
            "type": "integer",
            "enum": [1, 2, 3, 4, 5],
            "description": "Estimated team size"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "External dependencies or blockers"
          },
          "constraints": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Timeline, budget, or other constraints"
          }
        },
        "required": ["deliverables", "complexity"]
      }
    },
    {
      "name": "timeline-planner",
      "description": "Create a detailed project timeline with phases, milestones, and dependencies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string",
            "description": "Project or proposal title"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Project start date"
          },
          "durationWeeks": {
            "type": "integer",
            "description": "Total project duration in weeks"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "durationWeeks": {"type": "integer"},
                "deliverables": {"type": "array", "items": {"type": "string"}}
              }
            },
            "description": "Project phases with duration and deliverables"
          },
          "includeBuffer": {
            "type": "boolean",
            "description": "Add 10% time buffer for unknowns"
          }
        },
        "required": ["projectName", "startDate", "durationWeeks"]
      }
    },
    {
      "name": "invoice-generator",
      "description": "Create a professional invoice from a proposal or quote, ready for client billing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "description": "Reference to original proposal or quote ID"
          },
          "clientName": {
            "type": "string",
            "description": "Client organization name"
          },
          "invoiceDate": {
            "type": "string",
            "format": "date",
            "description": "Invoice date"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Payment due date"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {"type": "string"},
                "quantity": {"type": "number"},
                "unitPrice": {"type": "number"}
              }
            },
            "description": "Billable items and amounts"
          },
          "paymentMethod": {
            "type": "string",
            "enum": ["wire", "ach", "check", "card"],
            "description": "Accepted payment methods"
          }
        },
        "required": ["clientName", "invoiceDate", "dueDate", "lineItems"]
      }
    },
    {
      "name": "proposal-tracker",
      "description": "Track proposal status, client engagement, and generate win/loss analytics.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "description": "Unique proposal identifier"
          },
          "clientName": {
            "type": "string",
            "description": "Client organization name"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "sent", "reviewed", "negotiating", "won", "lost"],
            "description": "Current proposal status"
          },
          "sentDate": {
            "type": "string",
            "format": "date",
            "description": "Date proposal was sent to client"
          },
          "followUpDate": {
            "type": "string",
            "format": "date",
            "description": "Next scheduled follow-up"
          },
          "notes": {
            "type": "string",
            "description": "Client feedback, objections, or comments"
          }
        },
        "required": ["proposalId", "clientName", "status"]
      }
    }
  ]
}