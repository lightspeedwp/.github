{
  "version": "1.0.0",
  "functions": [
    {
      "type": "function",
      "function": {
        "name": "figma_inspector",
        "description": "Inspect and analyze Figma design files, extracting component information, design metadata, and file structure",
        "parameters": {
          "type": "object",
          "properties": {
            "figma_url": {
              "type": "string",
              "description": "Direct URL to Figma file or component (e.g., https://figma.com/file/abc123/design-system)"
            },
            "analysis_type": {
              "type": "string",
              "enum": [
                "component-inventory",
                "token-extraction",
                "accessibility-audit",
                "responsive-check",
                "variant-mapping",
                "full-analysis"
              ],
              "description": "Type of analysis to perform on the design file"
            },
            "include_metadata": {
              "type": "boolean",
              "description": "Include detailed metadata about components, layers, and properties",
              "default": true
            },
            "export_format": {
              "type": "string",
              "enum": ["json", "markdown", "yaml"],
              "description": "Format for exported data",
              "default": "json"
            }
          },
          "required": ["figma_url", "analysis_type"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "accessibility_auditor",
        "description": "Perform WCAG 2.2 accessibility compliance audit on design files, checking color contrast, semantic structure, and interactive elements",
        "parameters": {
          "type": "object",
          "properties": {
            "design_file_id": {
              "type": "string",
              "description": "Figma file ID or design file URL"
            },
            "wcag_level": {
              "type": "string",
              "enum": ["A", "AA", "AAA"],
              "description": "WCAG compliance level to check against",
              "default": "AA"
            },
            "check_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "color-contrast",
                  "semantic-structure",
                  "interactive-states",
                  "keyboard-navigation",
                  "focus-management",
                  "readable-text",
                  "motion-handling",
                  "all"
                ]
              },
              "description": "Specific accessibility checks to perform",
              "default": ["all"]
            },
            "report_format": {
              "type": "string",
              "enum": ["detailed", "summary", "checklist"],
              "description": "Format of the accessibility report",
              "default": "detailed"
            },
            "create_github_issues": {
              "type": "boolean",
              "description": "Automatically create GitHub issues for violations",
              "default": false
            }
          },
          "required": ["design_file_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "token_extractor",
        "description": "Extract design tokens from Figma design files, including colors, typography, spacing, and shadows, with validation and naming convention checking",
        "parameters": {
          "type": "object",
          "properties": {
            "figma_file_id": {
              "type": "string",
              "description": "Figma file ID containing design tokens"
            },
            "token_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "colors",
                  "typography",
                  "spacing",
                  "shadows",
                  "borders",
                  "effects",
                  "all"
                ]
              },
              "description": "Categories of tokens to extract",
              "default": ["all"]
            },
            "export_formats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["json", "css", "scss", "javascript", "tailwind"]
              },
              "description": "Export formats for tokens",
              "default": ["json"]
            },
            "validate_naming": {
              "type": "boolean",
              "description": "Validate tokens against naming conventions",
              "default": true
            },
            "naming_convention": {
              "type": "string",
              "enum": ["kebab-case", "camelCase", "snake_case", "PascalCase"],
              "description": "Enforce naming convention for tokens",
              "default": "kebab-case"
            }
          },
          "required": ["figma_file_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "component_analyzer",
        "description": "Analyze component structure, variants, states, and properties from design files, generating component inventory and usage maps",
        "parameters": {
          "type": "object",
          "properties": {
            "figma_file_id": {
              "type": "string",
              "description": "Figma file ID or URL"
            },
            "component_filter": {
              "type": "string",
              "description": "Filter to specific component names (supports wildcards)"
            },
            "analysis_depth": {
              "type": "string",
              "enum": ["shallow", "standard", "deep"],
              "description": "Depth of analysis",
              "default": "standard"
            },
            "include_usage": {
              "type": "boolean",
              "description": "Include component usage statistics",
              "default": true
            },
            "document_variants": {
              "type": "boolean",
              "description": "Document all component variants and states",
              "default": true
            }
          },
          "required": ["figma_file_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "design_documentation_generator",
        "description": "Generate comprehensive design documentation including component specifications, usage guidelines, code examples, and design decision records",
        "parameters": {
          "type": "object",
          "properties": {
            "component_id": {
              "type": "string",
              "description": "Component ID or name to document"
            },
            "documentation_type": {
              "type": "string",
              "enum": [
                "specification",
                "usage-guide",
                "code-examples",
                "decision-record",
                "complete"
              ],
              "description": "Type of documentation to generate",
              "default": "complete"
            },
            "include_sections": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Specific sections to include in documentation",
              "default": [
                "overview",
                "variants-and-states",
                "props-and-api",
                "usage-guidelines",
                "accessibility-notes",
                "code-examples"
              ]
            },
            "output_format": {
              "type": "string",
              "enum": ["markdown", "html", "json"],
              "description": "Documentation output format",
              "default": "markdown"
            },
            "code_examples_frameworks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["react", "vue", "angular", "web-components", "typescript"]
              },
              "description": "Frameworks to include code examples for",
              "default": ["react"]
            }
          },
          "required": ["component_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "contrast_checker",
        "description": "Verify color contrast ratios against WCAG standards, checking text, backgrounds, and interactive elements for accessibility compliance",
        "parameters": {
          "type": "object",
          "properties": {
            "foreground_color": {
              "type": "string",
              "description": "Foreground color in hex format (e.g., #000000)"
            },
            "background_color": {
              "type": "string",
              "description": "Background color in hex format (e.g., #FFFFFF)"
            },
            "element_type": {
              "type": "string",
              "enum": ["text", "icon", "interactive", "ui-component"],
              "description": "Type of element for context-specific requirements",
              "default": "text"
            },
            "wcag_level": {
              "type": "string",
              "enum": ["A", "AA", "AAA"],
              "description": "WCAG level to check against",
              "default": "AA"
            },
            "font_size": {
              "type": "number",
              "description": "Font size in pixels (for text-specific calculations)"
            },
            "font_weight": {
              "type": "string",
              "enum": ["normal", "bold"],
              "description": "Font weight (for WCAG calculations)",
              "default": "normal"
            }
          },
          "required": ["foreground_color", "background_color"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "responsive_validator",
        "description": "Test responsive design across breakpoints and device types, validating layout, typography, and component behavior at different screen sizes",
        "parameters": {
          "type": "object",
          "properties": {
            "figma_file_id": {
              "type": "string",
              "description": "Figma file or frame ID to validate"
            },
            "breakpoints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Breakpoints to test (e.g., 320, 768, 1024, 1440)",
              "default": ["320", "768", "1024", "1440"]
            },
            "device_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["mobile", "tablet", "desktop", "all"]
              },
              "description": "Device types to validate",
              "default": ["mobile", "tablet", "desktop"]
            },
            "check_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["layout", "typography", "spacing", "images", "all"]
              },
              "description": "Validation checks",
              "default": ["layout", "typography", "spacing"]
            },
            "report_format": {
              "type": "string",
              "enum": ["detailed", "summary"],
              "description": "Validation report format",
              "default": "detailed"
            }
          },
          "required": ["figma_file_id"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "code_connect_mapper",
        "description": "Create Code Connect maps linking Figma design components to code components, enabling seamless design-to-code workflows",
        "parameters": {
          "type": "object",
          "properties": {
            "figma_component_id": {
              "type": "string",
              "description": "Figma component ID to map"
            },
            "code_component_path": {
              "type": "string",
              "description": "Path to code component (e.g., src/components/Button.tsx)"
            },
            "framework": {
              "type": "string",
              "enum": ["react", "vue", "angular", "web-components", "figma-plugin", "custom"],
              "description": "Target framework or technology",
              "default": "react"
            },
            "mapping_type": {
              "type": "string",
              "enum": ["one-to-one", "one-to-many", "auto-detect"],
              "description": "Type of component mapping",
              "default": "auto-detect"
            },
            "include_props_mapping": {
              "type": "boolean",
              "description": "Include Figma properties to code props mapping",
              "default": true
            },
            "generate_examples": {
              "type": "boolean",
              "description": "Generate usage examples for the mapping",
              "default": true
            }
          },
          "required": ["figma_component_id", "code_component_path"]
        }
      }
    }
  ]
}
