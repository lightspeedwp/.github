{
  "version": "1.0.0",
  "tools": [
    {
      "id": "figma-inspector",
      "name": "figma-inspector",
      "description": "Inspect and analyze Figma design files, extracting component information, design metadata, and file structure",
      "input_schema": {
        "type": "object",
        "properties": {
          "figma_url": {
            "type": "string",
            "description": "Direct URL to Figma file or component (e.g., https://figma.com/file/abc123/design-system)"
          },
          "analysis_type": {
            "type": "string",
            "enum": [
              "component-inventory",
              "token-extraction",
              "accessibility-audit",
              "responsive-check",
              "variant-mapping",
              "full-analysis"
            ],
            "description": "Type of analysis to perform on the design file"
          },
          "include_metadata": {
            "type": "boolean",
            "description": "Include detailed metadata about components, layers, and properties",
            "default": true
          },
          "export_format": {
            "type": "string",
            "enum": ["json", "markdown", "yaml"],
            "description": "Format for exported data",
            "default": "json"
          }
        },
        "required": ["figma_url", "analysis_type"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "description": "Figma file identifier"
          },
          "components": {
            "type": "array",
            "description": "Array of component objects with variants and properties"
          },
          "tokens": {
            "type": "object",
            "description": "Design tokens organized by category (colors, typography, spacing)"
          },
          "accessibility_notes": {
            "type": "string",
            "description": "Accessibility observations from design file analysis"
          },
          "recommendations": {
            "type": "array",
            "description": "List of design improvement recommendations"
          }
        }
      }
    },
    {
      "id": "accessibility-auditor",
      "name": "accessibility-auditor",
      "description": "Perform WCAG 2.2 accessibility compliance audit on design files, checking color contrast, semantic structure, and interactive elements",
      "input_schema": {
        "type": "object",
        "properties": {
          "design_file_id": {
            "type": "string",
            "description": "Figma file ID or design file URL"
          },
          "wcag_level": {
            "type": "string",
            "enum": ["A", "AA", "AAA"],
            "description": "WCAG compliance level to check against",
            "default": "AA"
          },
          "check_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "color-contrast",
                "semantic-structure",
                "interactive-states",
                "keyboard-navigation",
                "focus-management",
                "readable-text",
                "motion-handling",
                "all"
              ]
            },
            "description": "Specific accessibility checks to perform",
            "default": ["all"]
          },
          "report_format": {
            "type": "string",
            "enum": ["detailed", "summary", "checklist"],
            "description": "Format of the accessibility report",
            "default": "detailed"
          }
        },
        "required": ["design_file_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "compliance_level": {
            "type": "string",
            "description": "Assessed WCAG compliance level"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Issue type (color-contrast, semantic, etc.)"
                },
                "severity": {
                  "type": "string",
                  "enum": ["critical", "high", "medium", "low"],
                  "description": "Issue severity level"
                },
                "element": {
                  "type": "string",
                  "description": "Component or element identifier"
                },
                "message": {
                  "type": "string",
                  "description": "Detailed issue description"
                },
                "remediation": {
                  "type": "string",
                  "description": "Recommended fix or improvement"
                }
              }
            },
            "description": "Array of accessibility issues found"
          },
          "summary": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "integer",
                "description": "Number of passed accessibility checks"
              },
              "failed": {
                "type": "integer",
                "description": "Number of failed accessibility checks"
              },
              "passed_percentage": {
                "type": "number",
                "description": "Percentage of passed checks"
              }
            },
            "description": "Summary statistics of accessibility audit"
          }
        }
      }
    },
    {
      "id": "token-extractor",
      "name": "token-extractor",
      "description": "Extract design tokens from Figma design files, including colors, typography, spacing, and shadows, with validation and naming convention checking",
      "input_schema": {
        "type": "object",
        "properties": {
          "figma_file_id": {
            "type": "string",
            "description": "Figma file ID containing design tokens"
          },
          "token_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "colors",
                "typography",
                "spacing",
                "shadows",
                "borders",
                "effects",
                "all"
              ]
            },
            "description": "Categories of tokens to extract",
            "default": ["all"]
          },
          "export_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["json", "css", "scss", "javascript", "tailwind"]
            },
            "description": "Export formats for tokens",
            "default": ["json"]
          },
          "validate_naming": {
            "type": "boolean",
            "description": "Validate tokens against naming conventions",
            "default": true
          }
        },
        "required": ["figma_file_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "tokens": {
            "type": "object",
            "description": "Extracted design tokens organized by category"
          },
          "token_count": {
            "type": "integer",
            "description": "Total number of tokens extracted"
          },
          "validation_results": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "integer",
                "description": "Number of valid tokens"
              },
              "invalid": {
                "type": "integer",
                "description": "Number of invalid tokens"
              },
              "issues": {
                "type": "array",
                "description": "Validation issues found"
              }
            },
            "description": "Token validation results"
          },
          "exports": {
            "type": "object",
            "description": "Exports in requested formats"
          }
        }
      }
    },
    {
      "id": "component-analyzer",
      "name": "component-analyzer",
      "description": "Analyze component structure, variants, states, and properties from design files, generating component inventory and usage maps",
      "input_schema": {
        "type": "object",
        "properties": {
          "figma_file_id": {
            "type": "string",
            "description": "Figma file ID or URL"
          },
          "component_filter": {
            "type": "string",
            "description": "Filter to specific component names (supports wildcards)"
          },
          "analysis_depth": {
            "type": "string",
            "enum": ["shallow", "standard", "deep"],
            "description": "Depth of analysis",
            "default": "standard"
          },
          "include_usage": {
            "type": "boolean",
            "description": "Include component usage statistics",
            "default": true
          }
        },
        "required": ["figma_file_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Component identifier"
                },
                "name": {
                  "type": "string",
                  "description": "Component name"
                },
                "variants": {
                  "type": "array",
                  "description": "List of component variants"
                },
                "states": {
                  "type": "array",
                  "description": "Available component states (default, hover, active, disabled)"
                },
                "props": {
                  "type": "array",
                  "description": "Component properties/parameters"
                },
                "documentation": {
                  "type": "string",
                  "description": "Component documentation or description"
                }
              }
            },
            "description": "Array of components with detailed information"
          },
          "component_count": {
            "type": "integer",
            "description": "Total number of components analyzed"
          },
          "usage_map": {
            "type": "object",
            "description": "Component usage statistics across design file"
          }
        }
      }
    },
    {
      "id": "design-documentation-generator",
      "name": "design-documentation-generator",
      "description": "Generate comprehensive design documentation including component specifications, usage guidelines, code examples, and design decision records",
      "input_schema": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "description": "Component ID or name to document"
          },
          "documentation_type": {
            "type": "string",
            "enum": [
              "specification",
              "usage-guide",
              "code-examples",
              "decision-record",
              "complete"
            ],
            "description": "Type of documentation to generate",
            "default": "complete"
          },
          "include_sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific sections to include in documentation",
            "default": [
              "overview",
              "variants-and-states",
              "props-and-api",
              "usage-guidelines",
              "accessibility-notes",
              "code-examples"
            ]
          },
          "output_format": {
            "type": "string",
            "enum": ["markdown", "html", "json"],
            "description": "Documentation output format",
            "default": "markdown"
          },
          "include_figma_url": {
            "type": "boolean",
            "description": "Include link to component in Figma",
            "default": true
          }
        },
        "required": ["component_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Documentation title"
          },
          "content": {
            "type": "string",
            "description": "Generated documentation content"
          },
          "sections": {
            "type": "array",
            "description": "Documentation sections included"
          },
          "metadata": {
            "type": "object",
            "description": "Documentation metadata (creation date, version, etc.)"
          },
          "figma_link": {
            "type": "string",
            "description": "Direct link to component in Figma"
          }
        }
      }
    },
    {
      "id": "contrast-checker",
      "name": "contrast-checker",
      "description": "Verify color contrast ratios against WCAG standards, checking text, backgrounds, and interactive elements for accessibility compliance",
      "input_schema": {
        "type": "object",
        "properties": {
          "foreground_color": {
            "type": "string",
            "description": "Foreground color in hex format (e.g., #000000)"
          },
          "background_color": {
            "type": "string",
            "description": "Background color in hex format (e.g., #FFFFFF)"
          },
          "element_type": {
            "type": "string",
            "enum": ["text", "icon", "interactive"],
            "description": "Type of element for context-specific requirements",
            "default": "text"
          },
          "wcag_level": {
            "type": "string",
            "enum": ["A", "AA", "AAA"],
            "description": "WCAG level to check against",
            "default": "AA"
          },
          "design_file_id": {
            "type": "string",
            "description": "Optional Figma file ID to check colors in context"
          }
        },
        "required": ["foreground_color", "background_color"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "contrast_ratio": {
            "type": "number",
            "description": "Measured contrast ratio (e.g., 4.5:1)"
          },
          "wcag_a_passes": {
            "type": "boolean",
            "description": "Passes WCAG A (4.5:1 for normal text)"
          },
          "wcag_aa_passes": {
            "type": "boolean",
            "description": "Passes WCAG AA (4.5:1 for normal text, 3:1 for large text)"
          },
          "wcag_aaa_passes": {
            "type": "boolean",
            "description": "Passes WCAG AAA (7:1 for normal text)"
          },
          "recommendations": {
            "type": "array",
            "description": "Recommendations to improve contrast if failing"
          }
        }
      }
    },
    {
      "id": "responsive-validator",
      "name": "responsive-validator",
      "description": "Test responsive design across breakpoints and device types, validating layout, typography, and component behavior at different screen sizes",
      "input_schema": {
        "type": "object",
        "properties": {
          "figma_file_id": {
            "type": "string",
            "description": "Figma file or frame ID to validate"
          },
          "breakpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Breakpoints to test (e.g., mobile, tablet, desktop)",
            "default": ["320", "768", "1024", "1440"]
          },
          "device_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["mobile", "tablet", "desktop", "all"]
            },
            "description": "Device types to validate",
            "default": ["mobile", "tablet", "desktop"]
          },
          "check_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Validation checks (layout, typography, spacing, images)",
            "default": ["layout", "typography", "spacing"]
          }
        },
        "required": ["figma_file_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "breakpoints_tested": {
            "type": "array",
            "description": "Breakpoints that were tested"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "breakpoint": {
                  "type": "string",
                  "description": "Breakpoint where issue occurs"
                },
                "device_type": {
                  "type": "string",
                  "description": "Device type affected"
                },
                "issue_type": {
                  "type": "string",
                  "description": "Type of responsive issue"
                },
                "description": {
                  "type": "string",
                  "description": "Issue description"
                },
                "recommendation": {
                  "type": "string",
                  "description": "Fix recommendation"
                }
              }
            },
            "description": "Responsive design issues found"
          },
          "summary": {
            "type": "object",
            "properties": {
              "compliant_breakpoints": {
                "type": "integer",
                "description": "Number of breakpoints passing validation"
              },
              "issues_found": {
                "type": "integer",
                "description": "Total issues found"
              },
              "compliance_score": {
                "type": "number",
                "description": "Responsive design compliance score (0-100)"
              }
            },
            "description": "Validation summary"
          }
        }
      }
    },
    {
      "id": "code-connect-mapper",
      "name": "code-connect-mapper",
      "description": "Create Code Connect maps linking Figma design components to code components, enabling seamless design-to-code workflows",
      "input_schema": {
        "type": "object",
        "properties": {
          "figma_component_id": {
            "type": "string",
            "description": "Figma component ID to map"
          },
          "code_component_path": {
            "type": "string",
            "description": "Path to code component (e.g., src/components/Button.tsx)"
          },
          "framework": {
            "type": "string",
            "enum": ["react", "vue", "angular", "web-components", "figma-plugin"],
            "description": "Target framework or technology"
          },
          "mapping_type": {
            "type": "string",
            "enum": ["one-to-one", "one-to-many", "auto-detect"],
            "description": "Type of component mapping",
            "default": "auto-detect"
          },
          "include_props_mapping": {
            "type": "boolean",
            "description": "Include Figma properties to code props mapping",
            "default": true
          }
        },
        "required": [
          "figma_component_id",
          "code_component_path"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "mapping": {
            "type": "object",
            "description": "Code Connect mapping configuration"
          },
          "code_connect_config": {
            "type": "string",
            "description": "Generated Code Connect configuration file content"
          },
          "props_mapping": {
            "type": "array",
            "description": "Mapping between Figma component properties and code component props"
          },
          "implementation_guide": {
            "type": "string",
            "description": "Guide for implementing the Code Connect mapping"
          }
        }
      }
    }
  ]
}
