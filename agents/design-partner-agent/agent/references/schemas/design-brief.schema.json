    },
    "recommended_structure": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirements_and_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
