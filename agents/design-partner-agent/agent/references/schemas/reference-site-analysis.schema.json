{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Site Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "urls_analyzed",
    "supporting_technical_evidence_consulted",
    "directly_verified_observations",
    "not_verified_or_visually_unconfirmed_details",
    "per_page_observations",
    "cross_site_patterns",
    "reusable_guidance",
    "risks_and_assumptions",
    "recommended_spec",
    "token_mode_used",
    "recommended_token_definitions_aligned_to_the_site_css",
    "open_questions"
  ],
  "properties": {
    "urls_analyzed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "supporting_technical_evidence_consulted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "directly_verified_observations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "not_verified_or_visually_unconfirmed_details": {
      "type": "array",
      "items": { "type": "string" }
    },
    "per_page_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "verified_observations", "likely_but_unconfirmed_interpretation", "assumptions"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "verified_observations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "likely_but_unconfirmed_interpretation": {
            "type": "array",
            "items": { "type": "string" }
          },
          "assumptions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "cross_site_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reusable_guidance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks_and_assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_structure",
        "content_and_messaging_guidance",
        "cta_and_conversion_guidance",
        "trust_and_credibility_guidance",
        "implementation_implications"
      ],
      "properties": {
        "recommended_structure": {
          "type": "array",
          "items": { "type": "string" }
        },
        "content_and_messaging_guidance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cta_and_conversion_guidance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trust_and_credibility_guidance": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implementation_implications": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "token_mode_used": {
      "type": "string",
      "enum": ["Extracted CSS tokens", "Recommended token roles"]
    },
    "recommended_token_definitions_aligned_to_the_site_css": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
