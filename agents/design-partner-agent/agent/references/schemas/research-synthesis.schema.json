{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Synthesis Output",
  "type": "object",
  "required": [
    "inputs_reviewed",
    "core_findings",
    "tensions",
    "design_implications",
    "opportunities"
  ],
  "properties": {
    "inputs_reviewed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "core_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tensions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "design_implications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "opportunities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accessibility_or_inclusion_implications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_next_steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
