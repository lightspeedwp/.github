{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Handoff Output",
  "type": "object",
  "required": [
    "scope",
    "behaviors",
    "states",
    "acceptance_criteria"
  ],
  "properties": {
    "scope": { "type": "string" },
    "behaviors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "edge_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
