{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Critique Output",
  "type": "object",
  "required": [
    "artifact",
    "goal",
    "top_issues",
    "recommendations"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "description": "The screen, flow, component, or artifact being reviewed."
    },
    "goal": {
      "type": "string",
      "description": "The business or user goal the critique is judging against."
    },
    "top_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "severity"],
        "properties": {
          "issue": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "evidence": { "type": "string" },
          "impact": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation"],
        "properties": {
          "recommendation": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "tradeoffs": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "accessibility_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
