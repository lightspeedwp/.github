{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema File Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filename",
    "title",
    "root_type",
    "has_properties"
  ],
  "properties": {
    "filename": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-schema\\.json$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "root_type": {
      "type": "string",
      "const": "object"
    },
    "has_required": {
      "type": "boolean"
    },
    "has_properties": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "string"
    }
  }
}