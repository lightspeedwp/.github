{
  "title": "Site Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment_reviewed",
    "woocommerce_verification",
    "current_site_signals",
    "material_limitations",
    "recommended_next_step"
  ],
  "properties": {
    "environment_reviewed": {"type": "string", "minLength": 1},
    "woocommerce_verification": {"type": "string", "minLength": 1},
    "current_site_signals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "material_limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_next_step": {"type": "string", "minLength": 1},
    "brand_name": {"type": "string"},
    "primary_offer": {"type": "string"},
    "ideal_traveler": {"type": "string"},
    "conversion_goal": {"type": "string"},
    "homepage_focus": {"type": "string"},
    "blog_archive_name": {"type": "string"},
    "post_types": {
      "type": "array",
      "items": {"type": "string"}
    },
    "taxonomies": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
