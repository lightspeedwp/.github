{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_purpose",
    "required_fields",
    "notification_routing",
    "confirmation_message",
    "compliance_and_anti_spam",
    "qa_checks"
  ],
  "properties": {
    "form_purpose": {"type": "string", "minLength": 1},
    "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "optional_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notification_routing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirmation_message": {"type": "string", "minLength": 1},
    "compliance_and_anti_spam": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "qa_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirmation_behaviour": {"type": "string"},
    "compliance_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
