[
  {
    "type": "function",
    "function": {
      "name": "create_store_analysis",
      "description": "Score WooCommerce store health across catalogue, payments, shipping, tax, performance, and security from a System Status export.",
      "parameters": {
        "type": "object",
        "properties": {
          "system_status": {
            "type": "string",
            "description": "WooCommerce System Status Report as text or JSON."
          },
          "plugins": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Active plugin slugs with versions."
          }
        },
        "required": ["system_status"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "generate_setup_plan",
      "description": "Produce an ordered setup-optimisation plan from a store analysis; each item includes impact, effort, and rollback.",
      "parameters": {
        "type": "object",
        "properties": {
          "analysis": {
            "type": "object",
            "description": "Output of create_store_analysis."
          },
          "business_model": {
            "type": "string",
            "enum": ["b2c", "b2b", "subscription", "digital", "mixed"]
          }
        },
        "required": ["analysis"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "configure_products",
      "description": "Recommend product types, global attributes, category structure, and inventory policy for a catalogue.",
      "parameters": {
        "type": "object",
        "properties": {
          "product_count": { "type": "integer" },
          "has_variations": { "type": "boolean" },
          "goals": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["product_count"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "setup_payments",
      "description": "Design a gateway matrix, webhook checklist, and PCI DSS scope statement.",
      "parameters": {
        "type": "object",
        "properties": {
          "regions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "flow": {
            "type": "string",
            "enum": ["hosted_fields", "redirect", "onsite_tokenised"]
          },
          "average_order_value": { "type": "number" }
        },
        "required": ["regions"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "analyze_performance",
      "description": "Turn a measured baseline into an ordered performance plan with target Core Web Vitals.",
      "parameters": {
        "type": "object",
        "properties": {
          "lcp_ms": { "type": "number" },
          "cls": { "type": "number" },
          "inp_ms": { "type": "number" },
          "object_cache": { "type": "boolean" },
          "page_cache": { "type": "boolean" }
        },
        "required": ["lcp_ms"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "manage_inventory",
      "description": "Define stock-management policy, thresholds, and backorder behaviour.",
      "parameters": {
        "type": "object",
        "properties": {
          "manage_stock": { "type": "boolean" },
          "low_stock_threshold": { "type": "integer" },
          "allow_backorders": {
            "type": "string",
            "enum": ["no", "notify", "yes"]
          }
        },
        "required": ["manage_stock"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "manage_customers",
      "description": "Configure customer accounts, roles, GDPR export/erase, and transactional email branding.",
      "parameters": {
        "type": "object",
        "properties": {
          "guest_checkout": { "type": "boolean" },
          "account_creation": {
            "type": "string",
            "enum": ["at_checkout", "my_account_only", "disabled"]
          },
          "gdpr": { "type": "boolean" }
        },
        "required": ["guest_checkout"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "configure_analytics",
      "description": "Define KPIs and the tracking source for each, with privacy/consent notes.",
      "parameters": {
        "type": "object",
        "properties": {
          "kpis": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tools": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["kpis"]
      }
    }
  }
]
