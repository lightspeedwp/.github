{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast taxonomy indexation decision",
  "type": "object",
  "required": [
    "surface_id",
    "surface_type",
    "site_type",
    "current_indexation",
    "current_sitemap_state",
    "recommendation",
    "risk_level",
    "approval_required",
    "owner",
    "qa_required",
    "evidence_state"
  ],
  "properties": {
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "surface_type": {
      "type": "string",
      "enum": [
        "category",
        "tag",
        "custom_taxonomy",
        "product_category",
        "product_tag",
        "product_attribute",
        "author_archive",
        "date_archive",
        "search_archive",
        "media_attachment",
        "filtered_url_group",
        "other"
      ]
    },
    "site_type": {
      "type": "string"
    },
    "current_indexation": {
      "type": "string",
      "enum": [
        "index",
        "noindex",
        "unknown",
        "mixed"
      ]
    },
    "current_sitemap_state": {
      "type": "string",
      "enum": [
        "included",
        "excluded",
        "unknown",
        "mixed"
      ]
    },
    "current_canonical_state": {
      "type": "string",
      "enum": [
        "self_referencing",
        "canonicalised_elsewhere",
        "missing",
        "conflicting",
        "unknown",
        "mixed"
      ]
    },
    "content_quality": {
      "type": "string",
      "enum": [
        "strong",
        "adequate",
        "thin",
        "duplicate",
        "unknown"
      ]
    },
    "business_value": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "search_value_evidence": {
      "type": "string",
      "enum": [
        "search_console",
        "keyword_research",
        "internal_priority",
        "none",
        "unknown"
      ]
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "index_and_optimise",
        "index_with_improvement_required",
        "noindex_after_approval",
        "consolidate_or_merge_first",
        "leave_pending_evidence",
        "developer_review_required"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "owner": {
      "type": "string",
      "enum": [
        "seo",
        "content",
        "admin",
        "developer",
        "client",
        "mixed"
      ]
    },
    "qa_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "research_target",
        "scanned_evidence",
        "verified_current_source",
        "stale_evidence",
        "contradicted_evidence",
        "inference",
        "unsupported",
        "user_provided_evidence"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}