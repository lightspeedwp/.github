{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment Plan",
  "type": "object",
  "required": [
    "workflow_type",
    "goal",
    "audience",
    "required_addons",
    "fields",
    "results_visibility",
    "privacy_stance",
    "risk_level",
    "approval_required",
    "test_plan"
  ],
  "properties": {
    "workflow_type": {
      "type": "string",
      "enum": [
        "survey",
        "poll",
        "quiz",
        "assessment",
        "feedback"
      ]
    },
    "goal": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "required_addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scoring_logic": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results_visibility": {
      "type": "string",
      "enum": [
        "internal_only",
        "after_submission",
        "public",
        "not_applicable",
        "unknown"
      ]
    },
    "privacy_stance": {
      "type": "string",
      "enum": [
        "anonymous",
        "pseudonymous",
        "identified",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "test_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
