{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdev.biz/schemas/gravity-forms/auditor-handoff.schema.json",
  "title": "WooCommerce Gravity Forms Auditor Handoff",
  "description": "Accepts canonical woocommerce-gravity-forms-auditor v0.2.1 configuration handoff packets and legacy normalised auditor handoffs.",
  "type": "object",
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "handoff_title",
        "source_audit",
        "findings_included",
        "target_form_page_addon",
        "proposed_remediation",
        "required_mcp_capabilities",
        "required_addons",
        "approval_requirements",
        "risk_level",
        "validation_steps",
        "rollback_notes",
        "suggested_configuration_prompt"
      ]
    },
    {
      "required": [
        "source_audit_title",
        "audit_date",
        "site_url",
        "environment",
        "finding_id",
        "finding_title",
        "affected_object",
        "evidence",
        "severity",
        "confidence",
        "user_impact",
        "business_impact",
        "recommended_remediation",
        "required_gravity_forms_capability",
        "required_mcp_capability",
        "required_addons",
        "approval_required",
        "suggested_validation_steps",
        "rollback_consideration",
        "client_safe_notes",
        "internal_notes",
        "open_questions"
      ]
    }
  ],
  "properties": {
    "handoff_title": {
      "type": "string",
      "minLength": 1
    },
    "source_audit": {
      "type": "string",
      "minLength": 1
    },
    "findings_included": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_form_page_addon": {
      "type": "string",
      "minLength": 1
    },
    "proposed_remediation": {
      "type": "string",
      "minLength": 1
    },
    "required_mcp_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Blocker",
        "High",
        "Medium",
        "Low",
        "Info",
        "blocker",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "validation_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggested_configuration_prompt": {
      "type": "string",
      "minLength": 1
    },
    "excluded_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_redaction_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_audit_title": {
      "type": "string",
      "minLength": 1
    },
    "audit_date": {
      "type": "string",
      "minLength": 1
    },
    "site_url": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "auditor_skill_version": {
      "type": "string"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_title": {
      "type": "string",
      "minLength": 1
    },
    "affected_object": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "Blocker",
        "High",
        "Medium",
        "Low",
        "Info",
        "blocker",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "high",
        "medium",
        "low"
      ]
    },
    "user_impact": {
      "type": "string",
      "minLength": 1
    },
    "business_impact": {
      "type": "string",
      "minLength": 1
    },
    "recommended_remediation": {
      "type": "string",
      "minLength": 1
    },
    "required_gravity_forms_capability": {
      "type": "string",
      "minLength": 1
    },
    "required_mcp_capability": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "suggested_validation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_consideration": {
      "type": "string"
    },
    "client_safe_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
