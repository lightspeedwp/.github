{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms MCP Capability Map",
  "type": "object",
  "required": ["site", "environment", "discovered_tools", "capabilities", "missing_capabilities", "safe_mode", "confidence"],
  "properties": {
    "site": {"type": "string"},
    "environment": {"type": "string", "enum": ["local", "development", "staging", "production", "unknown"]},
    "discovered_tools": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "properties": {
        "site_preflight": {"type": "boolean"},
        "plugin_status": {"type": "boolean"},
        "gravityforms_read": {"type": "boolean"},
        "gravityforms_write": {"type": "boolean"},
        "notifications_read_write": {"type": "boolean"},
        "confirmations_read_write": {"type": "boolean"},
        "feeds_read_write": {"type": "boolean"},
        "entry_read": {"type": "boolean"},
        "test_submission": {"type": "boolean"},
        "page_embed_write": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "missing_capabilities": {"type": "array", "items": {"type": "string"}},
    "safe_mode": {"type": "string", "enum": ["read-only audit", "draft configuration", "guided change", "high-trust publish", "manual fallback"]},
    "approval_required_for": {"type": "array", "items": {"type": "string"}},
    "manual_fallback_needed": {"type": "boolean"},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  },
  "additionalProperties": true
}
