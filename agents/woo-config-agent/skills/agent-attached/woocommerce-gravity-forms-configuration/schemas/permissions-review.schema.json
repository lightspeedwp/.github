{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms Permissions Review",
  "type": "object",
  "required": [
    "site_url",
    "environment",
    "subjects_reviewed",
    "capability_findings",
    "risk_summary",
    "approval_required",
    "confidence"
  ],
  "properties": {
    "site_url": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "development",
        "staging",
        "production",
        "unknown"
      ]
    },
    "subjects_reviewed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "capability_area",
          "risk_level",
          "recommendation"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "capability_area": {
            "type": "string"
          },
          "current_access": {
            "type": "string"
          },
          "forms_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_exposed": {
            "type": "string"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "risk_summary": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean"
    },
    "rollback_notes": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "additionalProperties": false
}
