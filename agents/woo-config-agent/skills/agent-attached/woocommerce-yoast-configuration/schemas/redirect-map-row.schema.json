{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/yoast-redirect-map-row.schema.json",
  "title": "Yoast Redirect Map Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "old_url",
    "proposed_action",
    "implementation_route",
    "approval_state",
    "risk_level",
    "qa_status",
    "owner"
  ],
  "properties": {
    "old_url": {
      "type": "string",
      "minLength": 1
    },
    "destination_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_type": {
      "type": "string"
    },
    "proposed_action": {
      "type": "string",
      "enum": [
        "301",
        "302",
        "410",
        "404",
        "noindex",
        "canonical",
        "hold",
        "monitor"
      ]
    },
    "implementation_route": {
      "type": "string",
      "enum": [
        "Yoast Premium",
        "server/CDN",
        "WordPress admin",
        "custom code",
        "content decision",
        "unknown"
      ]
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "approved",
        "needs content owner",
        "needs developer/sysadmin",
        "needs Yoast entitlement check",
        "duplicate or superseded",
        "monitor only",
        "rejected",
        "hold"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "not tested",
        "sample passed",
        "sample failed",
        "blocked",
        "not applicable"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "evidence_source": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    }
  }
}
