{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdev.biz/schemas/yoast-remediation-item.schema.json",
  "title": "Yoast remediation item",
  "type": "object",
  "required": [
    "id",
    "title",
    "finding",
    "evidence_state",
    "access_level",
    "severity",
    "priority",
    "owner",
    "implementation_route",
    "recommended_action",
    "approval_required",
    "qa_check",
    "decision_record_needed"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^YOAST-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 5},
    "finding": {"type": "string", "minLength": 5},
    "evidence_state": {
      "type": "string",
      "enum": ["research_target", "scanned_evidence", "verified_current_source", "stale_evidence", "contradicted_evidence", "inference", "unsupported", "user_provided_evidence"]
    },
    "access_level": {
      "type": "string",
      "enum": ["no_access", "screenshots", "settings_export", "wordpress_admin", "staging", "codebase", "rendered_source", "crawl_export", "search_console", "live_scan", "scanned_documentation"]
    },
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
    "priority": {"type": "string", "enum": ["p1", "p2", "p3", "p4", "defer", "verify_first"]},
    "owner": {"type": "string", "enum": ["seo_lead", "content_editor", "wordpress_admin", "developer", "client", "hosting", "unknown"]},
    "implementation_route": {"type": "string", "enum": ["admin_change", "content_change", "code_change", "server_change", "client_decision", "verify_first", "research_first"]},
    "recommended_action": {"type": "string", "minLength": 5},
    "approval_required": {"type": "string"},
    "qa_check": {"type": "string", "minLength": 5},
    "rollback_or_reversal": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "decision_record_needed": {"type": "boolean"},
    "sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
