{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multilingual page set",
  "type": "object",
  "required": [
    "set_id",
    "default_url",
    "language_urls",
    "evidence_state",
    "qa_status"
  ],
  "properties": {
    "set_id": {
      "type": "string"
    },
    "default_url": {
      "type": "string"
    },
    "language_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "locale",
          "url",
          "indexation_status"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "canonical": {
            "type": "string"
          },
          "indexation_status": {
            "enum": [
              "indexable",
              "noindex",
              "redirect",
              "not_found",
              "unknown"
            ]
          },
          "metadata_state": {
            "enum": [
              "not_checked",
              "default_language_carryover",
              "draft_translation",
              "approved",
              "implemented_pending_qa",
              "verified_live"
            ]
          }
        }
      }
    },
    "translation_layer": {
      "type": "string"
    },
    "hreflang_status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "not_checked",
        "unknown"
      ]
    },
    "sitemap_status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "not_checked",
        "unknown"
      ]
    },
    "schema_language_status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "not_checked",
        "unknown"
      ]
    },
    "evidence_state": {
      "enum": [
        "research target",
        "scanned evidence",
        "verified current source",
        "stale evidence",
        "contradicted evidence",
        "inference",
        "unsupported"
      ]
    },
    "qa_status": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "passed",
        "failed",
        "partial"
      ]
    },
    "recommended_next_action": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
