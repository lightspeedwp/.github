{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template example coverage schema",
  "type": "object",
  "required": ["template_required_sections", "example_required_sections", "coverage_rules"],
  "properties": {
    "template_required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "example_required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "coverage_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
