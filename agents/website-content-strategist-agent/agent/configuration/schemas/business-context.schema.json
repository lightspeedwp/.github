{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business context schema",
  "type": "object",
  "required": ["required_headings", "required_sections"],
  "properties": {
    "required_headings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4
    }
  },
  "additionalProperties": false
}
