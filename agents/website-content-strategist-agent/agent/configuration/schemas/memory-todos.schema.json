{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory todos schema",
  "type": "object",
  "required": ["required_headings", "stale_markers"],
  "properties": {
    "required_headings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "stale_markers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
