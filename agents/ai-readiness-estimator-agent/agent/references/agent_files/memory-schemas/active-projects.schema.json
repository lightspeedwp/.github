{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/active-projects.schema.json",
  "title": "active-projects",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/activeProject" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "blocked", "complete", "archived"]
    },
    "activeProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_key", "status", "last_updated"],
      "properties": {
        "project_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "current_workstream": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "latest_deliverable": { "type": "string", "minLength": 1 },
        "next_step": { "type": "string", "minLength": 1 },
        "waiting_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "last_updated": { "$ref": "#/$defs/date" }
      }
    }
  }
}
