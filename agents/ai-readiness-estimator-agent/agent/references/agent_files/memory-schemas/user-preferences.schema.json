{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/user-preferences.schema.json",
  "title": "user-preferences",
  "type": "object",
  "additionalProperties": false,
  "required": ["user"],
  "properties": {
    "user": { "$ref": "#/$defs/user" }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "audience": {
      "type": "string",
      "enum": ["internal", "client_ready"]
    },
    "languageVariant": {
      "type": "string",
      "enum": ["UK_English", "US_English"]
    },
    "tone": {
      "type": "string",
      "enum": ["practical_internal", "polished_client_ready", "concise", "consultative"]
    },
    "outputLength": {
      "type": "string",
      "enum": ["concise", "standard", "detailed"]
    },
    "estimateStructure": {
      "type": "string",
      "enum": ["standard_lightspeed", "shortform", "audit_first"]
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_internal_vs_client_ready_mode", "updated_at"],
      "properties": {
        "user_name": { "type": "string", "minLength": 1 },
        "preferred_language_variant": { "$ref": "#/$defs/languageVariant" },
        "default_tone": { "$ref": "#/$defs/tone" },
        "preferred_output_length": { "$ref": "#/$defs/outputLength" },
        "preferred_estimate_structure": { "$ref": "#/$defs/estimateStructure" },
        "default_internal_vs_client_ready_mode": { "$ref": "#/$defs/audience" },
        "updated_at": { "$ref": "#/$defs/date" }
      }
    }
  }
}
