{
  "version": "1.0.0",
  "provider": "claude",
  "tools": [
    {
      "name": "scope-analyzer",
      "description": "Analyze project scope and break down into features and components",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectDescription": {
            "type": "string",
            "description": "High-level project description"
          },
          "objectives": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Project objectives and goals"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "budget": {"type": "number"},
              "timeline": {"type": "string"},
              "team": {"type": "string"}
            },
            "description": "Project constraints"
          },
          "includeOutOfScope": {
            "type": "boolean",
            "description": "Explicitly define out-of-scope items"
          }
        },
        "required": ["projectDescription"]
      }
    },
    {
      "name": "effort-estimator",
      "description": "Estimate development effort for features and components",
      "inputSchema": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "description": {"type": "string"},
                "complexity": {"type": "string", "enum": ["low", "medium", "high", "very-high"]}
              }
            },
            "description": "List of features to estimate"
          },
          "methodology": {
            "type": "string",
            "enum": ["three-point", "planning-poker", "historical", "analogy"],
            "description": "Estimation methodology"
          },
          "teamExperience": {
            "type": "string",
            "enum": ["junior", "mid", "senior", "expert"],
            "description": "Team experience level"
          },
          "includeBuffers": {
            "type": "boolean",
            "description": "Include contingency buffers"
          }
        },
        "required": ["features"]
      }
    },
    {
      "name": "timeline-planner",
      "description": "Create realistic project timeline and schedule",
      "inputSchema": {
        "type": "object",
        "properties": {
          "totalEffort": {
            "type": "number",
            "description": "Total estimated hours"
          },
          "teamSize": {
            "type": "integer",
            "description": "Number of team members"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Project start date"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "features": {"type": "array", "items": {"type": "string"}}
              }
            },
            "description": "Project phases"
          },
          "bufferPercentage": {
            "type": "number",
            "description": "Buffer percentage for timeline"
          }
        },
        "required": ["totalEffort", "teamSize"]
      }
    },
    {
      "name": "resource-calculator",
      "description": "Calculate resource requirements and team composition",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectScope": {
            "type": "string",
            "enum": ["small", "medium", "large", "enterprise"],
            "description": "Project scope size"
          },
          "duration": {
            "type": "string",
            "description": "Project duration (e.g., '8 weeks')"
          },
          "specializations": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Required specializations"
          },
          "budget": {
            "type": "number",
            "description": "Available budget"
          }
        },
        "required": ["projectScope", "duration"]
      }
    },
    {
      "name": "budget-estimator",
      "description": "Calculate project budget and cost projections",
      "inputSchema": {
        "type": "object",
        "properties": {
          "totalHours": {
            "type": "number",
            "description": "Total estimated hours"
          },
          "rates": {
            "type": "object",
            "properties": {
              "developer": {"type": "number"},
              "qa": {"type": "number"},
              "pm": {"type": "number"},
              "designer": {"type": "number"}
            },
            "description": "Hourly rates by role"
          },
          "teamComposition": {
            "type": "object",
            "properties": {
              "developers": {"type": "number"},
              "qa": {"type": "number"},
              "pm": {"type": "number"},
              "designer": {"type": "number"}
            },
            "description": "Team composition"
          },
          "includeContingency": {
            "type": "boolean",
            "description": "Include contingency in budget"
          },
          "contingencyPercentage": {
            "type": "number",
            "description": "Contingency percentage"
          }
        },
        "required": ["totalHours"]
      }
    },
    {
      "name": "risk-assessor",
      "description": "Identify and assess project risks and create mitigation strategies",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectDescription": {
            "type": "string",
            "description": "Project description"
          },
          "teamExperience": {
            "type": "string",
            "enum": ["junior", "mid", "senior", "expert"],
            "description": "Team experience level"
          },
          "technicalComplexity": {
            "type": "string",
            "enum": ["low", "medium", "high", "very-high"],
            "description": "Technical complexity"
          },
          "scope": {
            "type": "string",
            "enum": ["small", "medium", "large"],
            "description": "Project scope"
          },
          "constraints": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Key constraints"
          }
        },
        "required": ["projectDescription"]
      }
    },
    {
      "name": "schedule-optimizer",
      "description": "Optimize project schedule and identify critical path",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "duration": {"type": "number"},
                "dependencies": {"type": "array", "items": {"type": "string"}}
              }
            },
            "description": "Project phases with dependencies"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "startDate": {"type": "string"},
              "targetEndDate": {"type": "string"},
              "milestones": {"type": "array", "items": {"type": "string"}}
            },
            "description": "Schedule constraints"
          }
        },
        "required": ["phases"]
      }
    },
    {
      "name": "comparison-analyzer",
      "description": "Compare multiple estimation scenarios",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "effort": {"type": "number"},
                "timeline": {"type": "string"},
                "cost": {"type": "number"}
              }
            },
            "description": "Scenarios to compare"
          },
          "criteria": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Comparison criteria"
          }
        },
        "required": ["scenarios"]
      }
    }
  ]
}
