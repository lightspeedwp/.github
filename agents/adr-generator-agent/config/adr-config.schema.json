{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADR Configuration Schema",
  "description": "Configuration schema for the ADR Generator agent. Supports org-level defaults and repo-level overrides.",
  "type": "object",
  "properties": {
    "adr": {
      "type": "object",
      "description": "ADR Generator configuration",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Directory where ADRs are stored (relative to repo root)",
          "default": "docs/adr",
          "examples": ["docs/adr", "architecture/decisions", "adr"]
        },
        "template": {
          "type": "string",
          "description": "Template variant to use when generating new ADRs",
          "enum": ["standard", "lightweight", "security", "infrastructure"],
          "default": "standard"
        },
        "number_format": {
          "type": "object",
          "description": "Configuration for ADR numbering",
          "properties": {
            "style": {
              "type": "string",
              "description": "Numbering style",
              "enum": ["sequential", "date-based", "custom"],
              "default": "sequential"
            },
            "zero_padded": {
              "type": "boolean",
              "description": "Whether to zero-pad sequential numbers (e.g., 0001 vs 1)",
              "default": true
            },
            "width": {
              "type": "integer",
              "description": "Width for zero-padded numbers",
              "minimum": 2,
              "maximum": 8,
              "default": 4
            },
            "date_format": {
              "type": "string",
              "description": "Date format for date-based numbering (ISO 8601 subset)",
              "enum": ["YYYYMMDD", "YYYY-MM-DD"],
              "default": "YYYYMMDD"
            },
            "custom_pattern": {
              "type": "string",
              "description": "Custom pattern for numbering (if style is 'custom')",
              "examples": ["{{year}}-{{month}}-{{count}}", "LWP-{{sequential}}"]
            }
          }
        },
        "approval_workflow": {
          "type": "object",
          "description": "Configuration for ADR approval workflows",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether approval workflow is enabled",
              "default": false
            },
            "method": {
              "type": "string",
              "description": "Approval method",
              "enum": ["none", "codeowners", "custom"],
              "default": "none"
            },
            "required_approvals": {
              "type": "integer",
              "description": "Number of approvals required before ADR is considered approved",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            },
            "custom_approvers": {
              "type": "array",
              "description": "List of GitHub usernames or teams that can approve ADRs",
              "items": {
                "type": "string"
              },
              "examples": [["@team/architects", "@user1"]]
            }
          }
        },
        "metadata": {
          "type": "object",
          "description": "Metadata fields required or optional for ADRs",
          "properties": {
            "required_fields": {
              "type": "array",
              "description": "List of required frontmatter fields",
              "items": {
                "type": "string"
              },
              "default": ["date", "status", "authors"]
            },
            "optional_fields": {
              "type": "array",
              "description": "List of optional frontmatter fields",
              "items": {
                "type": "string"
              },
              "default": ["supersedes", "superseded-by", "tags"]
            }
          }
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom fields for WordPress or other integrations",
          "properties": {
            "wordpress": {
              "type": "object",
              "description": "WordPress-specific configuration",
              "properties": {
                "impact_areas": {
                  "type": "array",
                  "description": "List of WordPress areas affected (e.g., 'blocks', 'plugins', 'theme')",
                  "items": {
                    "type": "string"
                  }
                },
                "performance_tier": {
                  "type": "string",
                  "description": "Performance impact level",
                  "enum": ["critical", "high", "medium", "low"],
                  "default": "medium"
                },
                "backwards_compatible": {
                  "type": "boolean",
                  "description": "Whether the decision maintains backwards compatibility",
                  "default": true
                }
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "description": "Validation rules for ADR content",
          "properties": {
            "enforce_unique_titles": {
              "type": "boolean",
              "description": "Reject ADRs with duplicate titles",
              "default": true
            },
            "enforce_valid_references": {
              "type": "boolean",
              "description": "Validate that all ADR references point to existing ADRs",
              "default": true
            },
            "enforce_status_transitions": {
              "type": "boolean",
              "description": "Validate that status transitions follow allowed workflow",
              "default": false
            },
            "minimum_content_length": {
              "type": "integer",
              "description": "Minimum number of characters required in ADR body",
              "minimum": 0,
              "default": 100
            }
          }
        }
      },
      "required": ["directory"]
    }
  },
  "required": ["adr"],
  "additionalProperties": false
}
