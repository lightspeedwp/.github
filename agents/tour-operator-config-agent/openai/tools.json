[
  {
    "type": "function",
    "function": {
      "name": "site_analyzer",
      "description": "Analyse current WordPress/WooCommerce configuration for tour operations. Identifies scaling gaps, payment bottlenecks, booking rule conflicts, and customer communication gaps.",
      "parameters": {
        "type": "object",
        "properties": {
          "site_url": {
            "type": "string",
            "description": "The tour operator website URL to analyse"
          },
          "active_plugins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active WordPress plugins"
          },
          "current_setup_description": {
            "type": "string",
            "description": "Text description of current setup: tour types, booking flow, payment methods, customer volume, known issues"
          },
          "pain_points": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of known issues or pain points"
          },
          "analysis_focus": {
            "type": "string",
            "enum": ["architecture", "performance", "booking-flow", "payments", "customer-comms", "all"],
            "description": "Which area(s) to focus the analysis on"
          }
        },
        "required": ["current_setup_description"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "architecture_recommender",
      "description": "Recommend optimal WordPress/WooCommerce architecture for tour operations. Suggests specific plugins, data structures, and integration patterns.",
      "parameters": {
        "type": "object",
        "properties": {
          "tour_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["single-destination", "multi-leg", "flexible-date", "private-charter"]
            },
            "description": "Types of tours offered"
          },
          "expected_monthly_bookings": {
            "type": "integer",
            "description": "Expected number of bookings per month"
          },
          "destinations_count": {
            "type": "integer",
            "description": "Number of different destinations or tour locations"
          },
          "payment_models": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["full-upfront", "deposit-balance", "instalments", "group-discounts"]
            },
            "description": "Payment models the operator needs to support"
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Currencies to support (e.g., USD, EUR, GBP)"
          },
          "technical_expertise_level": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced"],
            "description": "Team's technical expertise with WordPress"
          },
          "budget_constraints": {
            "type": "string",
            "description": "Budget for plugins, hosting, development"
          }
        },
        "required": ["tour_types", "expected_monthly_bookings"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "setup_validator",
      "description": "Validate tour operator WordPress/WooCommerce configuration against best practices. Checks booking calendars, payment rules, notification sequences, and customer communication.",
      "parameters": {
        "type": "object",
        "properties": {
          "configuration_description": {
            "type": "string",
            "description": "Description of the current configuration to validate"
          },
          "validation_areas": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["booking-calendars", "payment-rules", "availability-logic", "notifications", "customer-comms", "data-integrity", "all"]
            },
            "description": "Which areas to focus validation on"
          },
          "test_data": {
            "type": "object",
            "properties": {
              "test_tour": {
                "type": "string",
                "description": "Example tour being tested"
              },
              "test_date": {
                "type": "string",
                "description": "Test travel date (YYYY-MM-DD)"
              },
              "test_group_size": {
                "type": "integer",
                "description": "Test group size"
              }
            },
            "description": "Test case to validate against"
          },
          "check_type": {
            "type": "string",
            "enum": ["completeness", "best-practices", "safety", "performance", "all"],
            "description": "Type of validation to perform"
          }
        },
        "required": ["configuration_description"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "optimization_planner",
      "description": "Plan optimisations for tour operator websites. Identifies and prioritises performance, UX, and operational improvements.",
      "parameters": {
        "type": "object",
        "properties": {
          "current_performance_metrics": {
            "type": "object",
            "properties": {
              "page_load_time_seconds": {
                "type": "number"
              },
              "checkout_abandonment_rate": {
                "type": "number"
              },
              "monthly_bookings": {
                "type": "integer"
              },
              "customer_satisfaction_score": {
                "type": "number"
              }
            },
            "description": "Current performance metrics"
          },
          "improvement_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["faster-page-load", "higher-conversion", "better-availability-management", "improved-customer-communication", "reduced-operational-overhead"]
            },
            "description": "Goals for improvement"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Constraints (budget, timeline, operational)"
          },
          "timeline": {
            "type": "string",
            "description": "Desired timeline for improvements (immediate, 2-4 weeks, 1-3 months)"
          }
        },
        "required": ["improvement_goals"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "booking_system_configurator",
      "description": "Configure booking system for tour operations. Designs and validates booking calendars, availability rules, deposit/balance logic, and guide assignment.",
      "parameters": {
        "type": "object",
        "properties": {
          "tour_structure": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "itinerary": {
                "type": "string"
              },
              "duration_days": {
                "type": "integer"
              },
              "max_group_size": {
                "type": "integer"
              },
              "guides_required": {
                "type": "integer"
              }
            },
            "description": "Basic tour structure and constraints"
          },
          "availability_rules": {
            "type": "object",
            "properties": {
              "available_dates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blackout_dates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "min_days_advance_booking": {
                "type": "integer"
              },
              "max_days_advance_booking": {
                "type": "integer"
              }
            },
            "description": "Availability and booking window rules"
          },
          "payment_configuration": {
            "type": "object",
            "properties": {
              "base_price": {
                "type": "number"
              },
              "payment_model": {
                "type": "string",
                "enum": ["full-upfront", "deposit-balance", "instalments"]
              },
              "deposit_percentage": {
                "type": "number"
              },
              "balance_due_days_before": {
                "type": "integer"
              }
            },
            "description": "Pricing and payment configuration"
          },
          "group_size_pricing": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "min_size": {
                  "type": "integer"
                },
                "max_size": {
                  "type": "integer"
                },
                "price_per_person": {
                  "type": "number"
                },
                "discount_percentage": {
                  "type": "number"
                }
              }
            },
            "description": "Group-size-based pricing tiers"
          }
        },
        "required": ["tour_structure"]
      }
    }
  }
]
