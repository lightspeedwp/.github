{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms Plan",
  "type": "object",
  "required": [
    "form_name",
    "form_purpose",
    "required_fields",
    "notification_routing",
    "confirmation_behaviour",
    "privacy_requirements",
    "qa_checks"
  ],
  "properties": {
    "form_name": { "type": "string", "minLength": 1 },
    "form_purpose": { "type": "string", "minLength": 1 },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "optional_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notification_routing": { "type": "string", "minLength": 1 },
    "confirmation_behaviour": { "type": "string", "minLength": 1 },
    "spam_protection": {
      "type": "array",
      "items": { "type": "string" }
    },
    "privacy_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qa_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}