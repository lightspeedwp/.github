{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast SEO Audit",
  "type": "object",
  "required": [
    "audit_scope",
    "plugin_state",
    "confirmed_findings",
    "recommendations",
    "proposed_edits",
    "approved_edits",
    "completed_edits"
  ],
  "properties": {
    "audit_scope": { "type": "string", "minLength": 1 },
    "plugin_state": {
      "type": "object",
      "required": ["yoast_seo_active"],
      "properties": {
        "yoast_seo_active": { "type": "boolean" },
        "yoast_seo_premium_active": { "type": "boolean" },
        "license_state": { "type": "string" }
      },
      "additionalProperties": false
    },
    "confirmed_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "proposed_edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/edit" }
    },
    "approved_edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/edit" }
    },
    "completed_edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/edit" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["priority", "title", "detail"],
      "properties": {
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "title": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "required": ["field", "current_value", "proposed_value", "reason"],
      "properties": {
        "field": { "type": "string" },
        "current_value": { "type": ["string", "number", "boolean", "null"] },
        "proposed_value": { "type": ["string", "number", "boolean", "null"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}