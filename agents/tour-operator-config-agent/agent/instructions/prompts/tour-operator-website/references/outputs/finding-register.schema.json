{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.example/skills/tour-operator-website/finding-register.schema.json",
  "title": "Tour Operator Website Finding Register",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "scope": {
      "type": "string",
      "description": "Short description of the audit, review, handoff or implementation scope."
    },
    "site": {
      "type": "string",
      "description": "Target site or project name when known."
    },
    "environment": {
      "type": "string",
      "enum": ["live", "staging", "local", "repository", "uploaded-source", "unknown"]
    },
    "lastReviewed": {
      "type": "string",
      "description": "Review date in YYYY-MM-DD format when known."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "area", "status", "severity", "evidenceLabel", "recommendation"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable finding identifier, for example TO-AUD-001."
          },
          "title": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "core-content-model",
              "taxonomy",
              "relationship",
              "extension",
              "wetu-importer",
              "gravity-forms",
              "yoast-schema",
              "block-theme",
              "performance",
              "accessibility",
              "content",
              "launch-qa",
              "implementation",
              "memory",
              "unknown"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "partially-confirmed", "needs-verification", "not-applicable", "resolved"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "informational"]
          },
          "evidenceLabel": {
            "type": "string",
            "enum": [
              "confirmed-live-evidence",
              "confirmed-repository-evidence",
              "confirmed-uploaded-source-evidence",
              "confirmed-documentation-evidence",
              "confirmed-project-rule",
              "memory-only",
              "assumption",
              "unknown"
            ]
          },
          "sourceFiles": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          },
          "affectedContentTypes": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          },
          "risk": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "ownerHint": {
            "type": "string",
            "description": "Suggested internal owner or team, if useful."
          },
          "clientSafeSummary": {
            "type": "string",
            "description": "Optional wording safe for client-facing reports."
          },
          "internalNotes": {
            "type": "string",
            "description": "Internal notes that should not be copied directly into client reports."
          }
        }
      }
    }
  }
}
