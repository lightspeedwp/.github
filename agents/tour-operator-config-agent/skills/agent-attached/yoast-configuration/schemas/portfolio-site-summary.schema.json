{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast portfolio site summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_name",
    "site_url",
    "site_type",
    "yoast_product_mix",
    "evidence_available",
    "confidence",
    "portfolio_finding_type",
    "risk_level",
    "priority",
    "next_action"
  ],
  "properties": {
    "site_name": {
      "type": "string",
      "minLength": 1
    },
    "site_url": {
      "type": "string",
      "minLength": 1
    },
    "site_type": {
      "type": "string",
      "enum": [
        "business",
        "local",
        "publisher",
        "ecommerce_catalogue",
        "ecommerce_transactional",
        "multilingual",
        "migration",
        "mixed",
        "unknown"
      ]
    },
    "yoast_product_mix": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_available": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "portfolio_finding_type": {
      "type": "string",
      "enum": [
        "portfolio_pattern",
        "site_specific_defect",
        "accepted_exception",
        "evidence_gap",
        "needs_deep_audit"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "owner_route": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "decision_record_required": {
      "type": "boolean"
    },
    "qa_method": {
      "type": "string"
    }
  }
}
