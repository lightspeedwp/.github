{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGC Moderation Handoff",
  "type": "object",
  "required": [
    "summary",
    "collected_data",
    "post_submission_flow",
    "moderation_rules",
    "generated_post_settings",
    "known_limitations",
    "test_evidence",
    "next_action"
  ],
  "properties": {
    "summary": {
      "type": "object"
    },
    "collected_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "post_submission_flow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moderation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "owner",
          "required_before_publish"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "required_before_publish": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "generated_post_settings": {
      "type": "object"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  }
}
