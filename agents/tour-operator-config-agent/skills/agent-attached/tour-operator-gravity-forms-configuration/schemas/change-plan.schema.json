{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdev.biz/schemas/gravity-forms/change-plan.schema.json",
  "title": "Gravity Forms Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposed_changes",
    "target_forms",
    "target_pages",
    "required_mcp_actions",
    "read_only_checks",
    "write_operations",
    "rollback_notes",
    "risk_level",
    "user_approval_required",
    "validation_steps"
  ],
  "properties": {
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "target_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required_mcp_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_only_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "risk"
        ],
        "additionalProperties": true,
        "properties": {
          "operation": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    },
    "rollback_notes": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "user_approval_required": {
      "type": "boolean"
    },
    "validation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
