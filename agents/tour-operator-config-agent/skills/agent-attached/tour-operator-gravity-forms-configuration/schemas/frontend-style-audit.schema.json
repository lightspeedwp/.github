{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms Frontend Style Audit",
  "type": "object",
  "required": [
    "scope",
    "evidence",
    "findings",
    "riskLevel",
    "recommendedNextAction",
    "confidence"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "required": [
        "siteUrl",
        "environment",
        "formIds",
        "embedMethod"
      ],
      "properties": {
        "siteUrl": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "formIds": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "embedMethod": {
          "type": "string"
        },
        "pageUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gravityFormsVersion": {
          "type": "string"
        },
        "formTheme": {
          "type": "string"
        },
        "markupMode": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "globalThemeSetting": {
          "type": "string"
        },
        "blockStyleSettings": {
          "type": "object"
        },
        "shortcodeParameters": {
          "type": "object"
        },
        "formCssClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldCssClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readyClassesFound": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "finding",
          "risk",
          "recommendation"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "recommendation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "readyClassMigrationNeeded": {
      "type": "boolean"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "recommendedNextAction": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "additionalProperties": false
}
