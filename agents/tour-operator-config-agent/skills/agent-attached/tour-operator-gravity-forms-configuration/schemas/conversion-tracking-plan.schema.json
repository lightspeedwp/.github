{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdev.biz/schemas/gravity-forms/conversion-tracking-plan.schema.json",
  "title": "Gravity Forms Conversion Tracking Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_url",
    "environment",
    "forms",
    "tracking_goal",
    "existing_tracking",
    "event_plan",
    "attribution_fields",
    "privacy_notes",
    "qa_steps",
    "risks",
    "approval_required",
    "confidence"
  ],
  "properties": {
    "site_url": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "form_id",
          "form_name",
          "confirmation_type"
        ],
        "additionalProperties": true,
        "properties": {
          "form_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "form_name": {
            "type": "string"
          },
          "confirmation_type": {
            "type": "string"
          },
          "ajax": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "tracking_goal": {
      "type": "string"
    },
    "existing_tracking": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gravity_forms_google_analytics_addon": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "ga4": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "gtm": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "consent_platform": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_name",
          "trigger_condition",
          "parameters",
          "personal_data_excluded"
        ],
        "additionalProperties": true,
        "properties": {
          "event_name": {
            "type": "string"
          },
          "trigger_condition": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "personal_data_excluded": {
            "type": "boolean"
          }
        }
      }
    },
    "attribution_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "population_method",
          "required",
          "privacy_risk"
        ],
        "additionalProperties": true,
        "properties": {
          "field": {
            "type": "string"
          },
          "population_method": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "privacy_risk": {
            "type": "string"
          }
        }
      }
    },
    "privacy_notes": {
      "type": "string"
    },
    "qa_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}
