{
  "form_name": "Tour Enquiry Form",
  "purpose": "Collect structured safari/tour trip enquiries.",
  "audience": "Potential travellers",
  "source_template": null,
  "fields": [
    {
      "label": "Traveller name",
      "type": "name",
      "required": true
    },
    {
      "label": "Email",
      "type": "email",
      "required": true
    },
    {
      "label": "Phone/WhatsApp",
      "type": "phone",
      "required": false
    },
    {
      "label": "Destination interests",
      "type": "checkbox",
      "required": true,
      "choices": [
        "Botswana",
        "Kenya",
        "Namibia",
        "South Africa",
        "Tanzania",
        "Victoria Falls",
        "Other"
      ]
    },
    {
      "label": "Preferred travel dates",
      "type": "date",
      "required": false
    },
    {
      "label": "Flexible dates",
      "type": "checkbox",
      "required": false
    },
    {
      "label": "Group size",
      "type": "number",
      "required": true
    },
    {
      "label": "Accommodation preference",
      "type": "radio",
      "required": false,
      "choices": [
        "Comfort",
        "Luxury",
        "Ultra-luxury",
        "Not sure"
      ]
    },
    {
      "label": "Budget range",
      "type": "select",
      "required": false
    },
    {
      "label": "Special interests",
      "type": "checkbox",
      "required": false,
      "choices": [
        "Wildlife",
        "Photography",
        "Family travel",
        "Honeymoon",
        "Walking safari",
        "Beach extension"
      ]
    },
    {
      "label": "Additional notes",
      "type": "textarea",
      "required": false
    },
    {
      "label": "Consent",
      "type": "consent",
      "required": true
    }
  ],
  "field_settings": {
    "pagination": [
      "Your details",
      "Trip preferences",
      "Review and submit"
    ]
  },
  "conditional_logic": [
    {
      "if": "Destination interests includes Other",
      "show": "Other destination details"
    }
  ],
  "confirmations": [
    {
      "name": "Default",
      "type": "text",
      "message": "Thanks. A travel consultant will review your enquiry and respond with next steps."
    }
  ],
  "notifications": [
    {
      "name": "Consultant notification",
      "to": "travel-team@example.test",
      "from": "noreply@example.test",
      "reply_to": "{Email:2}",
      "message": "Include destination, dates, group size, budget, interests, and source URL."
    }
  ],
  "feeds": [
    {
      "name": "Partial Entries",
      "status": "optional-only-if-installed-and-approved"
    }
  ],
  "spam_settings": {
    "honeypot": true,
    "turnstile": "optional if available"
  },
  "accessibility_settings": {
    "visible_labels": true,
    "page_names": true,
    "progress_indicator": true
  },
  "embedding_target": {
    "page": "Plan Your Trip",
    "method": "gravity_forms_block"
  },
  "data_retention_notes": "Travel enquiry data can be sensitive; avoid documents unless secure handling is approved. Consent record and wording must be reviewed for retention, export, and erase handling.",
  "test_data": {
    "Traveller name": "Safari Tester",
    "Email": "safari@example.test",
    "Destination interests": [
      "Botswana"
    ],
    "Group size": 2,
    "Consent": true
  },
  "required_addons": [],
  "risks": [
    "Partial Entries and travel document uploads require privacy approval."
  ],
  "approval_status": "draft"
}
