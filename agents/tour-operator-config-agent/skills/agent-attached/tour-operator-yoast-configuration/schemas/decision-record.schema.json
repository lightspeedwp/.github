{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision record",
  "type": "object",
  "required": [
    "decision",
    "context",
    "risk_level",
    "approval_status",
    "qa_checks"
  ],
  "properties": {
    "decision": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "approval_status": {
      "type": "string"
    },
    "qa_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
