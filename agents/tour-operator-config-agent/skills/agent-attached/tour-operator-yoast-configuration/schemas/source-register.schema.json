{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source register row",
  "type": "object",
  "required": [
    "title",
    "source_owner",
    "area",
    "status",
    "confidence"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "source_owner": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}
