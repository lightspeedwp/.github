{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_summary",
    "scope",
    "preflight",
    "scorecard",
    "findings",
    "limitations"
  ],
  "properties": {
    "audit_summary": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preflight": {
      "type": "object"
    },
    "scorecard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "status",
          "confidence"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pass",
              "Minor issue",
              "Moderate issue",
              "Major issue",
              "Blocker",
              "Not assessed"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "audit-finding.schema.json"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quick_wins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medium_term_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_assessed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
