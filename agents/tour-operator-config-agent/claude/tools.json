[
  {
    "name": "site_analyzer",
    "description": "Analyse current WordPress/WooCommerce configuration for tour operations. Identifies scaling gaps, payment bottlenecks, booking rule conflicts, and customer communication gaps.",
    "input_schema": {
      "type": "object",
      "properties": {
        "site_url": {
          "type": "string",
          "description": "The tour operator website URL to analyse"
        },
        "active_plugins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of active WordPress plugins (e.g., WooCommerce, Gravity Forms, Yoast, booking plugins)"
        },
        "current_setup_description": {
          "type": "string",
          "description": "Text description of current setup: tour types, booking flow, payment methods, customer volume, known issues"
        },
        "pain_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of known issues or pain points"
        },
        "analysis_focus": {
          "enum": [
            "architecture",
            "performance",
            "booking-flow",
            "payments",
            "customer-comms",
            "all"
          ],
          "description": "Which area(s) to focus the analysis on"
        }
      },
      "required": ["current_setup_description"]
    }
  },
  {
    "name": "architecture_recommender",
    "description": "Recommend optimal WordPress/WooCommerce architecture for tour operations. Suggests specific plugins, data structures, and integration patterns.",
    "input_schema": {
      "type": "object",
      "properties": {
        "tour_types": {
          "type": "array",
          "items": {
            "enum": [
              "single-destination",
              "multi-leg",
              "flexible-date",
              "private-charter"
            ]
          },
          "description": "Types of tours offered"
        },
        "expected_monthly_bookings": {
          "type": "integer",
          "description": "Expected number of bookings per month"
        },
        "destinations_count": {
          "type": "integer",
          "description": "Number of different destinations or tour locations"
        },
        "payment_models": {
          "type": "array",
          "items": {
            "enum": [
              "full-upfront",
              "deposit-balance",
              "instalments",
              "group-discounts"
            ]
          },
          "description": "Payment models the operator needs to support"
        },
        "currencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Currencies to support (e.g., USD, EUR, GBP)"
        },
        "technical_expertise_level": {
          "enum": ["beginner", "intermediate", "advanced"],
          "description": "Team's technical expertise with WordPress"
        },
        "budget_constraints": {
          "type": "string",
          "description": "Budget for plugins, hosting, development (e.g., 'tight', 'moderate', 'generous')"
        }
      },
      "required": ["tour_types", "expected_monthly_bookings"]
    }
  },
  {
    "name": "setup_validator",
    "description": "Validate tour operator WordPress/WooCommerce configuration against best practices. Checks booking calendars, payment rules, notification sequences, and customer communication.",
    "input_schema": {
      "type": "object",
      "properties": {
        "configuration_description": {
          "type": "string",
          "description": "Description of the current configuration to validate"
        },
        "validation_areas": {
          "type": "array",
          "items": {
            "enum": [
              "booking-calendars",
              "payment-rules",
              "availability-logic",
              "notifications",
              "customer-comms",
              "data-integrity",
              "all"
            ]
          },
          "description": "Which areas to focus validation on"
        },
        "test_data": {
          "type": "object",
          "properties": {
            "test_tour": {
              "type": "string"
            },
            "test_date": {
              "type": "string"
            },
            "test_group_size": {
              "type": "integer"
            }
          },
          "description": "Test case to validate against"
        },
        "check_type": {
          "enum": [
            "completeness",
            "best-practices",
            "safety",
            "performance",
            "all"
          ],
          "description": "Type of validation to perform"
        }
      },
      "required": ["configuration_description"]
    }
  },
  {
    "name": "optimization_planner",
    "description": "Plan optimisations for tour operator websites. Identifies and prioritises performance, UX, and operational improvements.",
    "input_schema": {
      "type": "object",
      "properties": {
        "current_performance_metrics": {
          "type": "object",
          "properties": {
            "page_load_time_seconds": { "type": "number" },
            "checkout_abandonment_rate": { "type": "number" },
            "monthly_bookings": { "type": "integer" },
            "customer_satisfaction_score": { "type": "number" }
          },
          "description": "Current performance metrics"
        },
        "improvement_goals": {
          "type": "array",
          "items": {
            "enum": [
              "faster-page-load",
              "higher-conversion",
              "better-availability-management",
              "improved-customer-communication",
              "reduced-operational-overhead"
            ]
          },
          "description": "Goals for improvement"
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Constraints (e.g., 'limited budget', 'cannot interrupt booking flow', 'staging environment available')"
        },
        "timeline": {
          "type": "string",
          "description": "Desired timeline for improvements (e.g., 'immediate', '2-4 weeks', '1-3 months')"
        }
      },
      "required": ["improvement_goals"]
    }
  },
  {
    "name": "booking_system_configurator",
    "description": "Configure booking system for tour operations. Designs and validates booking calendars, availability rules, deposit/balance logic, and guide assignment.",
    "input_schema": {
      "type": "object",
      "properties": {
        "tour_structure": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "itinerary": { "type": "string" },
            "duration_days": { "type": "integer" },
            "max_group_size": { "type": "integer" },
            "guides_required": { "type": "integer" }
          },
          "description": "Basic tour structure and constraints"
        },
        "availability_rules": {
          "type": "object",
          "properties": {
            "available_dates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "blackout_dates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "min_days_advance_booking": { "type": "integer" },
            "max_days_advance_booking": { "type": "integer" }
          },
          "description": "Availability and booking window rules"
        },
        "payment_configuration": {
          "type": "object",
          "properties": {
            "base_price": { "type": "number" },
            "payment_model": {
              "enum": ["full-upfront", "deposit-balance", "instalments"]
            },
            "deposit_percentage": { "type": "number" },
            "balance_due_days_before": { "type": "integer" }
          },
          "description": "Pricing and payment configuration"
        },
        "group_size_pricing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "min_size": { "type": "integer" },
              "max_size": { "type": "integer" },
              "price_per_person": { "type": "number" },
              "discount_percentage": { "type": "number" }
            }
          },
          "description": "Group-size-based pricing tiers"
        }
      },
      "required": ["tour_structure"]
    }
  }
]
