{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/project-assumptions-and-open-questions.schema.json",
  "title": "project-assumptions-and-open-questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "itemType": {
      "type": "string",
      "enum": ["assumption", "open_question", "risk"]
    },
    "blockingLevel": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "owner": {
      "type": "string",
      "enum": ["user", "client", "internal_team", "external_partner", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": ["unresolved", "resolved", "stale", "archived"]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_key",
        "item_id",
        "type",
        "assumption_or_question",
        "blocking_level",
        "status",
        "last_updated"
      ],
      "properties": {
        "project_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "item_id": {
          "type": "string",
          "pattern": "^aq-\\d{3,}$"
        },
        "type": { "$ref": "#/$defs/itemType" },
        "assumption_or_question": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string", "minLength": 1 },
        "blocking_level": { "$ref": "#/$defs/blockingLevel" },
        "owner": { "$ref": "#/$defs/owner" },
        "status": { "$ref": "#/$defs/status" },
        "last_updated": { "$ref": "#/$defs/date" }
      }
    }
  }
}
