{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/lightspeed-project-defaults.schema.json",
  "title": "lightspeed-project-defaults",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectDefaults"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "projectType": {
      "type": "string",
      "enum": [
        "brochure_site",
        "ecommerce",
        "publisher",
        "membership",
        "lead_generation",
        "chatbot_project",
        "governance_project",
        "mixed"
      ]
    },
    "audience": {
      "type": "string",
      "enum": ["internal", "client_ready"]
    },
    "outputStyle": {
      "type": "string",
      "enum": ["proposal_ready", "brief", "audit", "checklist", "memo", "email_draft"]
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "projectDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_key",
        "client_name",
        "primary_domain",
        "project_type",
        "default_audience",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "project_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "client_name": { "type": "string", "minLength": 1 },
        "primary_domain": { "type": "string", "minLength": 1 },
        "staging_domain": { "type": "string", "minLength": 1 },
        "project_type": { "$ref": "#/$defs/projectType" },
        "default_audience": { "$ref": "#/$defs/audience" },
        "preferred_output_style": { "$ref": "#/$defs/outputStyle" },
        "known_service_focus": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recurring_stakeholders": {
          "type": "array",
          "items": { "$ref": "#/$defs/stakeholder" }
        },
        "created_at": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" }
      }
    }
  }
}
