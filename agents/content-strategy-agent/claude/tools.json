{
  "version": "1.0.0",
  "provider": "claude",
  "tools": [
    {
      "name": "content-strategist",
      "description": "Develops comprehensive content strategies aligned with business goals and audience needs",
      "category": "strategy",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_goals": {
            "type": "string",
            "description": "Primary business objectives and success metrics"
          },
          "target_audience": {
            "type": "string",
            "description": "Description of target audience, demographics, and personas"
          },
          "current_content": {
            "type": "string",
            "description": "Overview of existing content and content types"
          },
          "competitive_landscape": {
            "type": "string",
            "description": "Analysis of competitor content strategies"
          },
          "content_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "blog",
                "video",
                "infographic",
                "whitepaper",
                "case-study",
                "podcast",
                "webinar",
                "email",
                "social-media"
              ]
            },
            "description": "Preferred content types and formats"
          },
          "timeline": {
            "type": "string",
            "description": "Implementation timeline and milestones"
          },
          "resources": {
            "type": "string",
            "description": "Available resources, budget, and team capacity"
          }
        },
        "required": ["business_goals", "target_audience"]
      }
    },
    {
      "name": "content-auditor",
      "description": "Analyzes existing content quality, relevance, performance, and alignment with strategy",
      "category": "audit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "website_url": {
            "type": "string",
            "description": "Website URL to audit"
          },
          "content_scope": {
            "type": "string",
            "description": "Scope of content to audit (all, blog, pages, etc.)"
          },
          "audit_focus": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "quality",
                "relevance",
                "seo",
                "engagement",
                "performance",
                "accessibility"
              ]
            },
            "description": "Specific audit focus areas"
          },
          "benchmark_against": {
            "type": "string",
            "description": "Competitors or benchmarks to compare against"
          },
          "date_range": {
            "type": "string",
            "description": "Date range for analytics and performance metrics"
          },
          "include_metadata": {
            "type": "boolean",
            "description": "Include metadata and technical analysis"
          }
        },
        "required": ["website_url"]
      }
    },
    {
      "name": "gap-analyzer",
      "description": "Identifies missing content, topic opportunities, and areas for expansion",
      "category": "analysis",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content_inventory": {
            "type": "string",
            "description": "Current content topics and themes"
          },
          "target_keywords": {
            "type": "string",
            "description": "Target keywords and search intent"
          },
          "audience_needs": {
            "type": "string",
            "description": "Identified user needs and questions"
          },
          "competitor_topics": {
            "type": "string",
            "description": "Competitor content and topics"
          },
          "industry_standards": {
            "type": "string",
            "description": "Industry best practices and trending topics"
          },
          "gap_type": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["topic", "keyword", "format", "depth", "urgency"]
            },
            "description": "Types of gaps to focus on"
          }
        },
        "required": ["content_inventory"]
      }
    },
    {
      "name": "seo-optimizer",
      "description": "Provides SEO optimization recommendations for content and technical implementation",
      "category": "seo",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Content to optimize"
          },
          "target_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Primary and secondary target keywords"
          },
          "current_performance": {
            "type": "string",
            "description": "Current SEO metrics and rankings"
          },
          "optimization_focus": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "on-page",
                "technical",
                "structure",
                "links",
                "metadata",
                "keywords"
              ]
            },
            "description": "Focus areas for optimization"
          },
          "content_type": {
            "type": "string",
            "enum": ["blog", "page", "product", "landing"],
            "description": "Type of content being optimized"
          },
          "target_position": {
            "type": "integer",
            "description": "Target ranking position"
          }
        },
        "required": ["content", "target_keywords"]
      }
    },
    {
      "name": "keyword-researcher",
      "description": "Research and identifies high-value keyword opportunities with intent and metrics",
      "category": "research",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_topic": {
            "type": "string",
            "description": "Main business topic or product category"
          },
          "seed_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Starting keywords for research"
          },
          "target_audience": {
            "type": "string",
            "description": "Target audience characteristics"
          },
          "intent_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "informational",
                "navigational",
                "commercial",
                "transactional"
              ]
            },
            "description": "Keyword intent types to focus on"
          },
          "research_depth": {
            "type": "string",
            "enum": ["basic", "moderate", "comprehensive"],
            "description": "Depth of keyword research"
          },
          "competitive_landscape": {
            "type": "string",
            "description": "Competitive difficulty and market context"
          },
          "volume_range": {
            "type": "string",
            "description": "Target search volume range"
          }
        },
        "required": ["business_topic"]
      }
    },
    {
      "name": "content-planner",
      "description": "Creates content calendars, publishing schedules, and editorial timelines",
      "category": "planning",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content_list": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of content pieces to plan"
          },
          "publishing_frequency": {
            "type": "string",
            "enum": [
              "daily",
              "3x-weekly",
              "weekly",
              "2x-monthly",
              "monthly",
              "quarterly"
            ],
            "description": "Target publishing frequency"
          },
          "timeline_start": {
            "type": "string",
            "description": "Start date for calendar (YYYY-MM-DD)"
          },
          "timeline_duration": {
            "type": "string",
            "enum": ["3-months", "6-months", "12-months"],
            "description": "Duration of content calendar"
          },
          "content_priorities": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Priority topics or initiatives"
          },
          "distribution_channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["blog", "social-media", "email", "website", "paid-ads"]
            },
            "description": "Distribution channels"
          },
          "team_capacity": {
            "type": "string",
            "description": "Available team resources and capacity"
          },
          "calendar_format": {
            "type": "string",
            "enum": ["spreadsheet", "markdown", "calendar-view"],
            "description": "Preferred calendar format"
          }
        },
        "required": ["content_list", "publishing_frequency"]
      }
    }
  ]
}
