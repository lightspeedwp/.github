{
  "version": "1.0.0",
  "provider": "claude",
  "tools": [
    {
      "name": "pagespeed-analyzer",
      "description": "Analyze website performance metrics using Google PageSpeed Insights API and Core Web Vitals data",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to analyze"
          },
          "strategy": {
            "type": "string",
            "enum": ["mobile", "desktop", "both"],
            "description": "Performance analysis strategy"
          },
          "includeHistory": {
            "type": "boolean",
            "description": "Include historical performance data"
          },
          "includeCrux": {
            "type": "boolean",
            "description": "Include Chrome UX Report (real-world data)"
          },
          "locale": {
            "type": "string",
            "description": "Target locale for CrUX data"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "performance-tester",
      "description": "Run synthetic performance tests and load testing on website",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to test"
          },
          "testType": {
            "type": "string",
            "enum": ["lighthouse", "webpagetest", "speedcurve", "synthetic"],
            "description": "Type of performance test"
          },
          "networkProfile": {
            "type": "string",
            "enum": ["4g", "3g", "wifi", "cable"],
            "description": "Network conditions to simulate"
          },
          "deviceProfile": {
            "type": "string",
            "enum": ["mobile", "tablet", "desktop"],
            "description": "Device type for testing"
          },
          "iterations": {
            "type": "integer",
            "description": "Number of test runs for average"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "bottleneck-detector",
      "description": "Identify performance bottlenecks including slow resources and rendering issues",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to analyze"
          },
          "analysisType": {
            "type": "string",
            "enum": ["javascript", "css", "images", "fonts", "third-party", "rendering", "network"],
            "description": "Type of bottleneck to focus on"
          },
          "threshold": {
            "type": "number",
            "description": "Impact threshold (1-100) for bottleneck detection"
          },
          "includeThirdParty": {
            "type": "boolean",
            "description": "Include third-party script analysis"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "optimization-recommender",
      "description": "Generate prioritized optimization recommendations based on performance analysis",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to optimize"
          },
          "priority": {
            "type": "string",
            "enum": ["quick-wins", "high-impact", "comprehensive", "custom"],
            "description": "Optimization prioritization strategy"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["no-design-changes", "no-rebuilds", "low-cost", "minimal-effort"]
            },
            "description": "Constraints on recommended optimizations"
          },
          "targetMetrics": {
            "type": "object",
            "properties": {
              "lcp": {"type": "number"},
              "inp": {"type": "number"},
              "cls": {"type": "number"}
            },
            "description": "Target Core Web Vitals values"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "caching-strategist",
      "description": "Develop optimal caching strategy for static assets, API responses, and content",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to analyze"
          },
          "cacheLayers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["browser", "cdn", "server", "db"]
            },
            "description": "Cache layers to include"
          },
          "contentTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["static", "dynamic", "api", "database"]
            },
            "description": "Types of content to cache"
          },
          "ttlStrategy": {
            "type": "string",
            "enum": ["aggressive", "balanced", "conservative"],
            "description": "TTL duration strategy"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "cdn-optimizer",
      "description": "Analyze and optimize CDN configuration for content delivery",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL"
          },
          "currentCdn": {
            "type": "string",
            "enum": ["cloudflare", "cloudfront", "fastly", "akamai", "none"],
            "description": "Current CDN provider"
          },
          "targetRegions": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Target geographic regions"
          },
          "budget": {
            "type": "number",
            "description": "Monthly CDN budget"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "image-optimizer",
      "description": "Analyze images and generate optimization recommendations including formats and sizes",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to analyze"
          },
          "targetFormats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["webp", "avif", "jpg", "png", "svg"]
            },
            "description": "Target image formats"
          },
          "responsiveStrategy": {
            "type": "string",
            "enum": ["srcset", "picture", "auto", "none"],
            "description": "Responsive image strategy"
          },
          "compressionLevel": {
            "type": "string",
            "enum": ["aggressive", "balanced", "lossless"],
            "description": "Image compression level"
          }
        },
        "required": ["url"]
      }
    },
    {
      "name": "performance-monitor",
      "description": "Set up continuous performance monitoring and alerting",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Website URL to monitor"
          },
          "metrics": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Metrics to monitor (lcp, inp, cls, ttfb, etc.)"
          },
          "alertThresholds": {
            "type": "object",
            "description": "Thresholds for performance alerts"
          },
          "frequency": {
            "type": "string",
            "enum": ["hourly", "daily", "weekly"],
            "description": "Monitoring frequency"
          }
        },
        "required": ["url", "metrics"]
      }
    }
  ]
}