{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Traceability",
  "type": "object",
  "required": [
    "requirement_id",
    "prd_reference",
    "figma_reference",
    "repo_reference",
    "test_case_id",
    "playwright_spec_path",
    "status",
    "coverage_confidence",
    "notes"
  ],
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1 },
    "prd_reference": { "type": "string", "minLength": 1 },
    "figma_reference": { "type": "string", "minLength": 1 },
    "repo_reference": { "type": "string", "minLength": 1 },
    "test_case_id": { "type": "string", "minLength": 1 },
    "playwright_spec_path": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "implemented", "blocked", "validated"]
    },
    "coverage_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
