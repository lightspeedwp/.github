{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent File Metadata",
  "type": "object",
  "required": [
    "path",
    "category",
    "purpose",
    "required_headings",
    "validation_rules"
  ],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "reference",
        "template",
        "example",
        "fixture",
        "profile",
        "test",
        "script",
        "memory",
        "root"
      ]
    },
    "purpose": { "type": "string", "minLength": 1 },
    "required_headings": { "type": "array", "items": { "type": "string" } },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
