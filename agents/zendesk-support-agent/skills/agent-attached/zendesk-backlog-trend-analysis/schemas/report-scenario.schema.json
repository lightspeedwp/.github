{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zendesk Backlog Trend Skill Evaluation Scenario",
  "type": "object",
  "required": ["version", "purpose", "scenarios"],
  "properties": {
    "version": {"type": "string"},
    "purpose": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "expected_report_type",
          "required_evidence",
          "required_behaviours",
          "forbidden_behaviours"
        ],
        "properties": {
          "id": {"type": "string"},
          "prompt": {"type": "string"},
          "expected_report_type": {"type": "string"},
          "required_evidence": {"type": "array", "items": {"type": "string"}},
          "required_behaviours": {"type": "array", "items": {"type": "string"}},
          "forbidden_behaviours": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
