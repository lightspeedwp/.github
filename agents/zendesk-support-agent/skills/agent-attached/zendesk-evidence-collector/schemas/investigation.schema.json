{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeedwp.agency/schemas/zendesk-evidence-collector-investigation.schema.json",
  "title": "Zendesk Case Investigation",
  "description": "Structured representation of a Zendesk-first single-case investigation for RCA, proof, lookup, timeline reconstruction, reproduction context, or diagnostic support work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "issue_being_investigated",
    "confirmed_facts",
    "branch_ledger",
    "conclusion",
    "missing_or_uncertain_evidence",
    "recommended_next_action",
    "sources_checked"
  ],
  "properties": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "customer_account", "investigation_goal", "current_disposition"],
      "properties": {
        "ticket": {"type": "string", "description": "Ticket ID, ticket URL, or best available identifier. Use unknown when not available."},
        "customer_account": {"type": "string", "description": "Customer, requester, organisation, account, or unknown."},
        "investigation_goal": {"type": "string", "enum": ["RCA", "Proof", "Lookup"]},
        "current_disposition": {
          "type": "string",
          "enum": [
            "Confirmed root cause",
            "Likely cause",
            "Proven",
            "Disproven",
            "Inconclusive",
            "Blocked",
            "Lookup answered"
          ]
        }
      }
    },
    "issue_being_investigated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected_behaviour", "actual_behaviour"],
      "properties": {
        "summary": {"type": "string"},
        "expected_behaviour": {"type": "string"},
        "actual_behaviour": {"type": "string"},
        "stable_identifiers": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_identifier"}
        },
        "channel_or_surface": {"type": "string"},
        "relevant_time_window": {"type": "string"}
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_statement"},
      "description": "Facts directly supported by checked evidence. Do not include assumptions."
    },
    "branch_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/branch"},
      "description": "Critical branches that could change the conclusion."
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "confidence"],
      "properties": {
        "answer": {"type": "string"},
        "confidence": {"type": "string", "enum": ["confirmed", "likely", "inconclusive", "blocked"]},
        "caveat": {"type": "string"}
      }
    },
    "missing_or_uncertain_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    },
    "recommended_next_action": {"type": "string"},
    "sources_checked": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_checked"}
    }
  },
  "$defs": {
    "stable_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string"},
        "value": {"type": "string"}
      }
    },
    "evidence_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "source_category", "certainty"],
      "properties": {
        "statement": {"type": "string"},
        "source_category": {"type": "string"},
        "certainty": {"type": "string", "enum": ["confirmed", "inferred", "unknown"]},
        "source_note": {"type": "string"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "question", "source_category", "status", "evidence"],
      "properties": {
        "branch": {"type": "string"},
        "question": {"type": "string"},
        "source_category": {"type": "string"},
        "status": {"type": "string", "enum": ["verified", "disproven", "blocked", "unknown"]},
        "evidence": {"type": "string"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap", "impact"],
      "properties": {
        "gap": {"type": "string"},
        "impact": {"type": "string"},
        "smallest_next_evidence": {"type": "string"}
      }
    },
    "source_checked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_category", "used_for", "available"],
      "properties": {
        "source_category": {"type": "string"},
        "used_for": {"type": "string"},
        "available": {"type": "boolean"},
        "limitation": {"type": "string"}
      }
    }
  }
}
