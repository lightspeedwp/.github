{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeedwp.agency/schemas/zendesk-evidence-pack.schema.json",
  "title": "Zendesk Evidence Pack",
  "description": "Structured representation of a Zendesk-first evidence pack before triage, reply drafting, escalation, duplicate review, knowledge review, or backlog analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "confirmed_facts",
    "missing_or_uncertain_evidence",
    "readiness",
    "best_next_move",
    "sources_checked"
  ],
  "properties": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "customer_account", "current_state", "likely_workflow", "deliverable"],
      "properties": {
        "ticket": {"type": "string", "description": "Ticket ID, ticket URL, or best available identifier. Use unknown when not available."},
        "customer_account": {"type": "string", "description": "Customer, requester, organisation, account, or unknown."},
        "current_state": {"type": "string", "description": "Status, owner, priority, urgency, SLA or ageing signal, or unknown."},
        "likely_workflow": {
          "type": "string",
          "enum": [
            "triage",
            "investigation",
            "reply_drafting",
            "escalation",
            "handoff_prep",
            "duplicate_review",
            "knowledge_review",
            "backlog_analysis",
            "other"
          ]
        },
        "deliverable": {"type": "string", "description": "Requested or inferred deliverable."}
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_statement"},
      "description": "Facts directly supported by checked evidence. Do not include assumptions."
    },
    "key_chronology": {
      "type": "array",
      "items": {"$ref": "#/$defs/timeline_item"},
      "description": "Compact recent chronology for one confirmed case. Omit when most_relevant_tickets is used."
    },
    "most_relevant_tickets": {
      "type": "array",
      "items": {"$ref": "#/$defs/ticket_candidate"},
      "description": "Use instead of key_chronology when the input is a customer or account search rather than one confirmed ticket."
    },
    "informed_inferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_statement"},
      "description": "Clearly labelled inferences based on available evidence."
    },
    "missing_or_uncertain_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"},
      "description": "Missing identifiers, unavailable connector access, unresolved contradictions, or other blockers."
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["ready", "partially_ready", "not_ready"]},
        "reason": {"type": "string"}
      }
    },
    "best_next_move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_workflow", "supporting_workflow", "immediate_next_action"],
      "properties": {
        "primary_workflow": {"type": "string", "description": "Use a canonical zendesk- prefixed companion name when routing away, continue_in_zendesk_evidence_collector for this skill, zendesk-router-skill when routing is unclear, or none when no workflow is recommended."},
        "supporting_workflow": {"type": "string", "description": "Use a canonical zendesk- prefixed companion name when routing away. Use none when there is no supporting workflow."},
        "immediate_next_action": {"type": "string"}
      }
    },
    "sources_checked": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_checked"},
      "description": "Source categories checked and what each was used for."
    }
  },
  "$defs": {
    "evidence_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "source_category", "certainty"],
      "properties": {
        "statement": {"type": "string"},
        "source_category": {"type": "string"},
        "certainty": {"type": "string", "enum": ["confirmed", "inferred", "unknown"]},
        "source_note": {"type": "string"}
      }
    },
    "timeline_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "event", "source_category"],
      "properties": {
        "when": {"type": "string", "description": "Date, time window, relative sequence, or unknown."},
        "event": {"type": "string"},
        "source_category": {"type": "string"}
      }
    },
    "ticket_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "reason", "current_state"],
      "properties": {
        "ticket": {"type": "string"},
        "reason": {"type": "string"},
        "current_state": {"type": "string"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap", "impact"],
      "properties": {
        "gap": {"type": "string"},
        "impact": {"type": "string"},
        "smallest_next_evidence": {"type": "string"}
      }
    },
    "source_checked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_category", "used_for", "available"],
      "properties": {
        "source_category": {"type": "string"},
        "used_for": {"type": "string"},
        "available": {"type": "boolean"},
        "limitation": {"type": "string"}
      }
    }
  }
}
