{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeedwp.agency/skills/zendesk-duplicate-pattern-review/duplicate-pattern-review.schema.json",
  "title": "Zendesk duplicate and pattern review",
  "description": "Structured handoff format for Zendesk-first duplicate, related-case, repeated-pain, incident-pattern, or inconclusive support reviews.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationship_classification",
    "confidence",
    "access_context",
    "comparison_set",
    "evidence_used",
    "reasoning_summary",
    "recommended_actions",
    "next_workflow",
    "limitations"
  ],
  "properties": {
    "relationship_classification": {
      "type": "string",
      "enum": [
        "likely_duplicate",
        "related_but_distinct",
        "repeated_pain_pattern",
        "broader_incident_pattern",
        "inconclusive"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "access_context": {
      "type": "string",
      "enum": [
        "full_zendesk_access",
        "partial_zendesk_access",
        "supplied_evidence_only",
        "secondary_connector_evidence",
        "unknown"
      ]
    },
    "comparison_set": {
      "type": "array",
      "description": "Ticket references, case names, customer reports, or manually described evidence items compared in the review.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "source_type", "summary"],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Ticket ID, ticket URL, pasted-case label, or other non-sensitive reference. Do not invent IDs."
          },
          "source_type": {
            "type": "string",
            "enum": ["zendesk_ticket", "pasted_ticket_text", "manual_summary", "secondary_connector", "unknown"]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "evidence_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "detail", "supports"],
        "properties": {
          "evidence_type": {
            "type": "string",
            "enum": [
              "symptom",
              "timing",
              "scope",
              "customer_context",
              "likely_cause",
              "resolution_path",
              "metadata",
              "internal_note",
              "public_reply",
              "linked_ticket",
              "known_issue_indicator",
              "other"
            ]
          },
          "detail": {
            "type": "string"
          },
          "supports": {
            "type": "string",
            "description": "Explain which classification or handling recommendation this evidence supports."
          }
        }
      }
    },
    "reasoning_summary": {
      "type": "string"
    },
    "recommended_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_tickets",
        "merge_tickets",
        "keep_separate",
        "escalate",
        "include_in_reporting"
      ],
      "properties": {
        "link_tickets": { "$ref": "#/$defs/yes_no_maybe_action" },
        "merge_tickets": { "$ref": "#/$defs/merge_action" },
        "keep_separate": { "$ref": "#/$defs/yes_no_action" },
        "escalate": { "$ref": "#/$defs/yes_no_not_yet_action" },
        "include_in_reporting": { "$ref": "#/$defs/yes_no_maybe_action" }
      }
    },
    "next_workflow": {
      "type": "string",
      "enum": [
        "zendesk-triage-router",
        "zendesk-evidence-collector",
        "zendesk-backlog-trend-analysis",
        "zendesk-customer-escalation",
        "zendesk-case-readiness-check",
        "zendesk-draft-response",
        "zendesk-knowledge-candidate-review",
        "zendesk-create-knowledge",
        "zendesk-handoff-prep",
        "zendesk-router-skill",
        "none"
      ]
    },
    "smallest_missing_evidence": {
      "type": "array",
      "description": "Use when confidence is low, access is limited, or the next action depends on unseen Zendesk evidence.",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "description": "Access, evidence, timing, or source limitations that should prevent overclaiming.",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "yes_no_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": "string", "enum": ["yes", "no"] },
        "reason": { "type": "string" }
      }
    },
    "yes_no_maybe_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": "string", "enum": ["yes", "no", "maybe"] },
        "reason": { "type": "string" }
      }
    },
    "yes_no_not_yet_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": "string", "enum": ["yes", "no", "not_yet"] },
        "reason": { "type": "string" }
      }
    },
    "merge_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": "string", "enum": ["yes", "no", "not_yet"] },
        "reason": { "type": "string" }
      }
    }
  }
}
