{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeedwp.agency/schemas/zendesk-bug-report-package.schema.json",
  "title": "zendesk bug report package",
  "description": "optional structured representation of a zendesk-first internal bug report package. use when the user asks for json, validation, automation handoff, or schema-aligned output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readiness",
    "problem_statement",
    "affected_context",
    "expected_behaviour",
    "actual_behaviour",
    "reproduction",
    "troubleshooting_attempted",
    "impact_severity_timeline",
    "evidence_register",
    "recommended_next_action",
    "caution_notes"
  ],
  "properties": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "partially_ready",
            "not_ready"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "problem_statement": {
      "type": "string"
    },
    "affected_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "requester_or_account",
        "product_surface",
        "environment",
        "frequency_scope"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "requester_or_account": {
          "type": "string"
        },
        "product_surface": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "frequency_scope": {
          "type": "string"
        }
      }
    },
    "expected_behaviour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "source_confidence"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "source_confidence": {
          "type": "string",
          "enum": [
            "documented",
            "support_assumption",
            "user_expectation",
            "unknown"
          ]
        }
      }
    },
    "actual_behaviour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "support_observed",
        "user_reported",
        "inferred"
      ],
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_reported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps_or_clues",
        "missing_detail"
      ],
      "properties": {
        "steps_or_clues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_detail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "troubleshooting_attempted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact_severity_timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_users_or_accounts",
        "impact",
        "workaround",
        "timeline",
        "escalation_cues"
      ],
      "properties": {
        "affected_users_or_accounts": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "workaround": {
          "type": "string"
        },
        "timeline": {
          "type": "string"
        },
        "escalation_cues": {
          "type": "string"
        }
      }
    },
    "evidence_register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_support_observed",
        "user_reported_unconfirmed",
        "inference_assumptions",
        "missing_evidence_gaps"
      ],
      "properties": {
        "confirmed_support_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_reported_unconfirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inference_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recommended_next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "recommended_destination_or_skill",
        "exact_ask"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "hand_off_to_engineering_or_product",
            "request_more_reproduction_detail",
            "do_more_zendesk_or_customer_research",
            "escalate",
            "draft_separate_customer_reply"
          ]
        },
        "recommended_destination_or_skill": {
          "type": "string"
        },
        "exact_ask": {
          "type": "string"
        }
      }
    },
    "caution_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
