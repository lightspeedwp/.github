{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Todos",
  "description": "Durable cross-run follow-up items that should persist until completed or intentionally removed.",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Grouped durable todo lists.",
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Section name for a group of related durable follow-up items."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3,
              "description": "A concise durable follow-up item."
            },
            "uniqueItems": true,
            "description": "Durable follow-up items that still matter across runs."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
