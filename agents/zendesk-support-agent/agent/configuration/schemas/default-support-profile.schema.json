{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Default Support Profile",
  "type": "object",
  "required": [
    "name",
    "default_output_style",
    "default_operating_mode",
    "default_evidence_standard",
    "default_write_behavior",
    "required_output_sections",
    "customer_reply_rules",
    "internal_handoff_rules",
    "backlog_report_rules",
    "documentation_review_rules",
    "bug_package_rules",
    "memory_rules",
    "approved_memory_files",
    "memory_example_files",
    "template_files",
    "example_files",
    "template_example_pairs",
    "template_usage_rules",
    "example_usage_rules",
    "fixture_files",
    "fixture_schema_pairs",
    "fixture_usage_rules",
    "profile_usage_rules",
    "report_default_keys",
    "profile_schema",
    "phase_3_alignment_files",
    "batch_2_alignment_rules"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 3},
    "default_output_style": {"type": "string", "const": "concise_markdown"},
    "default_operating_mode": {"type": "string", "const": "zendesk_first"},
    "default_evidence_standard": {"type": "string", "const": "confirmed_facts_plus_labeled_inference"},
    "default_write_behavior": {"type": "string", "const": "draft_before_write_when_ambiguous"},
    "required_output_sections": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "customer_reply_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "internal_handoff_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "backlog_report_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "documentation_review_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "bug_package_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "memory_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "approved_memory_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^memory/"},
      "minItems": 4,
      "uniqueItems": true
    },
    "memory_example_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^examples/memory/"},
      "minItems": 4,
      "uniqueItems": true
    },
    "template_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^templates/"},
      "minItems": 8,
      "uniqueItems": true
    },
    "example_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^examples/templates/"},
      "minItems": 8,
      "uniqueItems": true
    },
    "template_example_pairs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["template", "example", "deliverable"],
        "properties": {
          "template": {"type": "string", "pattern": "^templates/"},
          "example": {"type": "string", "pattern": "^examples/templates/"},
          "deliverable": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    },
    "template_usage_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "example_usage_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "fixture_files": {
      "type": "array",
      "items": {"type": "string", "pattern": "^fixtures/"},
      "minItems": 2,
      "uniqueItems": true
    },
    "fixture_schema_pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["fixture", "schema", "primary_deliverables"],
        "properties": {
          "fixture": {"type": "string", "pattern": "^fixtures/"},
          "schema": {"type": "string", "pattern": "^schemas/"},
          "primary_deliverables": {
            "type": "array",
            "items": {"type": "string", "minLength": 3},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "fixture_usage_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "profile_usage_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "uniqueItems": true
    },
    "report_default_keys": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "uniqueItems": true
    },
    "profile_schema": {"type": "string", "pattern": "^schemas/"},
    "phase_3_alignment_files": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "uniqueItems": true
    },
    "batch_2_alignment_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 4,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
