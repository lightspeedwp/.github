[
  {
    "name": "prd_create",
    "description": "Generate a complete product requirement document with executive summary, objectives, requirements, success metrics, and implementation timeline",
    "input_schema": {
      "type": "object",
      "properties": {
        "product_name": {
          "type": "string",
          "description": "Name of the product or feature being documented"
        },
        "vision_statement": {
          "type": "string",
          "description": "Clear statement of what this product/feature aims to achieve"
        },
        "user_personas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "goals": { "type": "array", "items": { "type": "string" } },
              "pain_points": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "Target user personas and their characteristics"
        },
        "key_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "type": { "enum": ["functional", "non-functional", "constraint"] }
            }
          },
          "description": "List of key product requirements"
        },
        "success_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": { "type": "string" },
              "target": { "type": "string" },
              "baseline": { "type": "string" }
            }
          },
          "description": "Measurable success criteria"
        },
        "timeline_months": {
          "type": "number",
          "description": "Estimated timeline in months for full delivery"
        }
      },
      "required": [
        "product_name",
        "vision_statement",
        "key_requirements",
        "success_metrics"
      ]
    }
  },
  {
    "name": "prd_validate",
    "description": "Validate a PRD for completeness, clarity, and quality",
    "input_schema": {
      "type": "object",
      "properties": {
        "prd_content": {
          "type": "string",
          "description": "The PRD document content to validate"
        },
        "check_type": {
          "type": "string",
          "enum": ["completeness", "clarity", "feasibility", "all"],
          "description": "Type of validation to perform"
        }
      },
      "required": ["prd_content"]
    }
  },
  {
    "name": "feature_prioritizer",
    "description": "Prioritize features using impact/effort matrix and business alignment",
    "input_schema": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "business_impact": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              "effort_estimate": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "List of features to prioritize"
        },
        "constraints": {
          "type": "object",
          "properties": {
            "timeline_weeks": { "type": "number" },
            "team_capacity": { "type": "number" },
            "resource_constraints": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "description": "Project constraints for prioritization"
        }
      },
      "required": ["features"]
    }
  },
  {
    "name": "user_story_generator",
    "description": "Generate user stories with acceptance criteria from requirements",
    "input_schema": {
      "type": "object",
      "properties": {
        "feature_title": { "type": "string" },
        "feature_description": { "type": "string" },
        "user_persona": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        "acceptance_criteria_count": {
          "type": "number",
          "description": "Number of acceptance criteria to generate"
        }
      },
      "required": ["feature_title", "feature_description"]
    }
  },
  {
    "name": "timeline_planner",
    "description": "Create realistic timeline and sprint plans with contingency",
    "input_schema": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "effort_weeks": { "type": "number" },
              "priority": { "type": "number" },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "team_velocity": {
          "type": "number",
          "description": "Story points or features per sprint"
        },
        "sprint_length_weeks": {
          "type": "number",
          "description": "Length of each sprint in weeks"
        },
        "contingency_percent": {
          "type": "number",
          "description": "Buffer percentage for unknowns (typically 20-30)",
          "default": 25
        }
      },
      "required": ["features"]
    }
  },
  {
    "name": "roadmap_generator",
    "description": "Create a product roadmap with release phases and milestones",
    "input_schema": {
      "type": "object",
      "properties": {
        "product_vision": { "type": "string" },
        "timeline_months": { "type": "number" },
        "release_phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "month": { "type": "number" },
              "features": { "type": "array", "items": { "type": "string" } },
              "objectives": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "required": ["product_vision", "timeline_months"]
    }
  },
  {
    "name": "risk_assessor",
    "description": "Identify and assess risks, dependencies, and blockers",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_scope": { "type": "string" },
        "team_expertise": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dependency": { "type": "string" },
              "risk_level": { "enum": ["low", "medium", "high"] },
              "impact": { "type": "string" }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["project_scope"]
    }
  },
  {
    "name": "sprint_planner",
    "description": "Plan individual sprints with features, tasks, and team assignments",
    "input_schema": {
      "type": "object",
      "properties": {
        "sprint_name": { "type": "string" },
        "sprint_duration_days": { "type": "number" },
        "team_members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "available_features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "effort_estimate": { "type": "number" },
              "priority": { "type": "number" }
            }
          }
        },
        "team_velocity": { "type": "number" }
      },
      "required": ["sprint_name", "team_members"]
    }
  }
]
