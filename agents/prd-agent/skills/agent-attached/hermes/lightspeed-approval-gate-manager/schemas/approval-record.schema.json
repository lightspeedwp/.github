{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval record",
  "type": "object",
  "required": ["approval_stage", "readiness_status", "next_action"],
  "properties": {
    "approval_stage": { "type": "string" },
    "artefacts_under_review": { "type": "array", "items": { "type": "string" } },
    "required_approvers": { "type": "array", "items": { "type": "string" } },
    "readiness_status": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" }
  },
  "additionalProperties": false
}
