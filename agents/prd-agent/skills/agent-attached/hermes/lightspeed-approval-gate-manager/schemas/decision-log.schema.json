{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision log",
  "type": "object",
  "required": ["decision", "context"],
  "properties": {
    "decision": { "type": "string" },
    "context": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "follow_up": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
