{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project intake",
  "type": "object",
  "required": ["intake_summary", "confirmed_facts", "missing_evidence", "recommended_next_skill"],
  "properties": {
    "intake_summary": { "type": "string" },
    "confirmed_facts": { "type": "array", "items": { "type": "string" } },
    "inferred_assumptions": { "type": "array", "items": { "type": "string" } },
    "excluded_sources": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "recommended_next_skill": { "type": "string" }
  },
  "additionalProperties": false
}