{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence register",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source", "status", "confidence"],
    "properties": {
      "source": { "type": "string" },
      "type": { "type": "string" },
      "status": { "type": "string" },
      "confidence": { "type": "string" },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  }
}