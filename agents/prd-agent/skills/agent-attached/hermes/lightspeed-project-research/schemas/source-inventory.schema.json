{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source inventory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source", "confidence", "role"],
    "properties": {
      "source": { "type": "string" },
      "confidence": { "type": "string" },
      "role": { "type": "string" },
      "key_value": { "type": "string" },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  }
}