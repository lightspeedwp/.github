[
  {
    "type": "function",
    "function": {
      "name": "create_prd",
      "description": "Generate a complete product requirement document with all sections",
      "parameters": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string",
            "description": "Name of the product or feature"
          },
          "vision_statement": {
            "type": "string",
            "description": "Product vision and goals"
          },
          "user_personas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "goals": { "type": "array", "items": { "type": "string" } }
              }
            },
            "description": "Target user personas"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "type": { "enum": ["functional", "non-functional"] }
              }
            },
            "description": "Product requirements"
          },
          "success_metrics": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Success criteria"
          }
        },
        "required": ["product_name", "vision_statement", "requirements"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "generate_feature_spec",
      "description": "Generate a detailed feature specification with acceptance criteria",
      "parameters": {
        "type": "object",
        "properties": {
          "feature_title": { "type": "string" },
          "description": { "type": "string" },
          "user_stories_count": {
            "type": "integer",
            "description": "Number of user stories to generate"
          },
          "acceptance_criteria_per_story": {
            "type": "integer",
            "default": 3
          }
        },
        "required": ["feature_title", "description"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "prioritize_features",
      "description": "Rank features using impact/effort matrix and business alignment",
      "parameters": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "business_impact": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10
                },
                "effort_estimate": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            }
          },
          "strategy": {
            "enum": ["impact_first", "effort_first", "balanced"],
            "default": "balanced"
          }
        },
        "required": ["features"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "estimate_timeline",
      "description": "Create realistic timeline with contingency planning",
      "parameters": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "effort_weeks": { "type": "number" },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "team_velocity": { "type": "number" },
          "contingency_percent": {
            "type": "number",
            "default": 25
          }
        },
        "required": ["features"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "assess_risks",
      "description": "Identify and assess risks, dependencies, and blockers",
      "parameters": {
        "type": "object",
        "properties": {
          "project_scope": { "type": "string" },
          "team_constraints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "external_dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk_level_threshold": {
            "enum": ["low", "medium", "high"],
            "default": "medium"
          }
        },
        "required": ["project_scope"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_sprints",
      "description": "Generate detailed sprint plans with task breakdown",
      "parameters": {
        "type": "object",
        "properties": {
          "sprint_duration_days": { "type": "integer" },
          "team_capacity": { "type": "number" },
          "features_to_schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "effort_estimate": { "type": "number" },
                "priority": { "type": "integer" }
              }
            }
          },
          "sprint_count": {
            "type": "integer",
            "description": "Number of sprints to plan"
          }
        },
        "required": ["sprint_duration_days", "team_capacity", "sprint_count"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "generate_roadmap",
      "description": "Create a product roadmap with releases and milestones",
      "parameters": {
        "type": "object",
        "properties": {
          "product_vision": { "type": "string" },
          "timeline_months": { "type": "number" },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "objectives": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "required": ["product_vision", "timeline_months"]
      }
    }
  }
]
