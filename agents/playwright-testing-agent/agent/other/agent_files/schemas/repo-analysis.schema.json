{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Analysis",
  "type": "object",
  "required": [
    "repository_name",
    "project_type",
    "package_manager",
    "existing_test_setup",
    "existing_playwright_files",
    "theme_plugin_structure",
    "relevant_routes",
    "test_id_conventions",
    "fixtures",
    "ci_workflows",
    "risks",
    "recommended_file_changes"
  ],
  "properties": {
    "repository_name": { "type": "string", "minLength": 1 },
    "project_type": { "type": "string", "minLength": 1 },
    "package_manager": { "type": "string", "minLength": 1 },
    "existing_test_setup": { "type": "array", "items": { "type": "string" } },
    "existing_playwright_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "theme_plugin_structure": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relevant_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "test_id_conventions": { "type": "array", "items": { "type": "string" } },
    "fixtures": { "type": "array", "items": { "type": "string" } },
    "ci_workflows": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_file_changes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
