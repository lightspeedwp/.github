{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory File",
  "type": "object",
  "required": [
    "file_name",
    "purpose",
    "allowed_content",
    "forbidden_content",
    "review_rules"
  ],
  "properties": {
    "file_name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}