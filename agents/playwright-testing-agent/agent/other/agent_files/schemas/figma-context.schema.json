{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma Context Extraction",
  "type": "object",
  "required": [
    "figma_file",
    "node_ids",
    "page_frame_names",
    "components",
    "variables_tokens",
    "interaction_notes",
    "breakpoints",
    "visual_regression_candidates",
    "content_expectations",
    "open_questions"
  ],
  "properties": {
    "figma_file": {"type": "string", "minLength": 1},
    "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "page_frame_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "components": {"type": "array", "items": {"type": "string"}},
    "variables_tokens": {"type": "array", "items": {"type": "string"}},
    "interaction_notes": {"type": "array", "items": {"type": "string"}},
    "breakpoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "visual_regression_candidates": {"type": "array", "items": {"type": "string"}},
    "content_expectations": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}