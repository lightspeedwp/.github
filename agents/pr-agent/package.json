{
  "name": "@lightspeedwp/pr-agent",
  "version": "1.0.0",
  "description": "Portable PR agent for GitHub pull request creation, template routing, labelling, and error handling.",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest __tests__ --coverage",
    "test:validate-branch-name": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/validate-branch-name.test.js --verbose",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/e2e --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write '**/*.{js,json,yml,md}'",
    "validate": "npm run lint && npm run test"
  },
  "keywords": [
    "agent",
    "pr-agent",
    "pr-creation",
    "github",
    "workflow",
    "automation"
  ],
  "author": "LightSpeedWP",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/.github.git",
    "directory": "agents/pr-agent"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/node": "^26.5.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-esm-transformer": "^1.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "js-yaml": "^5.4.1"
  }
}
