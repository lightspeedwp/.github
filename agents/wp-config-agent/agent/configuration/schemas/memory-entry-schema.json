{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Entry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_type", "scope", "summary", "source", "updated_at"],
  "properties": {
    "memory_type": {
      "type": "string",
      "enum": [
        "preference",
        "default",
        "constraint",
        "project_state",
        "blocker",
        "follow_up",
        "handoff"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "site",
        "form",
        "seo",
        "qa",
        "project",
        "session"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "user_stated",
        "agent_inferred",
        "validated_from_site",
        "validated_from_file",
        "validated_from_app"
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "pending", "resolved", "stale"]
    }
  }
}
