{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template File Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filename",
    "title",
    "required_sections",
    "placeholder_style"
  ],
  "properties": {
    "filename": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-template\\.md$"
    },
    "title": {
      "type": "string",
      "pattern": "^# .+"
    },
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "placeholder_style": {
      "type": "string",
      "enum": [
        "blank-bullets",
        "blank-numbered-steps",
        "mixed-placeholders"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}