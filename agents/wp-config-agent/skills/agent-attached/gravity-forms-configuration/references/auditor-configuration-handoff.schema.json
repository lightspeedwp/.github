{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.local/schemas/auditor-configuration-handoff.schema.json",
  "title": "Gravity Forms Auditor Configuration Handoff",
  "type": "object",
  "required": [
    "contract_version",
    "handoff_id",
    "handoff_title",
    "source_audit",
    "source_skill",
    "target_skill",
    "site_url",
    "environment",
    "findings_included",
    "affected_items",
    "confirmed_evidence",
    "evidence_gaps",
    "risk_level",
    "priority_group",
    "recommendation_label",
    "proposed_remediation",
    "required_capabilities",
    "approval_requirements",
    "change_risk_notes",
    "validation_steps",
    "rollback_notes",
    "suggested_configuration_prompt"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 3
    },
    "handoff_title": {
      "type": "string",
      "minLength": 3
    },
    "source_audit": {
      "type": [
        "string",
        "object"
      ]
    },
    "source_skill": {
      "type": "string",
      "const": "gravity-forms-auditor"
    },
    "target_skill": {
      "type": "string",
      "const": "gravity-forms-configuration"
    },
    "site_url": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "local",
        "development",
        "unknown"
      ]
    },
    "findings_included": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "affected_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "page_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "minItems": 1
    },
    "confirmed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary",
          "confidence"
        ],
        "properties": {
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Blocker",
        "High",
        "Medium",
        "Low",
        "Info"
      ]
    },
    "priority_group": {
      "type": "string",
      "enum": [
        "Immediate",
        "Next",
        "Later"
      ]
    },
    "recommendation_label": {
      "type": "string",
      "enum": [
        "Platform requirement",
        "LightSpeed recommendation",
        "Client decision",
        "Missing evidence"
      ]
    },
    "proposed_remediation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_addons_or_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "change_risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "validation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "client_safe_summary": {
      "type": "string"
    },
    "suggested_configuration_prompt": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": true
}
