{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast configuration check",
  "type": "object",
  "required": [
    "area",
    "current_state",
    "recommendation",
    "risk",
    "qa"
  ],
  "properties": {
    "area": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "needs verification"
      ]
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
