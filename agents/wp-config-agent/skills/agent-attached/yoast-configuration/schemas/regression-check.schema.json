{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast regression check",
  "type": "object",
  "required": [
    "site",
    "environment",
    "changed_components",
    "checks",
    "overall_status"
  ],
  "properties": {
    "site": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "changed_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "baseline_date": {
      "type": "string"
    },
    "current_date": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_notes",
        "blocked",
        "failed",
        "needs_verification"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "status",
          "evidence"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable",
              "needs_verification"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}