{
  "name": "@lightspeedwp/frontmatter-validation",
  "version": "1.0.0",
  "description": "Frontmatter validation scripts for LightSpeedWP .github repository",
  "main": "validate-frontmatter.js",
  "scripts": {
    "validate": "node validate-frontmatter.js",
    "validate:help": "node validate-frontmatter.js --help",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "../../coverage/validation",
    "collectCoverageFrom": [
      "validate-frontmatter.js",
      "!**/__tests__/**",
      "!**/node_modules/**"
    ]
  },
  "keywords": [
    "frontmatter",
    "validation",
    "yaml",
    "schema",
    "lightspeed"
  ],
  "author": "LightSpeedWP Team",
  "license": "MIT"
}
