{
  "context": "github-control-plane",
  "repositories": [
    {
      "owner": "lightspeedwp",
      "name": ".github"
    }
  ],
  "metrics": {
    "issues": [
      "total",
      "closed",
      "ttf",
      "active",
      "stale",
      "reopened",
      "labels"
    ],
    "pull_requests": [
      "total",
      "merged",
      "ttm",
      "review_time",
      "participation",
      "size",
      "ci_pass_rate"
    ],
    "contributors": [
      "active",
      "breakdown",
      "top",
      "retention",
      "new_vs_returning"
    ],
    "health": [
      "milestone_progress",
      "epic_status",
      "backlog",
      "label_distribution",
      "velocity"
    ]
  },
  "collection_period": 7,
  "cache_ttl": 3600,
  "output_dir": ".github/reports/metrics"
}
