{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metrics Storage Schema",
  "description": "Schema for time-series metrics storage",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds"
    },
    "date": {
      "type": "string",
      "description": "ISO 8601 formatted date"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "closed": { "type": "number" },
            "active": { "type": "number" },
            "stale": { "type": "number" },
            "reopened": { "type": "number" },
            "ttf": { "type": "number" },
            "labels": { "type": "object" }
          },
          "required": ["total"]
        },
        "pull_requests": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "merged": { "type": "number" },
            "ttm": { "type": "number" },
            "review_time": { "type": "number" },
            "participation": { "type": "number" },
            "size": { "type": "number" },
            "ci_pass_rate": { "type": "number" }
          },
          "required": ["total"]
        },
        "contributors": {
          "type": "object",
          "properties": {
            "active": { "type": "number" },
            "breakdown": { "type": "object" },
            "top": { "type": "array" },
            "retention": { "type": "number" },
            "new_vs_returning": { "type": "object" }
          }
        },
        "health": {
          "type": "object",
          "properties": {
            "milestone_progress": { "type": "number" },
            "epic_status": { "type": "object" },
            "backlog": { "type": "number" },
            "label_distribution": { "type": "object" },
            "velocity": { "type": "number" }
          }
        }
      },
      "required": ["issues", "pull_requests", "contributors"]
    }
  },
  "required": ["timestamp", "date", "metrics"],
  "additionalProperties": false
}
