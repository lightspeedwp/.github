{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "graphify-out/graph.json"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
