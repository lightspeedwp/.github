# LightSpeed cloud environment — environment variables
#
# Canonical copy of the "Environment variables" field of the LightSpeed cloud
# environment at claude.ai/code. See docs/CLAUDE_CLOUD_ENVIRONMENT.md.
#
# .env format: one KEY=value per line. Everyone who uses the environment can read
# these values, so NEVER put secrets or tokens here.

# ── Branching strategy (read by .claude/hooks/*) ─────────────────────────────
# Integration branch every feature branch starts from and every PR targets.
LS_BASE_BRANCH=develop
# Set to 0 to turn the branch-name guard into warnings only (emergency use).
LS_ENFORCE_BRANCH_NAMES=1

# ── Toolchain ────────────────────────────────────────────────────────────────
# Node version the setup script installs; keep in step with .nvmrc.
LS_NODE_VERSION=24.20.0

# ── Quieter, reproducible npm output ─────────────────────────────────────────
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false
NPM_CONFIG_UPDATE_NOTIFIER=false

# ── Locale and time zone (UK English, SAST) ──────────────────────────────────
LANG=C.UTF-8
TZ=Africa/Johannesburg

# ── Shared environment identity (FR-024, FR-025) ──────────────────────────────
# LS_CLOUD_ENV marks a session as running in the shared LightSpeed environment.
# LS_CLOUD_ENV_REVISION is the revision of this definition: the first 12 hex
# characters of the SHA-256 of setup.sh followed by this file without the revision
# line. Any change to this file or to setup.sh must refresh it: run
# `bash .claude/cloud/revision.sh` and paste the result below. CI fails when it is
# stale (see .github/specs/018-claude-cloud-environment/contracts/cloud-environment.md).
LS_CLOUD_ENV=LightSpeed
LS_CLOUD_ENV_REVISION=6436a819b85f
