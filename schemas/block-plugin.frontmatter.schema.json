{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightspeedwp/.github/schemas/block-plugin.frontmatter.schema.json",
  "title": "WordPress Block Plugin Frontmatter Schema",
  "description": "Validates frontmatter metadata for WordPress block plugin documentation files.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document or block title",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "description": "Brief description of the document or block",
      "minLength": 10,
      "maxLength": 300
    },
    "block_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "WordPress block name in format namespace/block-name"
    },
    "block_supports": {
      "type": "array",
      "description": "List of block supports",
      "items": {
        "type": "string",
        "enum": [
          "align",
          "anchor",
          "color",
          "typography",
          "spacing",
          "customClassName",
          "html",
          "inserter",
          "multiple",
          "reusable",
          "lock"
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g. 1.0.0)"
    },
    "author": {
      "type": "string",
      "description": "Full name of author (no @ handles)",
      "minLength": 2
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation/update date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "active", "archived"],
      "description": "Document status"
    },
    "language": {
      "type": "string",
      "enum": ["en"],
      "description": "Language code (UK English only)"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "documentation",
        "guide",
        "tutorial",
        "reference",
        "troubleshooting",
        "examples"
      ],
      "description": "Document category"
    },
    "tags": {
      "type": "array",
      "description": "Tags for organisation and discoverability",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "maxItems": 10
    },
    "references": {
      "type": "object",
      "description": "Links to related resources",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "file_type": {
      "type": "string",
      "enum": ["documentation", "guide", "reference"],
      "description": "Type of file"
    },
    "plugin_name": {
      "type": "string",
      "description": "Human-readable plugin name"
    },
    "plugin_uri": {
      "type": "string",
      "format": "uri",
      "description": "Plugin URI"
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Plugin semantic version"
    },
    "requires_wordpress": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Minimum WordPress version (e.g. 6.4)"
    },
    "requires_php": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Minimum PHP version (e.g. 8.0)"
    },
    "license": {
      "type": "string",
      "enum": ["GPL-2.0+", "GPL-3.0+", "MIT", "Apache-2.0"],
      "description": "Software license"
    }
  },
  "required": ["title", "description", "status", "language"],
  "additionalProperties": false
}
