{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightspeedwp/.github/schemas/control-plane.frontmatter.schema.json",
  "title": "Control-Plane Frontmatter Schema",
  "description": "Validates frontmatter metadata for .github control-plane documentation, instructions, and governance files.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "description": "Brief description of purpose and audience",
      "minLength": 10,
      "maxLength": 300
    },
    "file_type": {
      "type": "string",
      "enum": [
        "instructions",
        "governance",
        "workflow",
        "script",
        "template",
        "guide",
        "reference",
        "report"
      ],
      "description": "Type of file"
    },
    "category": {
      "type": "string",
      "enum": [
        "organisation",
        "process",
        "automation",
        "templates",
        "governance",
        "standards",
        "branching",
        "labels",
        "issues",
        "prs",
        "agents",
        "skills",
        "plugins",
        "workflows"
      ],
      "description": "Document category"
    },
    "version": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Version number (e.g. v1.2 or 1.0.0)"
    },
    "author": {
      "type": "string",
      "description": "Original author or creating organisation",
      "minLength": 2
    },
    "maintainer": {
      "type": "string",
      "description": "Current maintainer (full name, no @ handles)",
      "minLength": 2
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation/update date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "active", "archived", "deprecated"],
      "description": "Document status"
    },
    "language": {
      "type": "string",
      "enum": ["en"],
      "description": "Language code (UK English only)"
    },
    "owners": {
      "type": "array",
      "description": "GitHub teams or users responsible for this file",
      "items": {
        "type": "string",
        "pattern": "^(@)?[a-z0-9-]+/[a-z0-9-]+$"
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags for organisation and discoverability",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "maxItems": 10
    },
    "related_issues": {
      "type": "array",
      "description": "Related GitHub issues (e.g. #1234)",
      "items": {
        "type": "string",
        "pattern": "^#\\d+$"
      }
    },
    "related_prs": {
      "type": "array",
      "description": "Related pull requests (e.g. #1234)",
      "items": {
        "type": "string",
        "pattern": "^#\\d+$"
      }
    },
    "permissions_required": {
      "type": "array",
      "description": "Permissions needed to use/apply this file",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "admin",
          "maintain",
          "github:repo",
          "github:org"
        ]
      }
    },
    "audience": {
      "type": "array",
      "description": "Intended audience for this document",
      "items": {
        "type": "string",
        "enum": [
          "contributors",
          "maintainers",
          "all",
          "agents",
          "automation",
          "team-leads",
          "security-team",
          "release-team"
        ]
      }
    },
    "references": {
      "type": "object",
      "description": "Links to related resources",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date",
      "description": "Date of last content review in YYYY-MM-DD format"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled next review date in YYYY-MM-DD format"
    },
    "deprecation_date": {
      "type": "string",
      "format": "date",
      "description": "Date when file was deprecated (if status=deprecated)"
    },
    "successor": {
      "type": "string",
      "description": "Path to successor file if this is archived/deprecated"
    }
  },
  "required": [
    "title",
    "description",
    "file_type",
    "category",
    "status",
    "language",
    "owners"
  ],
  "additionalProperties": false
}
