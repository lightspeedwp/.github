{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub Copilot Agent Profile Schema",
  "description": "Schema for GitHub Copilot custom agent definitions, extending LightSpeed standard frontmatter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name for the agent (defaults to filename without .md or .agent.md)"
    },
    "description": {
      "type": "string",
      "description": "Required: Clear description of agent's purpose and capabilities",
      "minLength": 10,
      "maxLength": 1000
    },
    "target": {
      "type": "string",
      "enum": ["vscode", "github-copilot"],
      "description": "Target environment (defaults to both if omitted)"
    },
    "tools": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "shell",
              "bash",
              "powershell",
              "read",
              "edit",
              "write",
              "search",
              "grep",
              "glob",
              "custom-agent",
              "task",
              "web",
              "websearch",
              "webfetch",
              "todo",
              "todowrite"
            ]
          },
          "description": "Array of tool aliases to enable"
        },
        {
          "type": "string",
          "enum": ["*"],
          "description": "Enable all available tools"
        }
      ],
      "description": "List of tools the agent can use. Omit for all tools, empty array to disable all"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Label for the handoff option"
          },
          "agent": {
            "type": "string",
            "description": "Name of the agent to hand off to"
          },
          "prompt": {
            "type": "string",
            "description": "Initial prompt for the next agent"
          },
          "send": {
            "type": "boolean",
            "description": "Whether to automatically send context to next agent"
          }
        },
        "required": ["label", "agent"],
        "additionalProperties": false
      },
      "description": "Handoff configurations for delegating to other agents"
    },
    "mcp-servers": {
      "type": "object",
      "description": "MCP server configurations (org/enterprise level only)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["local", "stdio"],
            "description": "Server type (local maps to stdio)"
          },
          "command": {
            "type": "string",
            "description": "Command to start the server"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Arguments for the command"
          },
          "tools": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tools to expose from this server"
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Environment variables for the server"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Custom metadata for annotation",
      "additionalProperties": {
        "type": "string"
      }
    },
    "file_type": {
      "type": "string",
      "enum": ["agent", "agent-js", "agent-py", "agent-sh"],
      "description": "LightSpeed: File type indicator"
    },
    "title": {
      "type": "string",
      "description": "LightSpeed: Human-readable title"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$",
      "description": "LightSpeed: Semantic version (e.g., v1.0.0)"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "LightSpeed: Date of last update (YYYY-MM-DD format)"
    },
    "owners": {
      "type": "array",
      "items": { "type": "string" },
      "description": "LightSpeed: Team/people responsible for this agent"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "LightSpeed: Tags for categorization"
    },
    "category": {
      "type": "string",
      "enum": [
        "automation",
        "documentation",
        "quality",
        "development",
        "testing",
        "deployment",
        "specialized"
      ],
      "description": "LightSpeed: Agent category"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "planning", "experimental", "archived"],
      "description": "LightSpeed: Agent status"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "internal", "private"],
      "description": "LightSpeed: Who can access this agent"
    },
    "deprecation_note": {
      "type": "string",
      "description": "LightSpeed: Note for deprecated agents"
    },
    "deprecation_date": {
      "type": "string",
      "format": "date",
      "description": "LightSpeed: Date agent was deprecated"
    },
    "migration_path": {
      "type": "string",
      "description": "LightSpeed: How to migrate from deprecated agent"
    },
    "deprecates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "LightSpeed: List of agents this agent replaces/consolidates"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to referenced file (relative to repo root)"
          },
          "description": {
            "type": "string",
            "description": "What this reference is for"
          }
        },
        "required": ["path", "description"],
        "additionalProperties": false
      },
      "description": "LightSpeed: References to related files (scripts, workflows, schemas)"
    }
  },
  "required": ["description"],
  "additionalProperties": false,
  "examples": [
    {
      "name": "labeling",
      "description": "Unified labeling system for issues and PRs",
      "target": "github-copilot",
      "tools": ["read", "edit", "search", "github/*"],
      "handoffs": [
        {
          "label": "After labeling complete",
          "agent": "reviewer",
          "prompt": "Review the labeled items",
          "send": false
        }
      ],
      "file_type": "agent",
      "version": "v2.0",
      "last_updated": "2025-11-20",
      "status": "active",
      "references": [
        {
          "path": ".github/agents/labeling.agent.js",
          "description": "Main agent implementation"
        },
        {
          "path": ".github/workflows/labeling.yml",
          "description": "Labeling workflow trigger"
        }
      ]
    },
    {
      "name": "branding",
      "description": "Unified header, footer, and badge automation",
      "target": "vscode",
      "tools": ["read", "edit", "shell"],
      "status": "active",
      "deprecates": ["badges.agent.md", "header-footer.agent.md"],
      "references": [
        {
          "path": ".github/agents/branding.agent.js",
          "description": "Main agent implementation"
        },
        {
          "path": "schemas/header-footer-agent/agent-config.schema.json",
          "description": "Branding configuration schema"
        }
      ]
    }
  ]
}
