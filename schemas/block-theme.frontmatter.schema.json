{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightspeedwp/.github/schemas/block-theme.frontmatter.schema.json",
  "title": "WordPress Block Theme Frontmatter Schema",
  "description": "Validates frontmatter metadata for WordPress block theme documentation files.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document or feature title",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "description": "Brief description of the document or feature",
      "minLength": 10,
      "maxLength": 300
    },
    "theme_name": {
      "type": "string",
      "description": "Human-readable theme name"
    },
    "theme_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Theme slug for wordpress.org"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g. 1.0.0)"
    },
    "author": {
      "type": "string",
      "description": "Full name of author (no @ handles)",
      "minLength": 2
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation/update date in YYYY-MM-DD format"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "active", "archived"],
      "description": "Document status"
    },
    "language": {
      "type": "string",
      "enum": ["en"],
      "description": "Language code (UK English only)"
    },
    "category": {
      "type": "string",
      "enum": [
        "theme",
        "documentation",
        "guide",
        "tutorial",
        "reference",
        "pattern",
        "template",
        "customisation",
        "troubleshooting"
      ],
      "description": "Document category"
    },
    "tags": {
      "type": "array",
      "description": "Tags for organisation and discoverability",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "maxItems": 10
    },
    "references": {
      "type": "object",
      "description": "Links to related resources",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "file_type": {
      "type": "string",
      "enum": ["documentation", "guide", "reference", "pattern"],
      "description": "Type of file"
    },
    "theme_uri": {
      "type": "string",
      "format": "uri",
      "description": "Theme URI"
    },
    "theme_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Theme semantic version"
    },
    "requires_wordpress": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Minimum WordPress version (e.g. 6.4)"
    },
    "requires_php": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Minimum PHP version (e.g. 8.0)"
    },
    "license": {
      "type": "string",
      "enum": ["GPL-2.0+", "GPL-3.0+", "MIT", "Apache-2.0"],
      "description": "Software license"
    },
    "block_pattern_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "Block pattern name in format namespace/pattern-name (if pattern doc)"
    },
    "supported_features": {
      "type": "array",
      "description": "Supported WordPress features",
      "items": {
        "type": "string",
        "enum": [
          "custom-logo",
          "custom-line-height",
          "custom-spacing",
          "responsive-embedded-content",
          "custom-units"
        ]
      }
    }
  },
  "required": ["title", "description", "status", "language"],
  "additionalProperties": false
}
