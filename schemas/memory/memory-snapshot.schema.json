{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeedwp.dev/schemas/memory/memory-snapshot.schema.json",
  "title": "Memory Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "asset_id",
    "asset_type",
    "profile_ref",
    "created_at",
    "run_context",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 3
    },
    "asset_id": {
      "type": "string",
      "minLength": 3
    },
    "asset_type": {
      "type": "string",
      "enum": ["agent", "skill"]
    },
    "profile_ref": {
      "type": "string",
      "minLength": 5
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "trigger", "actor"],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 3
        },
        "trigger": {
          "type": "string",
          "minLength": 3
        },
        "actor": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "memory-record.schema.json"
      }
    }
  }
}
