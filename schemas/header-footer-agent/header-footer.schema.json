{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Header & Footer Config Schema",
  "type": "object",
  "properties": {
    "headers": {
      "type": "object",
      "description": "Header variants by file type",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "footers": {
      "type": "object",
      "description": "Footer variants by category",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "required": ["headers", "footers"]
}