{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Footer Config Schema",
  "description": "Schema for defining sets of footer variants by category.",
  "type": "object",
  "properties": {
    "footers": {
      "type": "object",
      "description": "Footer variants by category.",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "minProperties": 1
    }
  },
  "required": ["footers"]
}