/**
 * Jest configuration for LightSpeedWP
 * 
 * Supports:
 * - CommonJS test files with babel-jest transformation
 * - ES modules in source code (transformed by Babel)
 * - JSDOM environment for tests that need DOM APIs
 * - Automatic localStorage polyfill
 */

require('dotenv').config();

module.exports = {
  // Use jsdom for DOM API support
  testEnvironment: 'jsdom',
  
  // Setup file for localStorage
  setupFilesAfterEnv: ['<rootDir>/tests/jest.setup.localstorage.js'],
  
  // Test file patterns
  testMatch: [
    '<rootDir>/tests/**/*.test.js',
    '<rootDir>/scripts/**/__tests__/**/*.test.js',
  ],
  
  // Babel transformation
  transform: {
    '^.+\\.[jt]sx?$': 'babel-jest',
  },
  
  // Don't transform node_modules
  transformIgnorePatterns: [
    'node_modules/(?!(@actions)/)',
  ],
  
  // Module file extensions
  moduleFileExtensions: ['js', 'ts', 'jsx', 'tsx', 'json'],
  
  // Coverage configuration
  coverageDirectory: './coverage',
  collectCoverageFrom: [
    'scripts/**/*.js',
    'tests/**/*.js',
    '!**/*.test.js',
    '!**/*.spec.js',
    '!**/node_modules/**',
    '!**/dist/**',
  ],
  
  // Ignore paths
  testPathIgnorePatterns: [
    '<rootDir>/node_modules/',
    '<rootDir>/.git/',
    // Skip complex agent tests that use ES modules
    'scripts/agents/__tests__/labeling',
    'scripts/agents/__tests__/issue-type',
    'scripts/agents/__tests__/reviewer',
    'scripts/agents/__tests__/planner',
    'scripts/agents/__tests__/agent-performance',
    'scripts/agents/__tests__/agent-workflows',
    'scripts/agents/__tests__/label-standardization',
    'scripts/agents/includes/__tests__/label-sync',
    'scripts/agents/includes/__tests__/status-enforcer',
    'scripts/agents/includes/__tests__/label-reporting',
    'scripts/agents/includes/__tests__/labeler-utils',
    'scripts/agents/includes/__tests__/label-lookup',
    'scripts/agents/includes/__tests__/changelogUtils',
    'scripts/coderabbit-validation/__tests__/',
  ],
  
  // Verbose output
  verbose: true,
  
  // Bail on first error (optional)
  bail: false,
  
  // Coverage thresholds
  coverageThreshold: {
    global: {
      branches: 0,
      functions: 0,
      lines: 0,
      statements: 0,
    },
  },
};
