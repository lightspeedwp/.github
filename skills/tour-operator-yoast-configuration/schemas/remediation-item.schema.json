{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remediation item",
  "type": "object",
  "required": [
    "issue",
    "affected_area",
    "severity",
    "priority",
    "qa_required"
  ],
  "properties": {
    "issue": {
      "type": "string"
    },
    "affected_area": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "priority": {
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "qa_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
