{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "Output Template",
  "type": "object",
  "required": [
    "name",
    "purpose",
    "required_fields",
    "template",
    "validation_notes"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
