{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms audit intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_url",
    "environment",
    "audit_type",
    "audience",
    "scope",
    "mcp_connection_status",
    "output_type_requested"
  ],
  "properties": {
    "site_url": {
      "type": "string",
      "format": "uri"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development",
        "local",
        "unknown"
      ]
    },
    "audit_type": {
      "type": "string",
      "enum": [
        "whole_site",
        "single_form",
        "pre_launch",
        "retainer_health_check",
        "troubleshooting",
        "accessibility",
        "spam_security_privacy",
        "notifications",
        "addons_feeds_integrations",
        "woocommerce_enquiry",
        "tour_operator_enquiry",
        "retest",
        "other"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "internal",
        "client_safe",
        "mixed"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "mcp_connection_status": {
      "type": "string",
      "enum": [
        "confirmed_readonly",
        "confirmed_mixed_permissions",
        "not_connected",
        "unknown"
      ]
    },
    "known_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_project_context": {
      "type": "string"
    },
    "output_type_requested": {
      "type": "string",
      "enum": [
        "internal_audit_report",
        "client_safe_summary",
        "findings_register",
        "readiness_scorecard",
        "configuration_handoff",
        "retest_report",
        "mixed"
      ]
    }
  }
}
