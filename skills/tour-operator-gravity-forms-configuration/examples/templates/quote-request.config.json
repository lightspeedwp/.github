{
  "form_name": "Quote Request Form",
  "purpose": "Qualify service or project quote requests.",
  "audience": "Prospective customers",
  "source_template": "Gravity Forms Request a Quote or Project Inquiry template",
  "fields": [
    {
      "label": "Name",
      "type": "name",
      "required": true
    },
    {
      "label": "Email",
      "type": "email",
      "required": true
    },
    {
      "label": "Phone",
      "type": "phone",
      "required": false
    },
    {
      "label": "Service interest",
      "type": "select",
      "required": true,
      "choices": [
        "Safari",
        "Guided tour",
        "Private guide",
        "Other"
      ]
    },
    {
      "label": "Budget range",
      "type": "select",
      "required": false,
      "choices": [
        "Under 1,000",
        "1,000-2,500",
        "2,500-5,000",
        "5,000+"
      ]
    },
    {
      "label": "Timeline",
      "type": "select",
      "required": false,
      "choices": [
        "Urgent",
        "This month",
        "1-3 months",
        "Flexible"
      ]
    },
    {
      "label": "Project brief",
      "type": "textarea",
      "required": true
    },
    {
      "label": "Private guideing file",
      "type": "fileupload",
      "required": false,
      "privacy_notes": "Restrict extensions and do not expose upload URLs to non-admins."
    },
    {
      "label": "Consent",
      "type": "consent",
      "required": true
    }
  ],
  "field_settings": {
    "file_upload": {
      "allowed_extensions": [
        "pdf",
        "doc",
        "docx",
        "jpg",
        "png"
      ],
      "max_file_size_mb": 10
    }
  },
  "conditional_logic": [
    {
      "if": "Service interest is Other",
      "show": "Other service details"
    }
  ],
  "confirmations": [
    {
      "name": "Default",
      "type": "text",
      "message": "Thanks. We have received your quote request and will review the details."
    }
  ],
  "notifications": [
    {
      "name": "Lead routing",
      "to": "sales@example.test",
      "from": "noreply@example.test",
      "reply_to": "{Email:2}",
      "conditions": "Route by service interest if team addresses are approved."
    }
  ],
  "feeds": [],
  "spam_settings": {
    "honeypot": true,
    "zero_spam": "recommend only if installed/approved"
  },
  "accessibility_settings": {
    "visible_labels": true,
    "file_upload_instructions": true
  },
  "embedding_target": {
    "page": "Request a Quote",
    "method": "gravity_forms_block"
  },
  "data_retention_notes": "Quote enquiries include personal data and optional uploads; define retention before launch. Consent record and wording must be reviewed for retention, export, and erase handling.",
  "test_data": {
    "Name": "Quote Tester",
    "Email": "quote@example.test",
    "Service interest": "Safari",
    "Project brief": "Test quote request",
    "Consent": true
  },
  "required_addons": [],
  "risks": [
    "File upload is high-risk and needs extension/size/access review."
  ],
  "approval_status": "draft"
}
