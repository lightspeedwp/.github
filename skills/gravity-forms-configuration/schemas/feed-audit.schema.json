{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms Feed Audit",
  "type": "object",
  "required": [
    "site_url",
    "environment",
    "forms",
    "feeds",
    "risks",
    "validation_plan",
    "confidence"
  ],
  "properties": {
    "site_url": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "form_id",
          "form_name"
        ],
        "properties": {
          "form_id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "form_name": {
            "type": "string"
          }
        }
      }
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "addon",
          "active",
          "risk_level"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "addon": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "conditional_logic": {
            "type": [
              "string",
              "object",
              "array",
              "null"
            ]
          },
          "field_mappings": {
            "type": [
              "object",
              "array"
            ]
          },
          "external_destination": {
            "type": [
              "string",
              "null"
            ]
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "validation_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "additionalProperties": true
}
