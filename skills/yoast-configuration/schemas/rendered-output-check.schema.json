{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoast rendered output check",
  "type": "object",
  "required": [
    "url",
    "environment",
    "evidence_state",
    "checks",
    "risk_level",
    "qa_required"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "live",
        "staging",
        "local",
        "unknown"
      ]
    },
    "evidence_state": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta_robots": {
          "type": [
            "string",
            "null"
          ]
        },
        "open_graph": {
          "type": [
            "string",
            "null"
          ]
        },
        "twitter_card": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_pieces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "http_robots_header": {
          "type": [
            "string",
            "null"
          ]
        },
        "sitemap_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "robots_txt_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "llms_txt_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "qa_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
