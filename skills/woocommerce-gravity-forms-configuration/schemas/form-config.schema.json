{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdev.biz/schemas/gravity-forms/form-config.schema.json",
  "title": "WooCommerce Gravity Forms Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_name",
    "purpose",
    "audience",
    "source_template",
    "fields",
    "field_settings",
    "conditional_logic",
    "confirmations",
    "notifications",
    "feeds",
    "spam_settings",
    "accessibility_settings",
    "embedding_target",
    "data_retention_notes",
    "test_data",
    "required_addons",
    "risks",
    "approval_status"
  ],
  "properties": {
    "form_name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "source_template": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "type",
          "required"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "choices": {
            "type": "array"
          },
          "conditional_logic": {
            "type": [
              "object",
              "null"
            ]
          },
          "accessibility_notes": {
            "type": "string"
          },
          "privacy_notes": {
            "type": "string"
          }
        }
      }
    },
    "field_settings": {
      "type": "object",
      "additionalProperties": true
    },
    "conditional_logic": {
      "type": [
        "array",
        "object",
        "null"
      ]
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "spam_settings": {
      "type": "object",
      "additionalProperties": true
    },
    "accessibility_settings": {
      "type": "object",
      "additionalProperties": true
    },
    "embedding_target": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "data_retention_notes": {
      "type": "string"
    },
    "test_data": {
      "type": "object",
      "additionalProperties": true
    },
    "required_addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs approval",
        "approved",
        "applied"
      ]
    }
  }
}
