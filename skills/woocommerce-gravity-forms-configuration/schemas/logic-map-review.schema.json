{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gravity Forms logic map review",
  "type": "object",
  "required": [
    "site_url",
    "form_id",
    "logic_areas",
    "dependencies",
    "risk_level",
    "approval_required",
    "validation_steps",
    "handoff_status"
  ],
  "properties": {
    "site_url": {"type": "string"},
    "form_id": {"type": ["string", "number"]},
    "form_name": {"type": "string"},
    "logic_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "summary", "risk"],
        "properties": {
          "area": {"type": "string"},
          "summary": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high", "critical", "unknown"]},
          "notes": {"type": "string"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["driver", "dependent_action", "test_case"],
        "properties": {
          "driver": {"type": "string"},
          "dependent_action": {"type": "string"},
          "test_case": {"type": "string"}
        }
      }
    },
    "risk_level": {"enum": ["low", "medium", "high", "critical", "unknown"]},
    "approval_required": {"type": "boolean"},
    "validation_steps": {"type": "array", "items": {"type": "string"}},
    "handoff_status": {"enum": ["ready", "partial", "blocked", "not_started"]}
  },
  "additionalProperties": true
}
