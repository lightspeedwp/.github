{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Results Review",
  "type": "object",
  "required": [
    "form",
    "result_type",
    "filters",
    "findings",
    "limitations",
    "privacy_notes",
    "approval_required_actions",
    "handoff_status"
  ],
  "properties": {
    "form": {
      "type": "string"
    },
    "result_type": {
      "type": "string",
      "enum": [
        "survey",
        "poll",
        "quiz",
        "assessment",
        "other"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_status": {
      "type": "string",
      "enum": [
        "ready",
        "partially_ready",
        "not_ready"
      ]
    }
  }
}
