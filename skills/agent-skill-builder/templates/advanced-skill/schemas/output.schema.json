{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "evidence",
    "decision",
    "next_actions"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
