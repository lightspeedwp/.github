{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill frontmatter",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1024
    }
  }
}
