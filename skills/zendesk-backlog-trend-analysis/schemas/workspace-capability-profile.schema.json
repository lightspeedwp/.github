{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zendesk-backlog-trend-analysis/workspace-capability-profile.schema.json",
  "title": "Workspace capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "environment_name",
    "zendesk_read_capabilities",
    "filter_capabilities",
    "visible_ticket_fields",
    "optional_data_visibility",
    "write_actions_allowed_by_default",
    "known_limitations",
    "last_reviewed"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "environment_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable shared agent or workspace environment name. Do not include personal login names."
    },
    "zendesk_read_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_tickets",
        "search_ticket_metadata",
        "read_ticket_details",
        "read_ticket_conversations",
        "search_help_centre",
        "read_help_centre_articles",
        "read_csat_or_satisfaction"
      ],
      "properties": {
        "count_tickets": { "type": "boolean" },
        "search_ticket_metadata": { "type": "boolean" },
        "read_ticket_details": { "type": "boolean" },
        "read_ticket_conversations": { "type": "boolean" },
        "search_help_centre": { "type": "boolean" },
        "read_help_centre_articles": { "type": "boolean" },
        "read_csat_or_satisfaction": { "type": "boolean" }
      }
    },
    "filter_capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": [
        "status",
        "created_date",
        "updated_date",
        "priority",
        "assignee",
        "group",
        "brand",
        "organisation",
        "tag",
        "form",
        "channel",
        "text",
        "custom_field"
      ],
      "properties": {
        "status": { "type": "boolean" },
        "created_date": { "type": "boolean" },
        "updated_date": { "type": "boolean" },
        "priority": { "type": "boolean" },
        "assignee": { "type": "boolean" },
        "group": { "type": "boolean" },
        "brand": { "type": "boolean" },
        "organisation": { "type": "boolean" },
        "tag": { "type": "boolean" },
        "form": { "type": "boolean" },
        "channel": { "type": "boolean" },
        "text": { "type": "boolean" },
        "custom_field": { "type": "boolean" }
      }
    },
    "visible_ticket_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "optional_data_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sla", "csat", "comment_count", "custom_fields"],
      "properties": {
        "sla": { "enum": ["visible", "not_visible", "uncertain"] },
        "csat": { "enum": ["visible", "not_visible", "uncertain"] },
        "comment_count": { "enum": ["visible", "not_visible", "uncertain"] },
        "custom_fields": { "enum": ["visible", "not_visible", "uncertain"] }
      }
    },
    "write_actions_allowed_by_default": {
      "type": "boolean",
      "const": false,
      "description": "This skill should remain read-only unless the user explicitly asks for a write action after the report."
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
