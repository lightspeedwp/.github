// Jest tests for {{slug}} block plugin date utilities

const { getCurrentYear, formatDateRange } = require('./date.js');

describe('{{slug}} date utilities', () => {
  it('returns the current year', () => {
    const year = getCurrentYear();
    expect(typeof year).toBe('number');
  });

  it('formats a date range correctly', () => {
    expect(formatDateRange(2022, 2025)).toBe('2022–2025');
    expect(formatDateRange(2022, 2022)).toBe('2022');
  });
});