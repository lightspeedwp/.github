// Playwright E2E test for {{slug}} block plugin

const { test, expect } = require('@playwright/test');

test.describe('{{slug}} block', () => {
  test('can be inserted in the block editor', async ({ page }) => {
    await page.goto('/wp-admin/post-new.php');
    await page.click('.block-editor-inserter__toggle');
    await page.fill('input[placeholder="Search"]', '{{projectName}}');
    await page.click(`button:has-text("{{projectName}}")`);
    await expect(page.locator('.wp-block-{{namespace}}-{{slug}}')).toBeVisible();
  });
});