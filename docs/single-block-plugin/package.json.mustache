{
  "name": "{{slug}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "author": "{{author}}",
  "license": "{{license}}",
  "keywords": [
    "repo-template",

    "agents",
    "instructions",
    "chatmodes",
    "prompts",
    "workflows"
    ],
  "main": "src/js/index.js",
  "homepage": "https://github.com/lightspeedwp/{{repo}}",
  "scripts": {
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:clean": "wp-env clean",
		"env:test": "wp-env run tests-cli --env-cwd=wp-content/plugins/copyright-date-block",
		"prepare": "husky",
		"build": "wp-scripts build --blocks-manifest",
		"start": "wp-scripts start --blocks-manifest",
		"packages-update": "wp-scripts packages-update",
		"update-version": "node bin/update-version.js"
		"plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
		"lint:php": "composer run-script phpcs",
		"lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run lint:php:fix",
		"lint:php:fix": "composer run-script phpcbf",
		"lint:md": "markdownlint-cli \"**/*.md\" --ignore node_modules --ignore vendor",
    "test": "jest",
    "test:e2e": "playwright test",
		"test": "npm-run-all test:*",
		"test:unit": "wp-scripts test-unit-js",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/copyright-date-block phpunit",
		"test:coverage": "wp-scripts test-unit-js --coverage",
  },
  "devDependencies": {
		"all-contributors-cli": "^6.26.1",
		"autoprefixer": "^10.4.16",
		"@babel/core": "^7.23.0",
		"@babel/preset-env": "^7.23.0",
		"@babel/preset-react": "^7.23.0",
		"@babel/preset-typescript": "^7.23.0",
		"babel-jest": "^29.7.0",
		"browserslist": "^4.22.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.3.1",
		"eslint": "^8.57.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.7.0",
		"playwright": "^1.56.0",
    "@playwright/test": "^1.40.0",
		"@testing-library/jest-dom": "^6.1.4",
		"@testing-library/react": "^14.0.0",
		"babel-jest": "^29.7.0",
		"lint-staged": "^15.0.0",
		"markdownlint-cli": "^0.37.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.31",
		"prettier": "^3.1.0",
		"stylelint": "^15.11.0",
		"ts-jest": "^29.1.1",
		"ts-loader": "^9.5.0",
		"typescript": "^5.2.2",
		"@tsconfig/recommended": "^1.0.3",
		"@wordpress/a11y": "^3.46.0",
		"@wordpress/babel-preset-default": "^7.32.0",
		"@wordpress/block-editor": "^12.14.0",
		"@wordpress/blocks": "^12.23.0",
		"@wordpress/browserslist-config": "^5.28.0",
		"@wordpress/components": "^25.13.0",
		"@wordpress/data": "^9.17.0",
		"@wordpress/date": "^4.47.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^4.27.0",
		"@wordpress/e2e-test-utils-playwright": "^0.16.0",
		"@wordpress/element": "^5.24.0",
		"@wordpress/env": "^8.10.0",
		"@wordpress/eslint-plugin": "^17.3.0",
		"@wordpress/i18n": "^4.47.0",
		"@wordpress/jest-console": "^6.28.0",
		"@wordpress/jest-preset-default": "^11.28.0",
		"@wordpress/postcss-plugins-preset": "^4.28.0",
		"@wordpress/postcss-themes": "^5.28.0",
		"@wordpress/prettier-config": "^2.25.0",
		"@wordpress/stylelint-config": "^21.28.0",
    "@wordpress/scripts": "^26.0.0",
		"webpack": "^5.88.0",
		"webpack-cli": "^5.1.4",
		"yamllint": "^1.0.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"wp-scripts lint-js --fix"
		],
		"*.{css,scss,pcss}": [
			"wp-scripts lint-style --fix"
		]

  }
}
