{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mustache Placeholder Mapping Config",
  "type": "object",
  "properties": {
    "slug": { "type": "string", "description": "Plugin/block slug" },
    "namespace": { "type": "string", "description": "Block namespace" },
    "author": { "type": "string", "description": "Plugin author" },
    "version": { "type": "string", "description": "Plugin version" },
    "description": { "type": "string", "description": "Plugin/block description" },
    "license": { "type": "string", "description": "License identifier" },
    "textdomain": { "type": "string", "description": "Text domain" },
    "projectName": { "type": "string", "description": "Human-readable block/plugin name" }
  },
  "required": ["slug", "namespace", "author", "version", "description", "license", "textdomain", "projectName"]
}