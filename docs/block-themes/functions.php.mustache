<?php
/**
 * {{theme_name}} functions and definitions
 *
 * @link https://developer.wordpress.org/themes/basics/theme-functions/
 *
 * @package {{theme_namespace}}
 * @since {{version}}
 */

// Prevent direct access.
if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

// Theme constants.
define( '{{theme_namespace}}_VERSION', '{{version}}' );
define( '{{theme_namespace}}_DIR', get_template_directory() );
define( '{{theme_namespace}}_URI', get_template_directory_uri() );

// Theme setup and support features.
function {{theme_slug}}_setup() {
	add_theme_support( 'automatic-feed-links' );
	add_theme_support( 'title-tag' );
	add_theme_support( 'post-thumbnails' );
	add_theme_support( 'custom-logo', [ 'height'=>250, 'width'=>250, 'flex-width'=>true, 'flex-height'=>true ] );
	add_theme_support( 'responsive-embeds' );
	add_theme_support( 'experimental-link-color' );
	add_theme_support( 'custom-line-height' );
	add_theme_support( 'custom-spacing' );
	add_theme_support( 'custom-units' );
	remove_theme_support( 'core-block-patterns' );
}
add_action( 'after_setup_theme', '{{theme_slug}}_setup' );

// Enqueue theme styles/scripts.
function {{theme_slug}}_scripts() {
	wp_enqueue_style( '{{theme_slug}}-style', get_stylesheet_uri(), [], {{theme_namespace}}_VERSION );
	if ( is_singular() && comments_open() && get_option( 'thread_comments' ) ) {
		wp_enqueue_script( 'comment-reply' );
	}
}
add_action( 'wp_enqueue_scripts', '{{theme_slug}}_scripts' );

// Editor styles.
function {{theme_slug}}_editor_styles() {
	add_editor_style( 'style.css' );
}
add_action( 'admin_init', '{{theme_slug}}_editor_styles' );

// Register block styles.
function {{theme_slug}}_register_block_styles() {
	register_block_style( 'core/group', [ 'name' => 'border', 'label' => __( 'Border', '{{textdomain}}' ) ] );
	register_block_style( 'core/heading', [ 'name' => 'underline', 'label' => __( 'Underline', '{{textdomain}}' ) ] );
}
add_action( 'init', '{{theme_slug}}_register_block_styles' );

// Register block pattern categories.
function {{theme_slug}}_register_pattern_categories() {
	register_block_pattern_category(
		'{{slug}}',
		[
			'label'       => __( '{{theme_name}}', '{{textdomain}}' ),
			'description' => __( 'Patterns for {{theme_name}}.', '{{textdomain}}' ),
		]
	);
}
add_action( 'init', '{{theme_slug}}_register_pattern_categories' );

// Add custom image sizes.
function {{theme_slug}}_add_image_sizes() {
	add_image_size( '{{slug}}-featured', 1200, 630, true );
	add_image_size( '{{slug}}-thumbnail', 300, 300, true );
}
add_action( 'after_setup_theme', '{{theme_slug}}_add_image_sizes' );

// Add custom body classes.
function {{theme_slug}}_body_classes( $classes ) {
	if ( ! is_singular() ) {
		$classes[] = 'hfeed';
	}
	$classes[] = 'no-js';
	return $classes;
}
add_filter( 'body_class', '{{theme_slug}}_body_classes' );

// JS detection.
function {{theme_slug}}_javascript_detection() {
	echo "<script>(function(html){html.className = html.className.replace(/\bno-js\b/,'js')})(document.documentElement);</script>\n";
}
add_action( 'wp_head', '{{theme_slug}}_javascript_detection', 0 );

// Pingback header.
function {{theme_slug}}_pingback_header() {
	if ( is_singular() && pings_open() ) {
		printf( '<link rel="pingback" href="%s">', esc_url( get_bloginfo( 'pingback_url' ) ) );
	}
}
add_action( 'wp_head', '{{theme_slug}}_pingback_header' );

// Include theme includes.
if ( file_exists( {{theme_namespace}}_DIR . '/inc/customizer.php' ) ) {
	require_once {{theme_namespace}}_DIR . '/inc/customizer.php';
}
if ( file_exists( {{theme_namespace}}_DIR . '/inc/block-patterns.php' ) ) {
	require_once {{theme_namespace}}_DIR . '/inc/block-patterns.php';
}
if ( file_exists( {{theme_namespace}}_DIR . '/inc/block-styles.php' ) ) {
	require_once {{theme_namespace}}_DIR . '/inc/block-styles.php';
}