{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "markdownlint.run": "onSave",
  "yaml.validate": true,
  "json.validate.enable": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/coverage": true,
    "**/.git": true
  }
}
