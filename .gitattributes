# Auto detect text files and ensure proper line endings
* text=auto

# Force LF (Unix) line endings for all common text-based files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The changelog is append-only and almost every pull request adds an entry to
# the same short `[Unreleased]` list, so two open pull requests edit the same
# lines. A plain merge then conflicts, and the losing pull request has to have
# `develop` merged in by hand before it can pass the required status checks.
#
# `union` resolves that automatically by keeping both sides' additions, which
# is the correct merge for a file nobody edits in place. A genuine duplicate is
# still caught: the changelog validator's CHK_UNIQUE_CONTENT rule flags entries
# more than 90% similar, and
# `scripts/validation/__tests__/changelog-merge-strategy.test.js` fails if this
# line is removed or changed.
CHANGELOG.md merge=union

# Treat images and fonts as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary