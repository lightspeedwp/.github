---
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";
import WapuuHero from "../../components/WapuuHero.astro";
import { RECIPES, liveRecipes } from "../../lib/cookbook-data";

const base = import.meta.env.BASE_URL;
const siteBase = base.endsWith("/") ? base : `${base}/`;
const live = liveRecipes();
const comingSoon = RECIPES.filter((recipe) => recipe.comingSoon);
---

<AwesomeGithubLayout
  title="Cookbook — Awesome GitHub"
  description="Battle-tested playbooks, workflows, and checklists for planning, delivery, and plugin shipping."
>
  <section class="cookbook-hero section">
    <div class="wrap">
      <div class="page-hero-inner cookbook-hero-inner">
        <div class="page-hero-text">
          <span class="eyebrow">Cookbook</span>
          <h1 class="page-h1">Follow a recipe</h1>
          <p class="page-lead">
            Battle-tested playbooks, workflows, and checklists for planning, delivery,
            and plugin shipping. Read one end to end, then copy the pattern into your own work.
          </p>
          <p class="cookbook-meta">
            {live.length} live recipes · {comingSoon.length} coming soon
          </p>
        </div>
        <WapuuHero page="cookbook" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cookbook-grid" aria-label="Cookbook recipes">
        {live.map((recipe) => (
          <a class="recipe-card" href={`${siteBase}cookbook/${recipe.id}/`}>
            <div class="recipe-card-head">
              <span class={`recipe-kind rk-${recipe.kind}`}>{recipe.kind}</span>
              <span class="recipe-duration">{recipe.duration}</span>
            </div>
            <h2 class="recipe-title">{recipe.title}</h2>
            <p class="recipe-blurb">{recipe.blurb}</p>
            <span class="recipe-go">Read recipe →</span>
          </a>
        ))}

        {comingSoon.map((recipe) => (
          <article class="recipe-card recipe-soon" aria-label={`${recipe.title} coming soon`}>
            <img
              src={`${base}assets/wapuus/wapuu-rocket.svg`}
              alt=""
              aria-hidden="true"
              class="recipe-soon-wapuu"
            />
            <div class="recipe-soon-text">
              <div class="recipe-card-head">
                <span class={`recipe-kind rk-${recipe.kind}`}>{recipe.kind}</span>
                <span class="recipe-duration">{recipe.duration}</span>
              </div>
              <h2 class="recipe-title">{recipe.title}</h2>
              <p class="recipe-blurb">{recipe.blurb}</p>
              <span class="recipe-coming">Coming soon</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .cookbook-hero {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 8%, var(--bg)) 0%,
      var(--panel-2) 100%
    );
    border-bottom: 1px solid var(--hair);
  }

  .cookbook-hero-inner {
    align-items: center;
  }

  .cookbook-meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-3);
  }

  .cookbook-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: clamp(14px, 1.6vw, 22px);
  }

  .recipe-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(18px, 2vw, 24px);
    background: var(--bg);
    border: 1px solid var(--hair);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .recipe-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .recipe-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .recipe-duration {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-3);
  }

  .recipe-title {
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.2;
  }

  .recipe-blurb {
    margin: 0;
    color: var(--fg-2);
    line-height: 1.6;
    font-size: 14px;
  }

  .recipe-go,
  .recipe-coming {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .recipe-kind {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: none;
  }

  .rk-planning {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .rk-delivery {
    color: var(--c-brand-green-700);
    background: color-mix(in srgb, var(--c-brand-green-700) 14%, transparent);
    border-color: color-mix(in srgb, var(--c-brand-green-700) 24%, transparent);
  }

  .rk-plugin {
    color: var(--c-cta-violet-500);
    background: color-mix(in srgb, var(--c-cta-violet-500) 12%, transparent);
    border-color: color-mix(in srgb, var(--c-cta-violet-500) 22%, transparent);
  }

  .rk-workflow {
    color: var(--c-status-warning);
    background: color-mix(in srgb, var(--c-status-warning) 13%, transparent);
    border-color: color-mix(in srgb, var(--c-status-warning) 22%, transparent);
  }

  .recipe-soon {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    background: var(--panel-2);
    border-style: dashed;
    cursor: default;
  }

  .recipe-soon:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--hair);
  }

  .recipe-soon-wapuu {
    width: auto;
    height: 74px;
    flex: none;
    opacity: 0.9;
  }

  .recipe-soon-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 560px) {
    .cookbook-grid {
      grid-template-columns: 1fr;
    }

    .recipe-soon {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
