    <div class="hero-actions">
      <a class="button secondary" href="/">Return to home</a>
    </div>
  </section>

  <section class="section">
    <div class="page-copy">
      <p><strong>Phase 2c (coming soon):</strong> This section will provide comprehensive learning resources and onboarding guides.</p>
    </div>
  </section>
</BaseLayout>
