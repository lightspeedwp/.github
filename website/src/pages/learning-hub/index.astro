---
import AwesomeGithubLayout from "../../layouts/AwesomeGithubLayout.astro";

const base = import.meta.env.BASE_URL;

const tracks = [
  {
    number: 1,
    name: "Goal-oriented",
    description: "Start here. How the control plane is put together and how change flows to stable.",
    icon: "⚙️",
    progress: { completed: 1, total: 2 },
    lessons: [
      {
        number: 1,
        title: "Architecture Guide",
        description: "How the .github repo is layered — GitHub-native portable assets, and how data flows through it.",
        readTime: "3 m",
        completed: true,
      },
      {
        number: 2,
        title: "Branching",
        description: "How main and develop relate, how branches are named, and how a change reaches stable.",
        readTime: "7 m",
        completed: false,
      },
    ],
  },
  {
    number: 2,
    name: "Governance & labelling",
    description: "The taxonomy and automation that keep work legible across every repository.",
    icon: "🛡️",
    progress: { completed: 0, total: 3 },
    lessons: [
      {
        number: 1,
        title: "Labeling Strategy & Governance",
        description: "The canonical label families, the one-no rule, and how labelling drives automation.",
        readTime: "9 m",
        completed: false,
      },
      {
        number: 2,
        title: "Issue Types Reference Guide",
        description: "The issue-type taxonomy and how 52 types map to a handful of project fields.",
        readTime: "18 m",
        completed: false,
      },
      {
        number: 3,
        title: "Automation & Workflows",
        description: "Which workflows run on which branch, the agents behind them, and the configs they read.",
        readTime: "6 m",
        completed: false,
      },
    ],
  },
  {
    number: 3,
    name: "Quality & release",
    description: "The gates a change passes through — linting, testing, and the ritual of shipping it.",
    icon: "✓",
    progress: { completed: 1, total: 3 },
    lessons: [
      {
        number: 1,
        title: "Linting Strategy & Implementation Guide",
        description: "The linting strategy across PHP JS, YAML, and Markdown, and how it's enforced.",
        readTime: "9 m",
        completed: true,
      },
      {
        number: 2,
        title: "Testing Guide",
        description: "The testing approach, coverage expectations, and the CI gates that protect main.",
        readTime: "4 m",
        completed: false,
      },
      {
        number: 3,
        title: "Release Process",
        description: "The end-to-release ritual — changelogging, versioning, tagging, and release notes.",
        readTime: "4 m",
        completed: false,
      },
    ],
  },
  {
    number: 4,
    name: "Working with agents",
    description: "How the planner and reviewer agents are built, configured, and run in practice.",
    icon: "🤖",
    progress: { completed: 0, total: 2 },
    lessons: [
      {
        number: 1,
        title: "Agent Architecture",
        description: "The module system, inter-faces, and logging shared by the planner and reviewer agents.",
        readTime: "7 m",
        completed: false,
      },
      {
        number: 2,
        title: "Reviewer Agent Runbook",
        description: "Deploying, configuring, and troubleshooting the Reviewer agent — env vars and all.",
        readTime: "7 m",
        completed: false,
      },
    ],
  },
];
---

<AwesomeGithubLayout
  title="Learning Centre — Awesome GitHub"
  description="Learn the control plane, at your own pace."
>
  <section class="ag-hero">
    <div class="ag-container">
      <div class="ag-section-label">LEARNING CENTRE</div>
      <h1 class="ag-h1">
        <span class="ag-hero-line-1">Learn the control plane,</span>
        <span class="ag-hero-line-2">at your own pace.</span>
      </h1>
      <p class="ag-lead">
        Short, self-paced tracks built from the real governance docs. Read straight through, or dip into the lesson you need. We keep your place as you go.
      </p>
      <div class="ag-progress-bar">
        <div class="ag-progress-fill" style="width: 20%"></div>
      </div>
      <div class="ag-progress-text">2 of 18 lessons read</div>
    </div>
  </section>

  <section class="ag-tracks-section">
    <div class="ag-container">
      <div class="ag-tracks-grid">
        {tracks.map((track) => (
          <div class="ag-track-card">
            <div class="ag-track-header">
              <div class="ag-track-icon">{track.icon}</div>
              <div class="ag-track-meta">
                <div class="ag-track-number">TRACK {track.number}</div>
                <h2 class="ag-track-name">{track.name}</h2>
                <p class="ag-track-description">{track.description}</p>
              </div>
              <div class="ag-track-progress">
                {track.progress.completed}/{track.progress.total}
              </div>
            </div>

            <div class="ag-lessons-list">
              {track.lessons.map((lesson) => (
                <div class="ag-lesson-item">
                  <div class="ag-lesson-number">{lesson.number}</div>
                  <div class="ag-lesson-content">
                    <h3 class="ag-lesson-title">{lesson.title}</h3>
                    <p class="ag-lesson-description">{lesson.description}</p>
                  </div>
                  <div class="ag-lesson-meta">
                    {lesson.completed && <span class="ag-lesson-checkmark">✓</span>}
                    <span class="ag-lesson-time">{lesson.readTime}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .ag-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .ag-hero {
    background: linear-gradient(135deg, #0F1014 0%, #181820 100%);
    color: var(--c-white);
    padding: var(--space-40) var(--gutter);
  }

  .ag-section-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--c-light-blue);
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    background: rgba(123, 231, 255, 0.1);
    border: 1px solid rgba(123, 231, 255, 0.3);
    border-radius: var(--radius-pill);
  }

  .ag-h1 {
    font-size: var(--fs-h1);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-6) 0;
  }

  .ag-hero-line-1 {
    display: block;
    color: var(--c-white);
  }

  .ag-hero-line-2 {
    display: block;
    color: var(--c-light-blue);
  }

  .ag-lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--c-slate-300);
    margin: 0 0 var(--space-8) 0;
    max-width: 60ch;
  }

  .ag-progress-bar {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .ag-progress-fill {
    height: 100%;
    background: var(--c-light-blue);
    transition: width 0.3s ease-out;
  }

  .ag-progress-text {
    font-size: var(--fs-body-sm);
    color: var(--c-slate-300);
  }

  .ag-tracks-section {
    padding: var(--space-40) var(--gutter);
    background: var(--bg);
  }

  .ag-tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .ag-track-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    background: var(--bg);
    transition: all 0.2s ease-out;
  }

  .ag-track-card:hover {
    border-color: var(--c-light-blue);
    box-shadow: 0 4px 12px rgba(123, 231, 255, 0.1);
  }

  .ag-track-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .ag-track-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .ag-track-meta {
    flex: 1;
  }

  .ag-track-number {
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--fg-2);
    margin-bottom: var(--space-2);
  }

  .ag-track-name {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }

  .ag-track-description {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .ag-track-progress {
    font-size: var(--fs-h3);
    font-weight: var(--weight-bold);
    color: var(--c-light-blue);
    text-align: right;
    flex-shrink: 0;
  }

  .ag-lessons-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ag-lesson-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--bg-alt);
    align-items: flex-start;
  }

  .ag-lesson-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(123, 231, 255, 0.15);
    color: var(--c-light-blue);
    font-weight: var(--weight-bold);
    font-size: var(--fs-body-sm);
    flex-shrink: 0;
  }

  .ag-lesson-content {
    flex: 1;
  }

  .ag-lesson-title {
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }

  .ag-lesson-description {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .ag-lesson-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    flex-shrink: 0;
  }

  .ag-lesson-checkmark {
    color: var(--c-status-success-2);
    font-weight: var(--weight-bold);
  }

  .ag-lesson-time {
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .ag-hero {
      padding: var(--space-20) var(--gutter);
    }

    .ag-h1 {
      font-size: var(--fs-h2);
    }

    .ag-tracks-grid {
      grid-template-columns: 1fr;
    }

    .ag-track-header {
      flex-direction: column;
    }

    .ag-track-progress {
      text-align: left;
    }

    .ag-lesson-item {
      flex-direction: column;
    }

    .ag-lesson-meta {
      flex-direction: row;
      width: 100%;
    }
  }
</style>
