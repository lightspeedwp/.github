---
import AwesomeGithubLayout from "../../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../../components/AwesomeGithub/AwesomeGithubButton.astro";
import { allLessons, adjacentLessons, lessonById, renderMarkdown } from "../../../lib/learn";

const base = import.meta.env.BASE_URL;
const { track: trackId, lesson: lessonSlug } = Astro.params;

export async function getStaticPaths() {
  return allLessons().map((lesson) => {
    const [track, slug] = lesson.id.split("/");
    return {
      params: { track, lesson: slug },
    };
  });
}

const found = lessonById(`${trackId!}/${lessonSlug!}`);
if (!found) {
  return Astro.redirect(`${base}learn/`);
}

const { lesson, track } = found;
const { prev, next } = adjacentLessons(lesson.id);
const toc = [...lesson.body.matchAll(/^##\s+(.+)$/gm)].map((match, index) => ({
  id: `h-${index}`,
  text: match[1],
}));
const lessonHtml = renderMarkdown(lesson.body);
---

<AwesomeGithubLayout
  title={`${lesson.title} — Learn — Awesome GitHub`}
  description={lesson.learn}
>
  <nav class="lesson-crumb" aria-label="Breadcrumb">
    <div class="lesson-container lesson-container--wide">
      <a href={`${base}`}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}learn/`}>Learn</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}learn/${track.id}/`}>{track.label}</a>
      <span aria-hidden="true">/</span>
      <span>{lesson.title}</span>
    </div>
  </nav>

  <header class="lesson-hero">
    <div class="lesson-container">
      <div class="lesson-track-badge">{track.label} · Lesson {track.lessons.findIndex((item) => item.id === lesson.id) + 1} of {track.lessons.length}</div>
      <h1 class="lesson-h1">{lesson.title}</h1>
      <p class="lesson-objective">
        <strong>What you’ll learn:</strong> {lesson.learn}
      </p>
      <p class="lesson-source">
        <span>Source:</span>
        <code>{lesson.src}</code>
      </p>
    </div>
  </header>

  <section class="lesson-body">
    <div class="lesson-container">
      <div class="lesson-layout">
        <article class="lesson-article">
          <div class="lesson-progress">
            <div class="lesson-progress-track" aria-hidden="true">
              <div class="lesson-progress-fill" id="lesson-progress-fill" style="width: 0%"></div>
            </div>
            <div class="lesson-progress-meta" id="lesson-progress-meta">Unread</div>
          </div>

          <div class="md lesson-markdown" id="lesson-content" set:html={lessonHtml}></div>

          <div class="lesson-footer">
            <button class="btn-primary" id="mark-complete" type="button">
              Mark as complete
            </button>

            <nav class="lesson-nav" aria-label="Lesson navigation">
              {prev && (
                <a class="lesson-nav-link lesson-nav-link--prev" href={`${base}learn/${track.id}/${prev.slug}/`}>
                  <span class="lesson-nav-label">Previous</span>
                  <span class="lesson-nav-title">{prev.title}</span>
                </a>
              )}

              {next && (
                <a class="lesson-nav-link lesson-nav-link--next" href={`${base}learn/${track.id}/${next.slug}/`}>
                  <span class="lesson-nav-label">Next</span>
                  <span class="lesson-nav-title">{next.title}</span>
                </a>
              )}
            </nav>
          </div>
        </article>

        {toc.length > 0 && (
          <aside class="lesson-toc" aria-label="Table of contents">
            <p class="lesson-toc-head">Contents</p>
            <ul class="lesson-toc-list">
              {toc.map((item) => (
                <li>
                  <a class="lesson-toc-link" href={`#${item.id}`} data-toc-link={item.id}>
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<script define:vars={{ lessonId: lesson.id }}>
  import {
    READ_TICK,
    UNREAD_TICK,
    loadReadIds,
    persistReadIds,
  } from "../../../scripts/learn-progress";

  function setCompleted(isRead) {
    const progressFill = document.getElementById("lesson-progress-fill");
    const progressMeta = document.getElementById("lesson-progress-meta");
    const button = document.getElementById("mark-complete");

    if (progressFill) {
      progressFill.style.width = isRead ? "100%" : "0%";
    }

    if (progressMeta) {
      progressMeta.textContent = isRead ? "Completed" : "Unread";
    }

    if (button) {
      button.textContent = isRead ? "Completed" : "Mark as complete";
      button.toggleAttribute("disabled", isRead);
    }
  }

  function syncToc() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    const headings = links
      .map((link) => document.getElementById(link.getAttribute("data-toc-link") || ""))
      .filter(Boolean);

    if (!links.length || !headings.length || !("IntersectionObserver" in window)) {
      return;
    }

    const setActive = (id) => {
      links.forEach((link) => {
        link.classList.toggle("is-active", link.getAttribute("data-toc-link") === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (visible?.target.id) {
          setActive(visible.target.id);
        }
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0.05 },
    );

    headings.forEach((heading) => observer.observe(heading));
    if (headings[0]?.id) setActive(headings[0].id);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const readIds = loadReadIds();
    setCompleted(readIds.has(lessonId));

    const tick = document.querySelector(`[data-lesson-id="${lessonId}"]`);
    if (tick) {
      tick.innerHTML = readIds.has(lessonId) ? READ_TICK : UNREAD_TICK;
    }

    const button = document.getElementById("mark-complete");
    if (button) {
      button.addEventListener("click", () => {
        const nextState = loadReadIds();
        nextState.add(lessonId);
        persistReadIds(nextState);
        setCompleted(true);

        const tickEl = document.querySelector(`[data-lesson-id="${lessonId}"]`);
        if (tickEl) {
          tickEl.innerHTML = READ_TICK;
        }

        window.dispatchEvent(new Event("storage"));
      });
    }

    syncToc();
  });
</script>

<style>
  .lesson-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .lesson-container--wide {
    max-width: var(--container-max);
  }

  .lesson-crumb {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    padding: var(--space-3) var(--gutter);
    font-size: var(--fs-body-sm);
  }

  .lesson-crumb div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .lesson-crumb a {
    color: var(--fg-link);
    text-decoration: none;
  }

  .lesson-crumb a:hover {
    color: var(--fg-link-hover);
  }

  .lesson-crumb span:not([aria-hidden]) {
    color: var(--fg-2);
  }

  .lesson-crumb [aria-hidden] {
    color: var(--fg-3);
  }

  .lesson-hero {
    background: var(--bg);
    color: var(--fg-1);
    padding: var(--space-24) var(--gutter);
  }

  .lesson-track-badge {
    display: inline-flex;
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .lesson-h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-h2);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-heading);
    color: var(--fg-1);
  }

  .lesson-objective {
    margin: 0 0 var(--space-3);
    max-width: 64ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-loose);
    color: var(--c-slate-300);
  }

  .lesson-objective strong {
    color: var(--c-slate-200);
  }

  .lesson-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--c-slate-300);
    font-size: var(--fs-body-sm);
  }

  .lesson-source code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--c-light-blue);
  }

  .lesson-body {
    padding: var(--space-24) var(--gutter);
    background: var(--bg);
  }

  .lesson-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: var(--space-10);
    align-items: start;
  }

  .lesson-article {
    min-width: 0;
  }

  .lesson-progress {
    margin-bottom: var(--space-8);
  }

  .lesson-progress-track {
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--panel-2);
    border: 1px solid var(--hair);
  }

  .lesson-progress-fill {
    width: 0%;
    height: 100%;
    background: var(--accent);
    transition: width var(--dur) var(--ease-out);
  }

  .lesson-progress-meta {
    margin-top: var(--space-3);
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .lesson-markdown {
    max-width: 760px;
  }

  .lesson-markdown :global(h2) {
    scroll-margin-top: calc(var(--nav-h) + var(--space-6));
  }

  .lesson-markdown :global(h2:not(:first-child)) {
    margin-top: 2.2em;
  }

  .lesson-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .lesson-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .lesson-nav-link {
    flex: 1 1 180px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-alt);
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .lesson-nav-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .lesson-nav-link--next {
    text-align: right;
  }

  .lesson-nav-label {
    color: var(--accent);
    font-size: var(--fs-body-sm);
    font-weight: var(--weight-semibold);
  }

  .lesson-nav-title {
    color: var(--fg-2);
    font-size: var(--fs-body-sm);
  }

  .lesson-toc {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-6));
    max-height: calc(100vh - var(--nav-h) - 96px);
    overflow: auto;
  }

  .lesson-toc-head {
    margin: 0 0 var(--space-3);
    color: var(--fg-3);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .lesson-toc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson-toc-link {
    display: block;
    padding: var(--space-2) 0 var(--space-2) var(--space-3);
    border-left: 2px solid var(--hair);
    color: var(--fg-3);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.4;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .lesson-toc-link:hover,
  .lesson-toc-link.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 1000px) {
    .lesson-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .lesson-toc {
      display: none;
    }
  }
</style>
