---
import AwesomeGithubLayout from "../../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../../components/AwesomeGithub/AwesomeGithubButton.astro";
import { LEARN_TRACKS, getTrack } from "../../../lib/learn";

const base = import.meta.env.BASE_URL;
const { track: trackId } = Astro.params;

export async function getStaticPaths() {
  return LEARN_TRACKS.map((t) => ({ params: { track: t.id } }));
}

const track = getTrack(trackId!);
if (!track) return Astro.redirect(`${base}learn/`);

const trackIcons: Record<string, string> = {
  oriented: "🗺️",
  governance: "🛡️",
  quality: "✅",
  agents: "🤖",
};
---

<AwesomeGithubLayout
  title={`${track.label} — Learning Centre — Awesome GitHub`}
  description={track.blurb}
>
  <nav class="track-breadcrumb" aria-label="Breadcrumb">
    <div class="track-container">
      <a href={`${base}`}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}learn/`}>Learn</a>
      <span aria-hidden="true">/</span>
      <span>{track.label}</span>
    </div>
  </nav>

  <header class="track-hero">
    <div class="track-container">
      <div class="track-icon" aria-hidden="true">{trackIcons[track.id] || "📘"}</div>
      <div class="track-eyebrow">Learning track</div>
      <h1 class="track-h1">{track.label}</h1>
      <p class="track-blurb">{track.blurb}</p>
      <div class="track-meta">
        <span>{track.lessons.length} lesson{track.lessons.length !== 1 ? "s" : ""}</span>
        <span aria-hidden="true">·</span>
        <span>{track.further.length} further reading{track.further.length !== 1 ? "s" : ""}</span>
        <span aria-hidden="true" id="track-progress-sep" style="display:none">·</span>
        <span id="track-progress-display" class="track-progress-badge" aria-live="polite"></span>
      </div>
    </div>
  </header>

  <section class="track-lessons">
    <div class="track-container">
      <h2 class="track-section-title">Lessons</h2>
      <ol class="track-lessons-list" aria-label="Track lessons">
        {track.lessons.map((lesson, i) => (
          <li class="track-lesson-item" data-lesson-slug={lesson.slug}>
            <a href={`${base}learn/${track.id}/${lesson.slug}/`} class="track-lesson-link">
              <div class="track-lesson-number">{i + 1}</div>
              <div class="track-lesson-body">
                <h3 class="track-lesson-title">{lesson.slug.replace(/-/g, " ")}</h3>
                <p class="track-lesson-learn">{lesson.learn}</p>
                <code class="track-lesson-source">{lesson.src}</code>
              </div>
              <div class="track-lesson-arrow" aria-hidden="true">→</div>
            </a>
            <a
              href={`https://github.com/lightspeedwp/.github/blob/develop/${lesson.src}`}
              class="track-lesson-gh-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              ↗ Source
            </a>
          </li>
        ))}
      </ol>

      <div class="track-start-cta">
        <AwesomeGithubButton
          href={`${base}learn/${track.id}/${track.lessons[0].slug}/`}
          variant="primary"
        >
          Start first lesson
        </AwesomeGithubButton>
      </div>
    </div>
  </section>

  {track.further.length > 0 && (
    <section class="track-further">
      <div class="track-container">
        <h2 class="track-section-title">Further reading</h2>
        <p class="track-further-desc">Explore these related docs once you've completed the track.</p>
        <div class="track-further-grid">
          {track.further.map((link) => (
            <a
              href={`https://github.com/lightspeedwp/.github/blob/develop/${link.p}`}
              class="track-further-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <code class="track-further-path">{link.p}</code>
              <span class="track-further-desc-text">{link.d}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</AwesomeGithubLayout>

<style>
  .track-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .track-breadcrumb {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) var(--gutter);
    font-size: var(--fs-body-sm);
  }

  .track-breadcrumb div {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .track-breadcrumb a { color: var(--fg-link); text-decoration: none; }
  .track-breadcrumb a:hover { color: var(--fg-link-hover); }
  .track-breadcrumb span:not([aria-hidden]) { color: var(--fg-2); }
  .track-breadcrumb [aria-hidden] { color: var(--fg-3); }

  .track-hero {
    background: linear-gradient(135deg, #0F1014 0%, #181820 100%);
    color: var(--c-white);
    padding: var(--space-24) var(--gutter);
  }

  .track-icon { font-size: 48px; margin-bottom: var(--space-4); display: block; }

  .track-eyebrow {
    display: inline-flex;
    padding: var(--space-2) var(--space-4);
    background: rgba(123, 231, 255, 0.1);
    border: 1px solid rgba(123, 231, 255, 0.3);
    border-radius: var(--radius-pill);
    font-size: var(--fs-eyebrow);
    color: var(--c-light-blue);
    margin-bottom: var(--space-6);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .track-h1 {
    font-size: var(--fs-h2);
    font-weight: var(--weight-extrabold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-4) 0;
    color: var(--c-white);
  }

  .track-blurb {
    font-size: var(--fs-body-lg);
    color: var(--c-slate-300);
    margin: 0 0 var(--space-6) 0;
    line-height: var(--lh-loose);
    max-width: 60ch;
  }

  .track-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-body-sm);
    color: var(--c-slate-300);
  }

  .track-lessons {
    padding: var(--space-16) var(--gutter);
    background: var(--bg);
  }

  .track-section-title {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    color: var(--fg-1);
    margin: 0 0 var(--space-8) 0;
  }

  .track-lessons-list {
    list-style: none;
    margin: 0 0 var(--space-8) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .track-lesson-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--dur) var(--ease-out);
    background: var(--bg);
  }

  .track-lesson-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
  }

  .track-lesson-number {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: var(--radius-pill);
    font-size: var(--fs-body-sm);
    font-weight: var(--weight-bold);
    font-family: var(--font-mono);
  }

  .track-lesson-body { flex: 1; }

  .track-lesson-title {
    font-size: var(--fs-h5);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-2) 0;
    color: var(--fg-1);
    text-transform: capitalize;
  }

  .track-lesson-learn {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--lh-snug);
  }

  .track-lesson-source {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
    display: inline-block;
  }

  .track-lesson-gh-link {
    display: inline-block;
    font-size: 12px;
    color: var(--fg-3);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    margin-left: calc(var(--space-5) + 36px + var(--space-5));
    transition: color var(--dur) var(--ease-out);
  }

  .track-lesson-gh-link:hover { color: var(--accent); }

  .track-lesson-arrow {
    flex-shrink: 0;
    color: var(--fg-3);
    font-size: 18px;
    align-self: center;
    transition: transform var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .track-lesson-link:hover .track-lesson-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  .track-start-cta { margin-top: var(--space-4); }

  .track-further {
    padding: var(--space-16) var(--gutter);
    background: var(--bg-alt);
  }

  .track-further-desc {
    font-size: var(--fs-body);
    color: var(--fg-2);
    margin: 0 0 var(--space-8) 0;
  }

  .track-further-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .track-further-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--dur) var(--ease-out);
  }

  .track-further-link:hover { border-color: var(--accent); }

  .track-further-path {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .track-further-desc-text {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
  }

  .track-progress-badge {
    font-size: var(--fs-body-sm);
    color: #22c55e;
    font-weight: var(--weight-semibold);
  }

  .track-lesson-item.track-lesson--completed .track-lesson-number {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  @media (max-width: 768px) {
    .track-hero { padding: var(--space-16) var(--gutter); margin-top: 72px; }
    .track-h1 { font-size: var(--fs-h3); }
    .track-further-grid { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ _trackId: track.id, _totalLessons: track.lessons.length }}>
  try {
    const key = "ag_learn_progress";
    const progress = JSON.parse(localStorage.getItem(key) || "{}");
    const trackProgress = progress[_trackId] || {};
    const completedSlugs = Object.keys(trackProgress).filter((k) => trackProgress[k]);
    const count = completedSlugs.length;

    if (count > 0) {
      const display = document.getElementById("track-progress-display");
      const sep = document.getElementById("track-progress-sep");
      if (display) {
        display.textContent = `${count} of ${_totalLessons} completed`;
        if (sep) sep.style.display = "";
      }

      completedSlugs.forEach((slug) => {
        const item = document.querySelector(`[data-lesson-slug="${slug}"]`);
        if (item) item.classList.add("track-lesson--completed");
      });
    }
  } catch {
    // localStorage unavailable
  }
</script>
