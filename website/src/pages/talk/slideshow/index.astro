---
import { getWceuSlides } from "../../../lib/wceuSlides";
import Slideshow from "../../../components/Slideshow.svelte";

const slides = getWceuSlides();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Evolution of .github — Presentation</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background: var(--bg, #fafbfc);
        color: var(--text, #24292f);
      }

      :root {
        --bg: #fafbfc;
        --bg-elevated: #ffffff;
        --bg-soft: #eaeef2;
        --text: #24292f;
        --muted: #57606a;
        --accent: #ff7730;
        --accent-2: #e85d75;
        --accent-3: #3fb950;
        --border: #d0d7de;
        --shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 12px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1117;
          --bg-elevated: #161b22;
          --bg-soft: #21262d;
          --text: #c9d1d9;
          --muted: #8b949e;
          --accent: #ff7730;
          --accent-2: #e85d75;
          --accent-3: #3fb950;
          --border: #30363d;
          --shadow: 0 8px 24px rgba(0, 0, 0, 0.44);
        }
      }
    </style>
  </head>
  <body>
    <Slideshow client:load slides={slides} />
  </body>
</html>
