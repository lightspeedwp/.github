---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getWceuSlides, resolveWceuReferenceHref } from "../../../lib/wceuSlides";

export async function getStaticPaths() {
  return getWceuSlides().map((slide) => ({
    params: { slug: slide.slug },
    props: { slide },
  }));
}

const { slide } = Astro.props;

if (!slide) {
  throw new Error("Slide data was not provided.");
}

const slideReferences = slide.evidence.map((evidence) => ({
  evidence,
  href: resolveWceuReferenceHref(evidence),
}));

// Agent guides related to each slide (based on talk narrative)
const agentsBySlide = {
  13: ["release", "branding", "meta"],      // Agent Layer
  14: ["all"],                               // Skill Layer (all agents use skills)
  15: ["all"],                               // Hook Layer
  16: ["release", "reviewer", "labeling"],  // Workflow Layer
  17: ["all"],                               // Issue Template System
  18: ["all"],                               // PR Template System
  19: ["all"],                               // AI Governance Model
};

const relatedAgents = agentsBySlide[slide.number] || [];
---

<BaseLayout
  title={`${slide.title} - Awesome GitHub`}
  description={slide.description}
>
  <section class="hero">
    <div class="eyebrow">Slide {slide.number.toString().padStart(2, "0")}</div>
    <h1>{slide.title.replace(/^Slide \d+ - /, "")}</h1>
    <p class="lede">{slide.description}</p>
    <div class="hero-actions">
      <a class="button primary" href="/talk/slideshow/">View Presentation</a>
      <a class="button secondary" href="/talk/slides/">All Slides</a>
      <a class="button secondary" href={slide.sourceHref} target="_blank" rel="noreferrer">
        View Source
      </a>
    </div>
  </section>

  <section class="section">
    <h2>Quick Navigation</h2>
    <div class="slide-nav">
      {slide.number > 1 && (
        <a class="slide-nav-btn prev" href={`/talk/slides/${getWceuSlides()[slide.number - 2].slug}/`}>
          ← Slide {(slide.number - 1).toString().padStart(2, "0")}
        </a>
      )}
      {slide.number < 20 && (
        <a class="slide-nav-btn next" href={`/talk/slides/${getWceuSlides()[slide.number].slug}/`}>
          Slide {(slide.number + 1).toString().padStart(2, "0")} →
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <h2>Key Points</h2>
    <div class="page-copy">
      <ul>
        {slide.keyPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  {relatedAgents.length > 0 && (
    <section class="section">
      <h2>Related Agent Guides</h2>
      <p class="section-intro">
        This slide references agent concepts. Explore the guides to learn more:
      </p>
      <div class="agent-links">
        {relatedAgents === "all" ? (
          <>
            <a href="/agents/release/" class="agent-link">Release Agent</a>
            <a href="/agents/branding/" class="agent-link">Branding Agent</a>
            <a href="/agents/meta/" class="agent-link">Meta Agent</a>
            <a href="/agents/reviewer/" class="agent-link">Reviewer Agent</a>
            <a href="/agents/linting/" class="agent-link">Linting Agent</a>
            <a href="/agents/labeling/" class="agent-link">Labelling Agent</a>
            <a href="/agents/planner/" class="agent-link">Planner Agent</a>
          </>
        ) : (
          relatedAgents.map((agent) => (
            <a href={`/agents/${agent}/`} class="agent-link">
              {agent.charAt(0).toUpperCase() + agent.slice(1)} Agent
            </a>
          ))
        )}
      </div>
    </section>
  )}

  <section class="section">
    <h2>Speaker Notes</h2>
    <div class="page-copy">
      <ul>
        {slide.speaker.length > 0
          ? slide.speaker.map((point) => <li>{point}</li>)
          : <li>No additional speaker expansion notes were recorded for this slide.</li>}
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Accessibility Notes</h2>
    <div class="page-copy">
      <ul>
        {slide.accessibility.length > 0
          ? slide.accessibility.map((note) => <li>{note}</li>)
          : <li>Use the same high-contrast, low-motion, readable layout used across the talk.</li>}
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>References & Evidence</h2>
    <div class="refs refs-stack">
      {slideReferences.map((reference) => (
        <a class="ref" href={reference.href} target="_blank" rel="noreferrer">
          <strong>{reference.evidence}</strong>
          <span>Reference used in this slide</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>In the Presentation</h2>
    <div class="page-copy">
      <p>
        <a href={`/talk/slideshow/?slide=${slide.number}`} class="inline-link">
          Jump to this slide in the fullscreen presentation →
        </a>
      </p>
      <p style="font-size: 0.875rem; color: var(--muted); margin-top: 1rem;">
        <kbd>←</kbd> <kbd>→</kbd> Navigate slides •
        <kbd>S</kbd> Toggle speaker notes •
        <kbd>Esc</kbd> Close overlays
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .slide-nav {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .slide-nav-btn {
    padding: 0.75rem 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease-out;
    display: inline-block;
  }

  .slide-nav-btn:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .agent-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .agent-link {
    padding: 0.5rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease-out;
  }

  .agent-link:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  kbd {
    display: inline-block;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    font-family: monospace;
    font-size: 0.75rem;
    margin: 0 0.25rem;
  }
</style>
