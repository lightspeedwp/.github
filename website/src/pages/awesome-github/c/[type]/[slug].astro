---
import AwesomeGithubLayout from "../../../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../../../components/AwesomeGithub/AwesomeGithubButton.astro";
import { getResource, getResourcesByType, getAvailableResourceTypes } from "../../../../lib/resources";

const base = import.meta.env.BASE_URL;

// Get the type and slug from URL params
const { type, slug } = Astro.params;

if (!type || !slug) {
  throw new Error('Resource type and slug are required');
}

// Get the resource
const resource = getResource(type, slug);

if (!resource) {
  throw new Error(`Resource not found: ${type}/${slug}`);
}

// Get resource type info
const allTypes = getAvailableResourceTypes();
const resourceTypeInfo = allTypes.find(t => t.type === type);

// Get related resources
const relatedResources = getResourcesByType(type)
  .filter(r => r.slug !== slug)
  .slice(0, 3);

// Generate paths for dynamic routes
export async function getStaticPaths() {
  const paths: any[] = [];
  const types = getAvailableResourceTypes();

  for (const typeInfo of types) {
    const resources = getResourcesByType(typeInfo.type);
    resources.forEach(resource => {
      paths.push({
        params: { type: typeInfo.type, slug: resource.slug },
      });
    });
  }

  return paths;
}

// Format date
function formatDate(dateStr: string | undefined): string {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<AwesomeGithubLayout
  title={`${resource.title} — Awesome GitHub`}
  description={resource.description}
>
  <section class="ag-breadcrumb-section">
    <div class="ag-container">
      <nav class="ag-breadcrumb" aria-label="Breadcrumb">
        <a href={`${base}awesome-github`}>Home</a>
        <span class="ag-breadcrumb-separator">/</span>
        <a href={`${base}awesome-github/c/${type}/`}>{resourceTypeInfo?.label}</a>
        <span class="ag-breadcrumb-separator">/</span>
        <span>{resource.title}</span>
      </nav>
    </div>
  </section>

  <section class="ag-resource-hero">
    <div class="ag-container">
      <div class="ag-resource-header">
        <div class="ag-resource-meta-header">
          <span class="ag-resource-type">{resourceTypeInfo?.icon} {resourceTypeInfo?.label}</span>
          {resource.frontmatter.status && (
            <span class={`ag-resource-status ag-status-${resource.frontmatter.status}`}>
              {resource.frontmatter.status}
            </span>
          )}
        </div>
        <h1 class="ag-h1">{resource.title}</h1>
        <p class="ag-lead">{resource.description}</p>
      </div>

      <div class="ag-resource-metadata">
        {resource.frontmatter.version && (
          <div class="ag-metadata-item">
            <span class="ag-metadata-label">Version</span>
            <span class="ag-metadata-value">{resource.frontmatter.version}</span>
          </div>
        )}
        {resource.frontmatter.last_updated && (
          <div class="ag-metadata-item">
            <span class="ag-metadata-label">Last Updated</span>
            <span class="ag-metadata-value">{formatDate(resource.frontmatter.last_updated)}</span>
          </div>
        )}
        {resource.frontmatter.author && (
          <div class="ag-metadata-item">
            <span class="ag-metadata-label">Author</span>
            <span class="ag-metadata-value">{resource.frontmatter.author}</span>
          </div>
        )}
        {resource.frontmatter.maintainer && (
          <div class="ag-metadata-item">
            <span class="ag-metadata-label">Maintainer</span>
            <span class="ag-metadata-value">{resource.frontmatter.maintainer}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="ag-content-section">
    <div class="ag-content-container">
      <div class="ag-main-content">
        <div class="ag-resource-content">
          {resource.content ? (
            <div set:html={resource.content} />
          ) : (
            <p>No additional content available for this resource.</p>
          )}
        </div>
      </div>

      <aside class="ag-sidebar">
        {resource.frontmatter.tags && resource.frontmatter.tags.length > 0 && (
          <div class="ag-sidebar-section">
            <h3>Tags</h3>
            <div class="ag-tags-list">
              {resource.frontmatter.tags.map((tag) => (
                <span class="ag-tag">{tag}</span>
              ))}
            </div>
          </div>
        )}

        {resource.frontmatter.tools && Array.isArray(resource.frontmatter.tools) && resource.frontmatter.tools.length > 0 && (
          <div class="ag-sidebar-section">
            <h3>Tools</h3>
            <ul class="ag-tools-list">
              {resource.frontmatter.tools.slice(0, 10).map((tool: string) => (
                <li>{tool}</li>
              ))}
              {resource.frontmatter.tools.length > 10 && (
                <li>+{resource.frontmatter.tools.length - 10} more</li>
              )}
            </ul>
          </div>
        )}

        {resource.frontmatter.handoffs && Array.isArray(resource.frontmatter.handoffs) && resource.frontmatter.handoffs.length > 0 && (
          <div class="ag-sidebar-section">
            <h3>Handoffs</h3>
            <ul class="ag-handoffs-list">
              {resource.frontmatter.handoffs.map((handoff: any) => (
                <li>
                  <strong>{handoff.label}</strong>
                  <p>{handoff.prompt}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="ag-sidebar-section">
          <a href={`${base}awesome-github/c/${type}/`} class="ag-back-link">
            ← Back to {resourceTypeInfo?.label}
          </a>
        </div>
      </aside>
    </div>
  </section>

  {relatedResources.length > 0 && (
    <section class="ag-section-alt">
      <div class="ag-container">
        <h2 class="ag-h2">Related {resourceTypeInfo?.label}</h2>
        <div class="ag-related-grid">
          {relatedResources.map((rel) => (
            <a href={`${base}awesome-github/c/${type}/${rel.slug}/`} class="ag-related-card">
              <h3 class="ag-related-title">{rel.title}</h3>
              <p class="ag-related-description">{rel.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</AwesomeGithubLayout>

<style>
  .ag-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .ag-breadcrumb-section {
    background: var(--bg);
    padding: var(--space-4) var(--gutter);
    border-bottom: 1px solid var(--border);
  }

  .ag-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-body-sm);
    flex-wrap: wrap;
  }

  .ag-breadcrumb a {
    color: var(--fg-link);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  .ag-breadcrumb a:hover {
    color: var(--fg-link-hover);
  }

  .ag-breadcrumb-separator {
    color: var(--fg-2);
  }

  .ag-resource-hero {
    background: linear-gradient(135deg, #0F1014 0%, #181820 100%);
    color: var(--c-white);
    padding: var(--space-40) var(--gutter);
  }

  .ag-resource-header {
    margin-bottom: var(--space-12);
  }

  .ag-resource-meta-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .ag-resource-type {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--c-light-blue);
    padding: var(--space-2) var(--space-4);
    background: rgba(123, 231, 255, 0.1);
    border: 1px solid rgba(123, 231, 255, 0.3);
    border-radius: var(--radius-pill);
  }

  .ag-resource-status {
    font-size: var(--fs-body-sm);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--weight-semibold);
    text-transform: capitalize;
  }

  .ag-status-active {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .ag-status-deprecated {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .ag-status-beta {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .ag-h1 {
    font-size: var(--fs-h1);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-6) 0;
  }

  .ag-lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--c-slate-300);
    margin: 0;
    max-width: 60ch;
  }

  .ag-resource-metadata {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ag-metadata-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ag-metadata-label {
    font-size: var(--fs-body-sm);
    color: var(--c-slate-300);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .ag-metadata-value {
    font-size: var(--fs-body);
    color: var(--c-light-blue);
  }

  .ag-content-section {
    padding: var(--space-40) var(--gutter);
    background: var(--bg);
  }

  .ag-content-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-12);
  }

  .ag-main-content {
    min-width: 0;
  }

  .ag-resource-content {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--fg-2);
  }

  .ag-resource-content :global(h2) {
    font-size: var(--fs-h3);
    font-weight: var(--weight-bold);
    margin: var(--space-8) 0 var(--space-4) 0;
    color: var(--fg-1);
  }

  .ag-resource-content :global(h3) {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: var(--space-6) 0 var(--space-3) 0;
    color: var(--fg-1);
  }

  .ag-resource-content :global(p) {
    margin: 0 0 var(--space-4) 0;
  }

  .ag-resource-content :global(ul),
  .ag-resource-content :global(ol) {
    margin: 0 0 var(--space-4) var(--space-6);
    padding: 0;
  }

  .ag-resource-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .ag-resource-content :global(code) {
    background: var(--bg-alt);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .ag-resource-content :global(pre) {
    background: var(--bg-alt);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 0 0 var(--space-4) 0;
  }

  .ag-sidebar {
    position: sticky;
    top: 100px;
  }

  .ag-sidebar-section {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .ag-sidebar-section h3 {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-4) 0;
    color: var(--fg-1);
  }

  .ag-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ag-tag {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    background: rgba(123, 231, 255, 0.1);
    color: var(--c-light-blue);
    border-radius: var(--radius-md);
    font-size: var(--fs-body-sm);
  }

  .ag-tools-list,
  .ag-handoffs-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ag-tools-list li,
  .ag-handoffs-list li {
    font-size: var(--fs-body-sm);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .ag-tools-list li:last-child,
  .ag-handoffs-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .ag-handoffs-list li strong {
    display: block;
    color: var(--fg-1);
    margin-bottom: var(--space-2);
  }

  .ag-handoffs-list li p {
    margin: 0;
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
  }

  .ag-back-link {
    display: inline-block;
    color: var(--fg-link);
    text-decoration: none;
    font-weight: var(--weight-semibold);
    transition: color 0.2s ease-out;
  }

  .ag-back-link:hover {
    color: var(--fg-link-hover);
  }

  .ag-section-alt {
    padding: var(--space-40) var(--gutter);
    background: var(--bg-alt);
  }

  .ag-h2 {
    font-size: var(--fs-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-8) 0;
  }

  .ag-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-6);
  }

  .ag-related-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease-out;
  }

  .ag-related-card:hover {
    border-color: var(--c-light-blue);
    box-shadow: 0 4px 12px rgba(123, 231, 255, 0.1);
    transform: translateY(-2px);
  }

  .ag-related-title {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-2) 0;
  }

  .ag-related-description {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0;
    line-height: var(--lh-snug);
  }

  @media (max-width: 768px) {
    .ag-resource-hero {
      padding: var(--space-20) var(--gutter) var(--space-16);
    }

    .ag-h1 {
      font-size: var(--fs-h2);
    }

    .ag-content-container {
      grid-template-columns: 1fr;
    }

    .ag-sidebar {
      position: static;
      top: auto;
    }

    .ag-resource-metadata {
      grid-template-columns: 1fr;
    }

    .ag-related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
