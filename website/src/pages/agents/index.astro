---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllAgents } from "../../lib/agents";

const agents = getAllAgents();
---

<BaseLayout
  title="Agent Guides — Awesome GitHub"
  description={`Learn about ${agents.length} specialist agents that power governance, automation, and project delivery.`}
>
  <section class="hero">
    <div class="eyebrow">Agent Guides</div>
    <h1>Meet Our Agents</h1>
    <p class="lede">
      {agents.length} specialist agents handle different aspects of governance, automation, project delivery, and technical excellence. Each agent is a reusable, self-contained capability designed for specific domains and workflows.
    </p>
    <div class="hero-actions">
      <a class="button secondary" href="/getting-started/">Why agents matter</a>
    </div>
  </section>

  <section class="section">
    <h2>All Agents ({agents.length})</h2>
    <div class="agent-grid">
      {agents.map((agent) => (
        <article class="agent-card">
          <div class="agent-header">
            <h3>{agent.name}</h3>
            <div class="difficulty">{agent.difficulty}</div>
          </div>
          <p class="agent-description">{agent.description}</p>
          <div class="agent-meta">
            <div class="meta-section">
              <strong>Key Capabilities:</strong>
              <ul>
                {agent.capabilities.slice(0, 3).map((cap) => (
                  <li>{cap}</li>
                ))}
                {agent.capabilities.length > 3 && (
                  <li>+ {agent.capabilities.length - 3} more</li>
                )}
              </ul>
            </div>
          </div>
          <a href={`/agents/${agent.slug}/`} class="agent-link">
            Explore Agent →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Agent Ecosystem</h2>
    <div class="page-copy">
      <p>
        Agents don't work in isolation. They integrate with each other to provide
        comprehensive governance, automation, and project delivery capabilities. Explore
        individual agent pages to learn about integrations, use cases, and related agents.
      </p>
      <p>
        Our agent ecosystem spans governance (Release, Branding, Meta, Linting, Labelling,
        Planner), project delivery (Website Scope Estimator, PRD Factory & Planner, Client
        Website Discovery), technical excellence (Playwright Testing, PageSpeed, WordPress
        Configuration), domain specialisation (WooCommerce, Tour Operator, Zendesk Support),
        and analytics (Harvest Analytical, Linear Advisor).
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Next Steps</h2>
    <div class="page-copy">
      <ul>
        <li>
          <a href="/wceu-2026/slides/slide-13-agent-layer/">Slide 13: Agent Layer</a> — Introduction to all agents
        </li>
        <li>
          <a href="/wceu-2026/slides/slide-14-skill-layer/">Slide 14: Skill Layer</a> — How agents use skills
        </li>
        <li>
          <a href="/getting-started/">Implementation Roadmap</a> — 30/60/90
          adoption plan
        </li>
        <li>
          <a href="/references/sources/">Sources & Tools</a> — Explore implementation resources
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .agent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .agent-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease-out;
  }

  .agent-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .agent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .agent-card h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .difficulty {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.75rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--accent);
    font-weight: 600;
  }

  .agent-description {
    color: var(--muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .agent-meta {
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .meta-section {
    margin-bottom: 1rem;
  }

  .meta-section strong {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text);
  }

  .meta-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .meta-section li {
    padding-left: 1rem;
    position: relative;
  }

  .meta-section li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .agent-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease-out;
  }

  .agent-link:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  @media (max-width: 860px) {
    .agent-grid {
      grid-template-columns: 1fr;
    }

    .agent-header {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
