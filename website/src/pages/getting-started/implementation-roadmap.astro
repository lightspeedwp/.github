---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const phases = [
  {
    name: "Days 1-30: Foundation",
    icon: "🏗️",
    tasks: [
      "Set up the .github repository structure",
      "Copy core instructions from this project",
      "Implement 2-3 core workflows (lint, test, release)",
      "Configure git hooks with husky",
      "Create initial CLAUDE.md with AI rules",
    ],
  },
  {
    name: "Days 31-60: Scaling",
    icon: "📈",
    tasks: [
      "Implement remaining core workflows",
      "Set up first agent (Release or Labelling)",
      "Create organisation-wide instructions",
      "Add branch protection rules",
      "Train team on new standards",
    ],
  },
  {
    name: "Days 61-90: Optimisation",
    icon: "🚀",
    tasks: [
      "Add 2-3 additional agents",
      "Create custom skills for your needs",
      "Implement metrics and reporting",
      "Refine workflows based on feedback",
      "Document and share patterns with team",
    ],
  },
];
---

<BaseLayout
  title="Implementation Roadmap - Awesome GitHub"
  description="A 30/60/90 day adoption plan for implementing .github governance."
>
  <section class="hero">
    <h1>30/60/90 Implementation Roadmap</h1>
    <p class="lede">
      A practical, phased approach to implementing .github governance in your organisation.
      Start small, validate, then scale.
    </p>
  </section>

  <section class="section">
    <h2>Phase Overview</h2>
    <div class="phases-grid">
      {phases.map((phase) => (
        <div class="phase-card">
          <div class="phase-header">
            <span class="icon">{phase.icon}</span>
            <h3>{phase.name}</h3>
          </div>
          <ul class="phase-tasks">
            {phase.tasks.map((task) => (
              <li>{task}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Day 1-30: Foundation Phase</h2>
    <div class="page-copy">
      <p>
        Focus on setting up the core infrastructure without trying to solve everything at once.
      </p>
      <h3>Week 1: Prepare</h3>
      <ul>
        <li>Create <code>.github</code> repository or folder</li>
        <li>Copy directory structure (workflows/, agents/, instructions/)</li>
        <li>Set up GitHub Pages for documentation (optional)</li>
      </ul>

      <h3>Week 2-3: Implement Workflows</h3>
      <ul>
        <li>Add linting workflow (ESLint, PHPCS)</li>
        <li>Add test workflow (Jest, PHPUnit)</li>
        <li>Add frontmatter validation workflow</li>
      </ul>

      <h3>Week 4: Local Setup</h3>
      <ul>
        <li>Configure git hooks with husky</li>
        <li>Add pre-commit hooks for linting</li>
        <li>Document setup in README</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Day 31-60: Scaling Phase</h2>
    <div class="page-copy">
      <p>
        Once foundation is solid, add automation agents and expand governance.
      </p>
      <h3>Weeks 5-7: Add Agents</h3>
      <ul>
        <li>Choose first agent (Release or Labelling recommended)</li>
        <li>Create agent instructions that align with your standards</li>
        <li>Test on non-critical repositories first</li>
      </ul>

      <h3>Week 8: Governance</h3>
      <ul>
        <li>Configure branch protection rules</li>
        <li>Set up required status checks</li>
        <li>Document approval workflows</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Day 61-90: Optimisation Phase</h2>
    <div class="page-copy">
      <p>
        Refine based on real-world usage and add advanced capabilities.
      </p>
      <ul>
        <li>Add 2-3 additional agents based on team needs</li>
        <li>Create custom skills for organisation-specific tasks</li>
        <li>Set up metrics collection and reporting</li>
        <li>Refine instructions based on learnings</li>
        <li>Share patterns and best practices with team</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Key Principles</h2>
    <div class="page-copy">
      <ul>
        <li><strong>Start small</strong> — Pick one workflow or agent and get it right first</li>
        <li><strong>Validate early</strong> — Test on non-critical repositories before rolling out</li>
        <li><strong>Document everything</strong> — Every workflow, agent, and instruction should be documented</li>
        <li><strong>Get feedback</strong> — Involve the team early and incorporate their input</li>
        <li><strong>Iterate</strong> — Don't aim for perfection; iterate based on real usage</li>
        <li><strong>Celebrate wins</strong> — Share successes with the team to build momentum</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Resources</h2>
    <div class="page-copy">
      <ul>
        <li><a href={`${base}introduction/`}>Introduction</a> — Understand the foundations</li>
        <li><a href={`${base}agents/`}>Agents</a> — Explore available agents</li>
        <li><a href={`${base}workflows/`}>Workflows</a> — Learn about automation workflows</li>
        <li><a href={`${base}learning-hub/`}>Learning Hub</a> — Guided paths for different goals</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .phases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .phase-card {
    background: var(--color-bg-secondary, #f6f8fa);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #d0d7de);
  }

  .phase-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .icon {
    font-size: 2rem;
  }

  .phase-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .phase-tasks {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .phase-tasks li {
    padding: 0.5rem 0 0.5rem 1.5rem;
    position: relative;
    font-size: 0.9rem;
    color: var(--color-text-secondary, #57606a);
  }

  .phase-tasks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary, #0969da);
    font-weight: bold;
  }
</style>
