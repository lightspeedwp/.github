---
import AwesomeGithubLayout from "../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../components/AwesomeGithub/AwesomeGithubButton.astro";
import AwesomeGithubCard from "../components/AwesomeGithub/AwesomeGithubCard.astro";

const base = import.meta.env.BASE_URL;

const catalogues = [
  { name: "Agents", href: `${base}agents/`, count: 9, icon: "🤖", description: "Specialised AI agents with defined behaviour, scope, and collaboration rules." },
  { name: "Instructions", href: `${base}instructions/`, count: 17, icon: "📋", description: "Canonical coding, accessibility, and WordPress standards Copilot must follow." },
  { name: "Prompts", href: `${base}awesome-github/c/prompts`, count: 39, icon: "💬", description: "Reusable prompt templates you can grab and run in your reasoning tooling." },
  { name: "Skills", href: `${base}skills/`, count: 7, icon: "⚡", description: "Portable, self-contained skill packages the team can run on demand." },
  { name: "Hooks", href: `${base}hooks/`, count: 6, icon: "🪝", description: "Pre-commit and lint guardrails that enforce quality before code lands." },
  { name: "Workflows", href: `${base}workflows/`, count: 5, icon: "⚙️", description: "Portable agentic workflow specs, each paired with a runnable GitHub Action." },
  { name: "Plugins", href: `${base}plugins/`, count: 2, icon: "🔌", description: "Installable, versioned plugin packs bundling governance and AI ops." },
  { name: "Tools", href: `${base}tools/`, count: 32, icon: "🔧", description: "The toolchain layer — UI utilities, scripts, schemas, and editor config." },
];

const stats = [
  { label: "Catalogues", value: "8" },
  { label: "Ready-to-use prompts", value: "39" },
  { label: "Learning lessons", value: "10" },
  { label: "Control plane", value: "1" },
];

const pillars = [
  { icon: "🔐", title: "Inherited by every repo", description: "Issue templates, Copilot instructions, and labels defined here are surfaced across every LightSpeed repository automatically—no copy-paste drift." },
  { icon: "⚡", title: "One-click install", description: "Copy the raw file, or push it straight into VS Code as a Copilot customisation. Every cart carries the same install actions." },
  { icon: "✓", title: "Governed & versioned", description: "Each resource is frontmatter-validated and versioned. Standards change in one place, and the whole team moves together." },
];
---

<AwesomeGithubLayout
  title="Awesome GitHub"
  description="A catalogue of AI governance resources and control plane for the LightSpeed WordPress team."
>
  <section class="ag-hero">
    <div class="ag-container">
      <div class="ag-eyebrow">
        <span class="ag-eyebrow-dot">●</span>
        <span>github.com/ lightspeedwp/.github</span>
      </div>
      <h1 class="ag-h1">
        <span class="ag-hero-line-1">Install AI governance,</span>
        <span class="ag-hero-line-2">not opinions.</span>
      </h1>
      <p class="ag-lead">
        One .github repository governs every LightSpeed repo. Browse and grab the agents, instructions, prompts, skills, and workflows we use to ship WordPress & WooCommerce work—then learn how it all fits together, at your own pace.
      </p>
      <div class="ag-cta-group">
        <AwesomeGithubButton variant="primary" href={`${base}awesome-github/getting-started`}>
          Start here
        </AwesomeGithubButton>
        <AwesomeGithubButton variant="secondary" href="#browse-resources">
          Browse catalogues
        </AwesomeGithubButton>
      </div>
    </div>
  </section>

  <section class="ag-stats">
    <div class="ag-container">
      <div class="ag-stats-grid">
        {stats.map((stat) => (
          <div class="ag-stat-item">
            <div class="ag-stat-value">{stat.value}</div>
            <div class="ag-stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="browse-resources" class="ag-section">
    <div class="ag-container">
      <div class="ag-section-header">
        <h2 class="ag-h2">Browse resources</h2>
        <p class="ag-lead">Eight catalogues, one source of truth</p>
        <p class="ag-body-sm">Every resource maps to a real file in the .github repo. Pick a catalogue to filter and install.</p>
      </div>

      <div class="ag-catalogue-grid-large">
        {catalogues.map((cat) => (
          <AwesomeGithubCard href={cat.href} class="ag-catalogue-card">
            <div class="ag-catalogue-icon">{cat.icon}</div>
            <h3 class="ag-h4">{cat.name}</h3>
            <p class="ag-small-muted">{cat.count} resources</p>
            <p class="ag-body-sm">{cat.description}</p>
            <div class="ag-card-footer">
              <a href={cat.href} class="ag-link">Explore →</a>
            </div>
          </AwesomeGithubCard>
        ))}
      </div>
    </div>
  </section>

  <section class="ag-section ag-section--alt">
    <div class="ag-container">
      <h2 class="ag-h2">Why a control plane</h2>
      <div class="ag-pillars-grid">
        {pillars.map((pillar) => (
          <article class="ag-pillar">
            <div class="ag-pillar-icon">{pillar.icon}</div>
            <h3 class="ag-h4">{pillar.title}</h3>
            <p class="ag-body-sm">{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ag-section ag-cta-section">
    <div class="ag-container">
      <div class="ag-cta-grid">
        <div class="ag-cta-box">
          <h3 class="ag-h4">Learning Centre</h3>
          <p class="ag-body-sm">Short, self-paced tracks built from the real governance docs. Read straight through, or dip into the lesson you need. We keep your place as you go.</p>
          <AwesomeGithubButton variant="secondary" href={`${base}learning-hub/`}>
            Open the Learning Centre
          </AwesomeGithubButton>
        </div>
        <div class="ag-cta-box">
          <h3 class="ag-h4">Cookbook</h3>
          <p class="ag-body-sm">Battle-tested, step-by-step recipes for planning, spec-driven workflows, and shipping WordPress plugins. Read one start to finish, or copy the steps into your own plan.</p>
          <AwesomeGithubButton variant="secondary" href={`${base}awesome-github/c/cookbook`}>
            Follow a recipe
          </AwesomeGithubButton>
        </div>
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .ag-section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .ag-section-header .ag-lead {
    margin-bottom: var(--space-2);
  }

  .ag-body-sm {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
  }

  .ag-small-muted {
    font-size: var(--fs-body-sm);
    color: var(--fg-3);
    margin: 0;
  }

  .ag-catalogue-grid-large {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .ag-catalogue-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  .ag-catalogue-icon {
    font-size: 32px;
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .ag-catalogue-card .ag-h4 {
    margin-bottom: var(--space-2);
  }

  .ag-card-footer {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .ag-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--weight-semibold);
    transition: color var(--dur) var(--ease-out);
  }

  .ag-link:hover {
    color: var(--accent-strong);
  }

  .ag-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .ag-pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ag-pillar-icon {
    font-size: 40px;
    line-height: 1;
  }

  .ag-cta-section {
    background: var(--bg);
  }

  .ag-cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .ag-cta-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .ag-cta-box .ag-h4 {
    margin: 0;
  }

  .ag-cta-box .ag-body-sm {
    margin: 0;
  }

  @media (max-width: 768px) {
    .ag-catalogue-grid-large {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }

    .ag-section-header {
      margin-bottom: var(--space-8);
    }
  }
</style>
