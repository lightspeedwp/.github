---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWceuSlides } from "../lib/wceuSlides";

const base = import.meta.env.BASE_URL;
const slideCount = getWceuSlides().length;
---

<BaseLayout
  title="Awesome GitHub"
  description="A conference-ready GitHub-led site for the WCEU 2026 talk, governance notes, and references."
>
  <section class="hero">
    <div class="eyebrow">Conference site</div>
    <h1>Awesome GitHub</h1>
    <p class="lede">
      A conference-ready GitHub-led website that explains how LightSpeed uses the
      <code>.github</code> repository as a practical control plane for planning,
      governance, and AI-assisted workflows.
    </p>
    <div class="hero-actions">
      <a class="button primary" href={`${base}slideshow/`}>Start slideshow</a>
      <a class="button secondary" href={`${base}wceu-2026/`}>WCEU 2026 talk</a>
      <a class="button secondary" href={`${base}why-this-exists/`}>Why this exists</a>
      <a class="button secondary" href={`${base}references/`}>Browse references</a>
    </div>
    <div class="kicker">What is live now</div>
    <div class="stat-list">
      <div class="stat">
        <strong>{slideCount + 6} pages</strong>
        Home, WCEU 2026 talk, slide index, {slideCount} slide pages, why this exists, and references.
      </div>
      <div class="stat">
        <strong>Source-backed</strong>
        Copy shaped by the talk slides, planning briefs, reference files, and audit notes.
      </div>
      <div class="stat">
        <strong>Conference-ready</strong>
        Designed to keep the public site clear, fast, and easy to extend.
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Site sections</h2>
    <div class="card-grid">
      <article class="card">
        <h3>Home</h3>
        <p>Clear positioning, a short value statement, and direct paths into the rest of the site.</p>
      </article>
      <article class="card">
        <h3>WCEU 2026 talk</h3>
        <p>The public entry point for the conference talk, its outline, slide index, and slide-by-slide pages.</p>
      </article>
      <article class="card">
        <h3>Why this exists</h3>
        <p>A concise explanation of the repository-as-control-plane model and the reason for the site.</p>
      </article>
      <article class="card">
        <h3>References</h3>
        <p>Primary links to the source repo, the live reference site, and the planning inputs.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2>How the site grows</h2>
    <div class="page-copy">
      <p>
        Additional pages can be added one at a time without resetting the header, footer,
        or tone. The shared shell is already set up to handle a growing conference pack,
        more reference material, and future resource pages.
      </p>
    </div>
  </section>
</BaseLayout>
