---
import AwesomeGithubLayout from "../layouts/AwesomeGithubLayout.astro";
import Icon from "../components/AwesomeGithub/Icon.astro";
import { CATEGORIES, ITEMS, getCategoryCounts } from "../lib/catalogue";

const base = import.meta.env.BASE_URL;
const promptCount = ITEMS.filter((item) => item.cat === "prompts").length;
const categoryCounts = getCategoryCounts();
---

<AwesomeGithubLayout
  title="Awesome GitHub — Governance, not opinions"
  description="A catalogue of AI governance resources and the control plane for the LightSpeed WordPress team."
>
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-inner">
        <span class="repo-chip">
          <span class="dot" aria-hidden="true"></span>
          github.com/lightspeedwp/.github
        </span>

        <h1>Install AI governance,<br><span class="hl">not opinions.</span></h1>

        <p class="hero-lead">
          One <code>.github</code> repository governs every LightSpeed repo. Browse and grab the
          agents, instructions, prompts, skills, and workflows we use to ship WordPress &amp;
          WooCommerce work - then learn how it all fits together, at your own pace.
        </p>

        <div class="hero-ctas">
          <a class="btn-primary" href={`${base}onboarding/`}>
            Start here <span aria-hidden="true">→</span>
          </a>
          <a class="btn-ghost" href="#catalogues">
            Browse catalogues
          </a>
        </div>

        <div class="stats" aria-label="Homepage stats">
          <div class="stat">
            <div class="n">8</div>
            <div class="l">catalogues</div>
          </div>
          <div class="stat">
            <div class="n">{promptCount}</div>
            <div class="l">ready-to-grab prompts</div>
          </div>
          <div class="stat">
            <div class="n">10</div>
            <div class="l">learning lessons</div>
          </div>
          <div class="stat">
            <div class="n">1</div>
            <div class="l">control plane</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="catalogues">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Browse resources</span>
          <h2>Eight catalogues, one source of truth</h2>
        </div>
        <p>Every resource maps to a real file in the .github repo. Pick a catalogue to filter and install.</p>
      </div>

      <div class="cat-grid">
        {CATEGORIES.map((cat) => (
          <a class="cat-card" href={`${base}c/${cat.id}/`}>
            <div class="cat-ico" aria-hidden="true">
              <Icon name={cat.icon} size={24} />
            </div>
            <h3>
              <span>{cat.label}</span>
              <span class="count">{categoryCounts[cat.id] || 0}</span>
            </h3>
            <p>{cat.blurb}</p>
            <span class="go">Explore <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Why a control plane</span>
          <h2>Consistency you install once</h2>
        </div>
      </div>

      <div class="feat-grid">
        <article class="feat">
          <div class="fi" aria-hidden="true">
            <Icon name="ph:stack" size={22} />
          </div>
          <h4>Inherited by every repo</h4>
          <p>
            Issue templates, Copilot instructions, and labels defined here are surfaced across
            every LightSpeed repository automatically - no copy-paste drift.
          </p>
        </article>

        <article class="feat">
          <div class="fi" aria-hidden="true">
            <Icon name="ph:lightning" size={22} />
          </div>
          <h4>One-click install</h4>
          <p>
            Copy the raw file, or push it straight into VS Code as a Copilot customisation. Every
            card carries the same install actions.
          </p>
        </article>

        <article class="feat">
          <div class="fi" aria-hidden="true">
            <Icon name="ph:shield-check" size={22} />
          </div>
          <h4>Governed &amp; versioned</h4>
          <p>
            Each resource is frontmatter-validated and versioned. Standards change in one place,
            and the whole team moves together.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cook-learn-grid">
        <a class="cl-card" href={`${base}learn/`}>
          <img
            src={`${base}assets/wapuus/wapuu-yoduu.png`}
            alt=""
            aria-hidden="true"
            class="cl-card-wapuu"
          />
          <div class="cl-card-text">
            <span class="eyebrow">Learning Centre</span>
            <h3>Learn it at your own pace</h3>
            <p>
              Short, self-paced tracks built from the real governance docs - read straight through
              or dip into the lesson you need. We keep your place.
            </p>
            <span class="go">Open the Learning Centre <span aria-hidden="true">→</span></span>
          </div>
        </a>

        <a class="cl-card" href={`${base}cookbook/`}>
          <img
            src={`${base}assets/wapuus/wapuu-rocket.svg`}
            alt=""
            aria-hidden="true"
            class="cl-card-wapuu"
          />
          <div class="cl-card-text">
            <span class="eyebrow">Cookbook</span>
            <h3>Follow a recipe</h3>
            <p>
              Battle-tested, step-by-step playbooks for planning, spec-driven delivery, and
              shipping WordPress plugins. Read and copy.
            </p>
            <span class="go">Browse recipes <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 56px;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--hair) 1px, transparent 1px),
      linear-gradient(90deg, var(--hair) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, var(--c-true-black) 0%, transparent 75%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .repo-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    padding: 6px 14px 6px 12px;
    color: var(--fg-2);
  }

  .repo-chip .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-brand-green-500);
  }

  h1 {
    margin-top: 18px;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hl {
    color: var(--accent);
  }

  .hero-lead {
    max-width: 620px;
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--fg-2);
  }

  .hero-lead code {
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid var(--hair);
    background: var(--panel-2);
    color: var(--fg-1);
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .stats {
    display: flex;
    gap: clamp(24px, 4vw, 48px);
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .stat .n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    color: var(--fg-1);
  }

  .stat .l {
    font-size: 13px;
    color: var(--fg-3);
    margin-top: 2px;
    font-family: var(--font-body);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
    padding: clamp(16px, 2vw, 22px);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .cat-ico {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
  }

  .cat-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--fg-1);
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cat-card .count {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-3);
    background: var(--panel-2);
    border: 1px solid var(--hair);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .cat-card p {
    font-size: 13.5px;
    color: var(--fg-2);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .cat-card .go {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 4px;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
    margin-top: clamp(24px, 3vw, 36px);
  }

  .feat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 2vw, 24px);
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
  }

  .feat .fi {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    flex: none;
  }

  .feat h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--fg-1);
    margin: 0;
  }

  .feat p {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.6;
    margin: 0;
  }

  .cook-learn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }

  .cl-card {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    padding: clamp(20px, 2.4vw, 32px);
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
    text-decoration: none;
    color: inherit;
  }

  .cl-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .cl-card-wapuu {
    height: clamp(96px, 10vw, 132px);
    width: auto;
    flex: none;
  }

  .cl-card-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cl-card-text h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.08;
    color: var(--fg-1);
    margin: 0;
  }

  .cl-card-text p {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 760px) {
    .cook-learn-grid {
      grid-template-columns: 1fr;
    }

    .cl-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }
</style>
