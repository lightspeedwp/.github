---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const skills = [
  {
    name: "Session Start Hook",
    description: "Set up repository for Claude Code on the web",
    triggers: ["Manual", "Scheduled"],
    related: ["Hooks", "Getting Started"],
  },
  {
    name: "Deep Research",
    description: "Fan-out web searches, fetch sources, synthesize reports",
    triggers: ["Manual", "Event-based"],
    related: ["Agents", "Tools"],
  },
  {
    name: "Update Config",
    description: "Configure Claude Code harness via settings.json",
    triggers: ["Manual"],
    related: ["Hooks", "Getting Started"],
  },
  {
    name: "Code Review",
    description: "Review code for correctness and quality issues",
    triggers: ["Manual", "PR Event"],
    related: ["Agents", "Workflows"],
  },
  {
    name: "Simplify",
    description: "Refactor code for reuse, efficiency, and clarity",
    triggers: ["Manual"],
    related: ["Agents", "Instructions"],
  },
  {
    name: "Keybindings Help",
    description: "Customize keyboard shortcuts and keybindings",
    triggers: ["Manual"],
    related: ["Tools", "Getting Started"],
  },
];
---

<BaseLayout
  title="Skills - Awesome GitHub"
  description="Reusable capabilities and skills that extend agent and workflow functionality."
>
  <section class="hero">
    <h1>Skills</h1>
    <p class="lede">
      Skills are reusable capabilities that agents and workflows can invoke.
      They encapsulate specific functionality and can be triggered manually, on schedule, or by events.
    </p>
  </section>

  <section class="section">
    <h2>What are skills?</h2>
    <div class="page-copy">
      <p>
        Skills are self-contained, reusable capabilities that extend your automation.
        They can be invoked by agents, workflows, or manually by users.
      </p>
      <p>
        Each skill has:
      </p>
      <ul>
        <li>A clear purpose and description</li>
        <li>Trigger conditions (manual, scheduled, event-based)</li>
        <li>Input and output specifications</li>
        <li>Example invocations</li>
        <li>Related agents and workflows</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Available skills</h2>
    <div class="skill-grid">
      {skills.map((skill) => (
        <article class="skill-card">
          <h3>{skill.name}</h3>
          <p>{skill.description}</p>
          <div class="skill-meta">
            <div class="triggers">
              <strong>Triggers:</strong>
              <div class="tags">
                {skill.triggers.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
            <div class="related">
              <strong>Related:</strong>
              <div class="links">
                {skill.related.map((r) => (
                  <a href={`${base}${r.toLowerCase()}/`}>{r}</a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Using skills</h2>
    <div class="page-copy">
      <p>
        Skills are invoked using the skill interface:
      </p>
      <pre><code>{"Skill(name: \"skill-name\", args: {...})"}</code></pre>
      <p>
        Each skill documents its available arguments, return values, and any prerequisites.
      </p>
      <p>
        Combine skills with workflows and agents to build sophisticated automation.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    background: var(--color-bg-secondary, #f6f8fa);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #d0d7de);
  }

  .skill-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .skill-card p {
    margin: 0.5rem 0 1rem;
    font-size: 0.95rem;
    color: var(--color-text-secondary, #57606a);
  }

  .skill-meta {
    font-size: 0.85rem;
  }

  .triggers,
  .related {
    margin-bottom: 0.75rem;
  }

  .triggers strong,
  .related strong {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-bg-hover, #eaeef2);
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .links a {
    color: var(--color-primary, #0969da);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .links a:hover {
    text-decoration: underline;
  }

  pre {
    background: var(--color-bg-secondary, #f6f8fa);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }

  code {
    font-family: "Courier New", monospace;
  }
</style>
