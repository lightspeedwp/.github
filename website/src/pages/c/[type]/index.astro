---
import AwesomeGithubLayout from "../../../layouts/AwesomeGithubLayout.astro";
import AwesomeGithubButton from "../../../components/AwesomeGithub/AwesomeGithubButton.astro";
import AwesomeGithubCard from "../../../components/AwesomeGithub/AwesomeGithubCard.astro";
import Icon from "../../../components/AwesomeGithub/Icon.astro";
import { getResourcesByType, getAvailableResourceTypes } from "../../../lib/resources";

const base = import.meta.env.BASE_URL;

// Get the type from URL params
const { type } = Astro.params;

if (!type) {
  throw new Error('Resource type is required');
}

// Get all available resource types for navigation
const allTypes = getAvailableResourceTypes();
const currentType = allTypes.find(t => t.type === type);

if (!currentType) {
  throw new Error(`Invalid resource type: ${type}`);
}

// Get resources of this type
const resources = getResourcesByType(type);

// Generate paths for dynamic routes
export async function getStaticPaths() {
  const types = getAvailableResourceTypes();
  return types.map(t => ({
    params: { type: t.type },
  }));
}
---

<AwesomeGithubLayout
  title={`${currentType.label} — Awesome GitHub`}
  description={`Browse all ${currentType.label.toLowerCase()} in the Awesome GitHub control plane.`}
>
  <section class="ag-breadcrumb-section">
    <div class="ag-container">
      <nav class="ag-breadcrumb" aria-label="Breadcrumb">
        <a href={`${base}`}>Home</a>
        <span class="ag-breadcrumb-separator">/</span>
        <span>{currentType.label}</span>
      </nav>
    </div>
  </section>

  <section class="ag-hero">
    <div class="ag-container">
      <div class="ag-section-label"><Icon name={currentType.icon} size={16} /> {currentType.label.toUpperCase()}</div>
      <h1 class="ag-h1">{currentType.label}</h1>
      <p class="ag-lead">
        Browse all available {currentType.label.toLowerCase()} from the LightSpeed control plane.
        {resources.length} resource{resources.length !== 1 ? 's' : ''} available.
      </p>
    </div>
  </section>

  <section class="ag-resources-section">
    <div class="ag-container">
      {resources.length > 0 ? (
        <div class="ag-resources-grid">
          {resources.map((resource) => (
            <a href={`${base}c/${type}/${resource.slug}/`} class="ag-resource-card">
              <div class="ag-resource-header">
                <h3 class="ag-resource-title">{resource.title}</h3>
              </div>
              <p class="ag-resource-description">{resource.description}</p>
              <div class="ag-resource-meta">
                {resource.frontmatter.version && (
                  <span class="ag-resource-version">{resource.frontmatter.version}</span>
                )}
                {resource.frontmatter.status && (
                  <span class={`ag-resource-status ag-status-${resource.frontmatter.status}`}>
                    {resource.frontmatter.status}
                  </span>
                )}
              </div>
              {resource.frontmatter.tags && resource.frontmatter.tags.length > 0 && (
                <div class="ag-resource-tags">
                  {resource.frontmatter.tags.slice(0, 3).map((tag) => (
                    <span class="ag-resource-tag">{tag}</span>
                  ))}
                  {resource.frontmatter.tags.length > 3 && (
                    <span class="ag-resource-tag">+{resource.frontmatter.tags.length - 3}</span>
                  )}
                </div>
              )}
            </a>
          ))}
        </div>
      ) : (
        <div class="ag-empty-state">
          <p>No resources found for this category.</p>
        </div>
      )}
    </div>
  </section>

  <section class="ag-section-alt">
    <div class="ag-container">
      <h2 class="ag-h2">Other Resource Types</h2>
      <p class="ag-lead">Explore other resource categories in the Awesome GitHub control plane.</p>
      <div class="ag-types-grid">
        {allTypes
          .filter(t => t.type !== type)
          .map((t) => (
            <a href={`${base}c/${t.type}/`} class="ag-type-card">
              <div class="ag-type-icon"><Icon name={t.icon} size={32} /></div>
              <h3 class="ag-type-name">{t.label}</h3>
              <p class="ag-type-count">{t.count} resource{t.count !== 1 ? 's' : ''}</p>
            </a>
          ))}
      </div>
    </div>
  </section>
</AwesomeGithubLayout>

<style>
  .ag-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .ag-breadcrumb-section {
    background: var(--bg);
    padding: var(--space-4) var(--gutter);
    border-bottom: 1px solid var(--border);
  }

  .ag-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-body-sm);
  }

  .ag-breadcrumb a {
    color: var(--fg-link);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  .ag-breadcrumb a:hover {
    color: var(--fg-link-hover);
  }

  .ag-breadcrumb-separator {
    color: var(--fg-2);
  }

  .ag-hero {
    background: linear-gradient(135deg, #0F1014 0%, #181820 100%);
    color: var(--c-white);
    padding: var(--space-40) var(--gutter);
  }

  .ag-section-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--c-light-blue);
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    background: rgba(123, 231, 255, 0.1);
    border: 1px solid rgba(123, 231, 255, 0.3);
    border-radius: var(--radius-pill);
  }

  .ag-h1 {
    font-size: var(--fs-h1);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-6) 0;
  }

  .ag-lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--c-slate-300);
    margin: 0;
    max-width: 60ch;
  }

  .ag-resources-section {
    padding: var(--section-y) var(--gutter);
    background: var(--bg);
  }

  .ag-resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-20);
  }

  .ag-resource-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease-out;
  }

  .ag-resource-card:hover {
    border-color: var(--c-light-blue);
    box-shadow: 0 4px 12px rgba(123, 231, 255, 0.1);
    transform: translateY(-2px);
  }

  .ag-resource-header {
    margin-bottom: var(--space-4);
  }

  .ag-resource-title {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: 0;
    line-height: 1.3;
  }

  .ag-resource-description {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0 0 var(--space-4) 0;
    flex: 1;
    line-height: var(--lh-snug);
  }

  .ag-resource-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .ag-resource-version {
    font-size: var(--fs-body-sm);
    color: var(--accent);
    font-weight: var(--weight-semibold);
  }

  .ag-resource-status {
    font-size: var(--fs-body-sm);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
    text-transform: capitalize;
  }

  .ag-status-active {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .ag-status-deprecated {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .ag-status-beta {
    background: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
  }

  .ag-resource-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .ag-resource-tag {
    font-size: var(--fs-body-sm);
    padding: var(--space-1) var(--space-2);
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-medium);
  }

  .ag-empty-state {
    text-align: center;
    padding: var(--space-20);
    color: var(--fg-2);
  }

  .ag-section-alt {
    padding: var(--section-y) var(--gutter);
    background: var(--bg-alt);
  }

  .ag-h2 {
    font-size: var(--fs-h2);
    font-weight: var(--weight-bold);
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-4) 0;
  }

  .ag-types-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .ag-type-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease-out;
    text-align: center;
  }

  .ag-type-card:hover {
    border-color: var(--c-light-blue);
    box-shadow: 0 4px 12px rgba(123, 231, 255, 0.1);
    transform: translateY(-2px);
  }

  .ag-type-icon {
    display: flex;
    color: var(--accent);
  }

  .ag-type-name {
    font-size: var(--fs-h4);
    font-weight: var(--weight-bold);
    margin: 0;
  }

  .ag-type-count {
    font-size: var(--fs-body-sm);
    color: var(--fg-2);
    margin: 0;
  }

  @media (max-width: 768px) {
    .ag-hero {
      padding: var(--space-20) var(--gutter) var(--space-16);
    }

    .ag-h1 {
      font-size: var(--fs-h2);
    }

    .ag-resources-grid {
      grid-template-columns: 1fr;
    }

    .ag-types-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }
  }
</style>
