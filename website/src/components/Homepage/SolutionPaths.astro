---
interface Props {
  highlightPath?: string;
}

const { highlightPath } = Astro.props;

const solutions = [
  {
    id: "platforms",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
    </svg>`,
    eyebrow: "STRUCTURED FOUNDATIONS",
    title: "WordPress Platforms",
    description:
      "For teams that need a stronger content and conversion foundation without inheriting another fragile theme stack.",
  },
  {
    id: "commerce",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>`,
    eyebrow: "COMMERCE UNDER CONTROL",
    title: "WooCommerce & Subscriptions",
    description:
      "For businesses that need cleaner product journeys, stronger performance and a store that can support ongoing growth.",
  },
  {
    id: "publishing",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
      <path d="M4 11.5A2.5 2.5 0 0 1 6.5 9H20M4 6h16"></path>
    </svg>`,
    eyebrow: "EDITORIAL SCALE",
    title: "Publishing & Content-Heavy",
    description:
      "For organisations managing migrations, structured content, complex editorial workflows and content at volume.",
  },
  {
    id: "aireadiness",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2a3 3 0 0 0-3 3v4a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
      <line x1="12" y1="19" x2="12" y2="23"></line>
      <line x1="8" y1="23" x2="16" y2="23"></line>
    </svg>`,
    eyebrow: "PREPARED, NOT REACTIVE",
    title: "AI Readiness & Governance",
    description:
      "For teams that want their content, structure and governance model ready for AI-assisted search and automation.",
  },
];
---

<section class="hp-solutions" id="solutions" data-screen-label="03 Solution Paths">
  <div class="wrap">
    <div class="hp-solutions-header">
      <span class="hp-eyebrow">WHAT WE DELIVER</span>
      <h2 class="hp-h2">Four solution paths, one engineering standard</h2>
      <p class="hp-lead">
        Most engagements blend two or more. Each is delivered against the same design-system thinking, block-theme architecture and accessibility baseline.
      </p>
    </div>

    <div class="hp-solutions-grid">
      {solutions.map((sol) => (
        <a
          href={`#${sol.id}`}
          class:list={[
            "hp-solution-card",
            { "hp-solution-card--highlighted": highlightPath === sol.id },
          ]}
        >
          <div class="hp-solution-icon" set:html={sol.icon}></div>
          <span class="hp-solution-eyebrow">{sol.eyebrow}</span>
          <h3 class="hp-h4">{sol.title}</h3>
          <p class="hp-solution-body">{sol.description}</p>
          <div class="hp-solution-link">Read about {sol.title.toLowerCase()} solutions</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hp-solutions {
    padding: clamp(64px, 9vw, 96px) 0;
  }

  .hp-solutions-header {
    margin-bottom: 52px;
  }

  .hp-eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .hp-h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: clamp(28px, 3.5vw, 42px);
    letter-spacing: -0.02em;
    color: var(--fg-1);
    max-width: 560px;
    text-wrap: balance;
    margin: 0 0 16px;
  }

  .hp-lead {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 560px;
  }

  .hp-solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .hp-solution-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    cursor: pointer;
    transition: all 220ms var(--ease-out);
  }

  .hp-solution-card:hover:not(.hp-solution-card--highlighted) {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
  }

  [data-theme="dark"] .hp-solution-card:hover:not(.hp-solution-card--highlighted) {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.5);
  }

  .hp-solution-card--highlighted {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 8px 32px rgba(30, 106, 255, 0.25);
    color: #ffffff;
  }

  [data-theme="dark"] .hp-solution-card--highlighted {
    color: #ffffff;
  }

  .hp-solution-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: all 220ms var(--ease-out);
  }

  .hp-solution-card--highlighted .hp-solution-icon {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  .hp-solution-icon svg {
    width: 20px;
    height: 20px;
  }

  .hp-solution-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
    transition: color 220ms var(--ease-out);
  }

  .hp-solution-card--highlighted .hp-solution-eyebrow {
    color: rgba(255, 255, 255, 0.6);
  }

  .hp-h4 {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 20px;
    letter-spacing: -0.015em;
    color: var(--fg-1);
    margin: 0;
    transition: color 220ms var(--ease-out);
  }

  .hp-solution-card--highlighted .hp-h4 {
    color: #ffffff;
  }

  .hp-solution-body {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    flex: 1;
    margin: 0;
    transition: color 220ms var(--ease-out);
  }

  .hp-solution-card--highlighted .hp-solution-body {
    color: rgba(255, 255, 255, 0.8);
  }

  .hp-solution-link {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 13px;
    color: var(--accent);
    transition: color 220ms var(--ease-out);
  }

  .hp-solution-card--highlighted .hp-solution-link {
    color: #7be7ff;
  }

  @media (max-width: 768px) {
    .hp-solutions-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
