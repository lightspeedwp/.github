---
---

<div class="hp-contact-overlay" data-contact-overlay>
  <div class="hp-contact-scrim" data-contact-scrim></div>

  <div class="hp-contact-dialog" data-contact-dialog role="dialog" aria-modal="true" aria-labelledby="hp-contact-h2">
    <button class="hp-contact-close" data-contact-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="hp-contact-content">
      <span class="hp-eyebrow hp-contact-eyebrow">BOOK A CONSULTATION</span>
      <h2 class="hp-contact-h2" id="hp-contact-h2">Tell us about your project</h2>
      <p class="hp-contact-sub">We reply within a working day. Quick call, no pitch.</p>

      <form class="hp-contact-form" data-contact-form>
        <!-- Info chip (hidden by default) -->
        <div class="hp-contact-info-chip" data-contact-info style="display: none;">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path
              d="m12 3-1.91 5.81a2 2 0 0 1-1.28 1.28L3 12l5.81 1.91a2 2 0 0 1 1.28 1.28L12 21l1.91-5.81a2 2 0 0 1 1.28-1.28L21 12l-5.81-1.91a2 2 0 0 1-1.28-1.28L12 3Z"
            ></path>
          </svg>
          <span data-contact-info-text></span>
        </div>

        <!-- Name + Email row -->
        <div class="hp-contact-row hp-contact-row-2">
          <div class="hp-contact-field">
            <label for="contact-name">Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="Your name"
              required
            />
          </div>
          <div class="hp-contact-field">
            <label for="contact-email">Work email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="you@company.com"
              required
            />
          </div>
        </div>

        <!-- Company -->
        <div class="hp-contact-field">
          <label for="contact-company">Company</label>
          <input
            type="text"
            id="contact-company"
            name="company"
            placeholder="Company name"
          />
        </div>

        <!-- Message -->
        <div class="hp-contact-field">
          <label for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Tell us about your project…"
            rows="5"
          ></textarea>
        </div>

        <!-- Submit -->
        <button type="submit" class="hp-contact-submit">
          Send enquiry
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

      </form>

      <!-- Success state (hidden by default) -->
      <div class="hp-contact-success" data-contact-success style="display: none;">
        <svg viewBox="0 0 24 24" fill="currentColor" style="color: #7be7ff;">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
        </svg>
        <h3>Thanks — we'll be in touch.</h3>
        <p>You'll hear from one of us within a working day.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .hp-contact-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 500;
  }

  .hp-contact-overlay[data-open] {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .hp-contact-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .hp-contact-dialog {
    position: relative;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 36px;
    max-width: 520px;
    width: 100%;
    color: #ffffff;
    animation: hpFadeUp 280ms var(--ease-out);
    max-height: 90vh;
    overflow-y: auto;
  }

  .hp-contact-dialog::backdrop {
    display: none;
  }

  .hp-contact-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--dur-fast);
  }

  .hp-contact-close:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .hp-contact-close svg {
    width: 20px;
    height: 20px;
  }

  .hp-contact-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hp-contact-eyebrow {
    color: #7be7ff;
  }

  .hp-contact-h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 24px;
    color: #ffffff;
    margin: 0;
  }

  .hp-contact-sub {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .hp-contact-info-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: rgba(30, 106, 255, 0.1);
    border: 1px solid rgba(30, 106, 255, 0.2);
    border-radius: 10px;
  }

  .hp-contact-info-chip svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .hp-contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hp-contact-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .hp-contact-row-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .hp-contact-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hp-contact-field label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--weight-medium);
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hp-contact-field input,
  .hp-contact-field textarea {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #ffffff;
    transition: border-color var(--dur-fast);
  }

  .hp-contact-field input::placeholder,
  .hp-contact-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .hp-contact-field input:focus,
  .hp-contact-field textarea:focus {
    outline: none;
    border-color: rgba(30, 106, 255, 0.5);
    background: rgba(255, 255, 255, 0.07);
  }

  .hp-contact-field textarea {
    resize: none;
    line-height: 1.5;
  }

  .hp-contact-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    align-self: flex-start;
    padding: 13px 22px;
    background: #1e6aff;
    border: none;
    border-radius: var(--radius-pill);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 15px;
    cursor: pointer;
    transition: background var(--dur-fast);
  }

  .hp-contact-submit:hover {
    background: #1857d6;
  }

  .hp-contact-submit:active {
    transform: scale(0.98);
  }

  .hp-contact-submit:disabled {
    background: rgba(30, 106, 255, 0.5);
    cursor: not-allowed;
  }

  .hp-contact-submit svg {
    width: 16px;
    height: 16px;
  }

  .hp-contact-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    padding: 24px 0;
  }

  .hp-contact-success svg {
    width: 36px;
    height: 36px;
  }

  .hp-contact-success h3 {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 22px;
    color: #ffffff;
    margin: 0;
  }

  .hp-contact-success p {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  @media (max-width: 480px) {
    .hp-contact-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const overlay = document.querySelector("[data-contact-overlay]") as HTMLElement | null;
  const scrim = document.querySelector("[data-contact-scrim]") as HTMLElement | null;
  const dialog = document.querySelector("[data-contact-dialog]") as HTMLElement | null;
  const closeBtn = document.querySelector("[data-contact-close]") as HTMLElement | null;
  const form = document.querySelector("[data-contact-form]") as HTMLFormElement | null;
  const successEl = document.querySelector("[data-contact-success]") as HTMLElement | null;
  const infoChip = document.querySelector("[data-contact-info]") as HTMLElement | null;

  // Open overlay on anchor links
  if (overlay) {
    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const link = target?.closest("a") as HTMLAnchorElement | null;
      const href = link?.getAttribute("href");
      if (href === "#contact") {
        e.preventDefault();
        overlay.setAttribute("data-open", "");
      }
    });

    // Close handlers
    scrim?.addEventListener("click", () => {
      overlay.removeAttribute("data-open");
    });

    closeBtn?.addEventListener("click", () => {
      overlay.removeAttribute("data-open");
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.hasAttribute("data-open")) {
        overlay.removeAttribute("data-open");
      }
    });

    // Form submit
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const currentForm = e.currentTarget as HTMLFormElement;
      const submitBtn = currentForm.querySelector("[type=submit]") as HTMLButtonElement | null;
      if (!submitBtn) return;

      submitBtn.disabled = true;

      const formData = new FormData(currentForm);
      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        company: formData.get("company"),
        message: formData.get("message"),
      };

      try {
        // TODO: Connect to real backend service (e.g., Formspree, email.js, or custom API)
        console.log("Form submission (placeholder):", data);

        const originalButtonText = submitBtn.textContent;
        submitBtn.textContent = "⚠️ Not yet wired to backend";
        submitBtn.style.background = "rgba(30, 106, 255, 0.5)";

        // Reset after 3 seconds
        setTimeout(() => {
          submitBtn.textContent = originalButtonText;
          submitBtn.style.background = "";
          submitBtn.disabled = false;
        }, 3000);
      } catch (err) {
        console.error("Form submission error:", err);
        submitBtn.disabled = false;
      }
    });
  }
</script>
