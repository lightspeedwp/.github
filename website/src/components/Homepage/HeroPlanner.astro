---
---

<section class="hp-hero" data-screen-label="01 Hero Planner">
  <div class="hp-hero-bg">
    <div class="hp-hero-glow hp-hero-glow--1"></div>
    <div class="hp-hero-glow hp-hero-glow--2"></div>
    <div class="hp-hero-grid"></div>
  </div>

  <div class="hp-hero-inner">
    <!-- Badge -->
    <div class="hp-badge">
      <span class="hp-badge-dot">●</span>
      <span class="hp-badge-text">WordPress Engineering Partner</span>
    </div>

    <!-- H1 -->
    <h1 class="hp-h1">
      Plan a WordPress site<br />your team can <em>grow with</em>
    </h1>

    <!-- Intro -->
    <p class="hp-intro">
      Describe your project and our AI planner will help you frame the brief, identify the right approach, and find the best starting point — before you commit to anything.
    </p>

    <!-- Planner input card -->
    <div class="hp-planner-card">
      <div class="hp-planner-input-row">
        <svg
          class="hp-planner-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
        >
          <path
            d="m12 3-1.91 5.81a2 2 0 0 1-1.28 1.28L3 12l5.81 1.91a2 2 0 0 1 1.28 1.28L12 21l1.91-5.81a2 2 0 0 1 1.28-1.28L21 12l-5.81-1.91a2 2 0 0 1-1.28-1.28L12 3Z"
          ></path>
        </svg>
        <textarea
          class="hp-planner-textarea"
          placeholder="Describe the website you need to plan…"
          rows="2"
          data-planner-input
        ></textarea>
        <button class="hp-planner-submit" data-planner-submit aria-label="Submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <!-- Loading state (hidden by default) -->
      <div class="hp-planner-loading" data-planner-loading style="display: none;">
        <div class="hp-spinner"></div>
        <p>Planning your project…</p>
      </div>

      <!-- Result card (hidden by default) -->
      <div class="hp-result-card" data-planner-result style="display: none;">
        <!-- Result content injected here -->
      </div>

      <!-- Sub-label -->
      <p class="hp-planner-label">
        PROJECT DIRECTION · CONTENT STRUCTURE · WOOCOMMERCE · LMS · MIGRATION · AI READINESS
      </p>
    </div>

    <!-- Suggestion chips -->
    <div class="hp-chips">
      <button class="hp-chip" data-chip="Plan a WordPress website">
        Plan a WordPress website
      </button>
      <button class="hp-chip" data-chip="Scope a tour operator website">
        Scope a tour operator website
      </button>
      <button class="hp-chip" data-chip="Plan a publisher website">
        Plan a publisher website
      </button>
      <button class="hp-chip" data-chip="Scope a WooCommerce store">
        Scope a WooCommerce store
      </button>
      <button class="hp-chip" data-chip="Plan an education or LMS website">
        Plan an education or LMS website
      </button>
      <button class="hp-chip" data-chip="Assess AI readiness for our website">
        Assess AI readiness for our website
      </button>
    </div>

    <!-- Fallback line -->
    <p class="hp-fallback">
      Prefer to speak directly?
      <a href="#contact" class="hp-fallback-link">Book your consultation instead</a>
    </p>
  </div>
</section>

<style>
  .hp-hero {
    background: #090909;
    color: #ffffff;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vw, 130px) clamp(16px, 5vw, 24px) clamp(56px, 8vw, 80px);
    text-align: center;
  }

  .hp-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hp-hero-glow {
    position: absolute;
    width: 1000px;
    height: 560px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hp-hero-glow--1 {
    top: 68%;
    background: radial-gradient(
      ellipse 1000px 560px at 50% 68%,
      rgba(30, 106, 255, 0.12) 0%,
      transparent 70%
    );
  }

  .hp-hero-glow--2 {
    top: 72%;
    width: 480px;
    height: 280px;
    background: radial-gradient(
      ellipse 480px 280px at 50% 72%,
      rgba(123, 231, 255, 0.07) 0%,
      transparent 60%
    );
  }

  .hp-hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.028) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(
      ellipse 80% 55% at 50% 0%,
      #000 15%,
      transparent 80%
    );
    mask-image: radial-gradient(
      ellipse 80% 55% at 50% 0%,
      #000 15%,
      transparent 80%
    );
  }

  .hp-hero-inner {
    max-width: 800px;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    border-radius: var(--radius-pill);
    background: rgba(30, 106, 255, 0.11);
    border: 1px solid rgba(30, 106, 255, 0.24);
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #7be7ff;
    margin-bottom: 30px;
  }

  .hp-badge-dot {
    width: 6px;
    height: 6px;
    background: #7be7ff;
    border-radius: 50%;
  }

  .hp-h1 {
    font-size: clamp(36px, 7.5vw, 72px);
    font-weight: var(--weight-extrabold);
    line-height: 1.08;
    letter-spacing: -0.026em;
    color: #ffffff;
    text-wrap: balance;
    margin: 0 0 20px;
  }

  .hp-h1 em {
    font-style: normal;
    color: #7be7ff;
  }

  .hp-intro {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.56);
    max-width: 540px;
    margin: 0 auto 38px;
    text-wrap: pretty;
  }

  .hp-planner-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 16px 14px 16px 18px;
    margin-bottom: 28px;
  }

  .hp-planner-card:focus-within {
    border-color: rgba(30, 106, 255, 0.5);
    box-shadow: 0 0 0 3px rgba(30, 106, 255, 0.11);
  }

  .hp-planner-input-row {
    display: flex;
    gap: 12px;
    align-items: flex-end;
  }

  .hp-planner-icon {
    width: 17px;
    height: 17px;
    color: #1e6aff;
    margin-bottom: 3px;
    flex-shrink: 0;
    stroke-width: 1.5;
  }

  .hp-planner-textarea {
    flex: 1;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.5;
    color: #ffffff;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    padding: 0;
  }

  .hp-planner-textarea::placeholder {
    color: rgba(255, 255, 255, 0.32);
  }

  .hp-planner-submit {
    width: 40px;
    height: 40px;
    padding: 0;
    background: #1e6aff;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background var(--dur-fast);
  }

  .hp-planner-submit:hover:not(:disabled) {
    background: #1857d6;
  }

  .hp-planner-submit:disabled {
    background: rgba(30, 106, 255, 0.25);
    cursor: not-allowed;
  }

  .hp-planner-submit svg {
    width: 17px;
    height: 17px;
    stroke-width: 2;
  }

  .hp-planner-submit[data-loading] svg {
    animation: hpSpin 1s linear infinite;
  }

  .hp-planner-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px 0;
  }

  .hp-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(30, 106, 255, 0.2);
    border-top-color: #1e6aff;
    border-radius: 50%;
    animation: hpSpin 1s linear infinite;
  }

  .hp-planner-loading p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }

  .hp-result-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(30, 106, 255, 0.28);
    border-radius: 20px;
    padding: 28px;
    text-align: left;
    animation: hpFadeUp 320ms var(--ease-out);
  }

  .hp-planner-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
    margin: 10px 0 18px;
  }

  .hp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 28px;
  }

  .hp-chip {
    padding: 8px 15px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-medium);
    white-space: nowrap;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .hp-chip:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  .hp-chip:active {
    transform: scale(0.98);
  }

  .hp-fallback {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
  }

  .hp-fallback-link {
    color: rgba(123, 231, 255, 0.7);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur-fast);
  }

  .hp-fallback-link:hover {
    color: #7be7ff;
  }

  @media (max-width: 768px) {
    .hp-hero {
      min-height: auto;
    }
  }
</style>

<script>
  const input = document.querySelector("[data-planner-input]") as HTMLTextAreaElement | null;
  const submit = document.querySelector("[data-planner-submit]") as HTMLButtonElement | null;
  const loading = document.querySelector("[data-planner-loading]") as HTMLElement | null;
  const result = document.querySelector("[data-planner-result]") as HTMLElement | null;
  const chips = document.querySelectorAll(".hp-chip");

  if (chips.length) {
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const text = chip.dataset.chip;
        if (input) {
          input.value = text;
          input.focus();
        }
      });
    });
  }

  if (submit && input) {
    const handleSubmit = async () => {
      const text = input.value.trim();
      if (!text) return;

      submit.disabled = true;
      submit.setAttribute("data-loading", "");
      input.style.opacity = "0.5";
      input.disabled = true;

      if (loading) loading.style.display = "flex";
      if (result) result.style.display = "none";

      try {
        // Call the AI planner
        if (window.claude && window.claude.complete) {
          const response = await window.claude.complete(
            `You are an expert WordPress consultant. Based on the following project description, provide a JSON response with: projectType (string), summary (string), considerations (array of 3 strings), recommendedPath (string: "platforms", "commerce", "publishing", or "aireadiness"), recommendedPathLabel (string), timelineHint (string), and nextStep (string).

Project: ${text}`
          );

          let cleanResponse = response.trim();
          if (cleanResponse.startsWith("```")) {
            cleanResponse = cleanResponse.replace(/^```(?:json)?\s*/i, "").replace(/```$/, "").trim();
          }
          const data = JSON.parse(cleanResponse);
          displayResult(data);
        } else {
          // Fallback for development
          const fallback = {
            projectType: "WordPress Platform",
            summary: text.substring(0, 100) + "...",
            considerations: [
              "Content structure and governance model",
              "Team capabilities and maintenance",
              "Integration with existing systems",
            ],
            recommendedPath: "platforms",
            recommendedPathLabel: "WordPress Platforms",
            timelineHint: "8-12 weeks",
            nextStep:
              "Schedule a discovery call to discuss your specific needs",
          };
          displayResult(fallback);
        }
      } catch (err) {
        console.error("Planner error:", err);
        alert("Unable to plan your project. Please try again.");
      } finally {
        submit.disabled = false;
        submit.removeAttribute("data-loading");
        input.style.opacity = "1";
        input.disabled = false;
        if (loading) loading.style.display = "none";
      }
    };

    submit.addEventListener("click", handleSubmit);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        handleSubmit();
      }
    });
  }

  function displayResult(data) {
    if (!result) return;

    result.innerHTML = "";
    result.style.display = "block";

    const header = document.createElement("div");
    header.style.cssText = "display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.07);";

    const summaryDiv = document.createElement("div");
    summaryDiv.style.cssText = "font-style: italic; color: rgba(255,255,255,0.35); font-size: 13px;";
    summaryDiv.textContent = data.summary;
    header.appendChild(summaryDiv);

    const closeBtn = document.createElement("button");
    closeBtn.style.cssText = "background: transparent; border: none; color: rgba(255,255,255,0.3); cursor: pointer; font-size: 16px; padding: 0; width: 24px; height: 24px;";
    closeBtn.textContent = "✕";
    closeBtn.addEventListener("click", () => {
      result.style.display = "none";
    });
    header.appendChild(closeBtn);
    result.appendChild(header);

    const infoDiv = document.createElement("div");
    infoDiv.style.marginBottom = "12px";

    const directionLabel = document.createElement("div");
    directionLabel.style.cssText = "font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #7be7ff; margin-bottom: 8px;";
    directionLabel.textContent = "Planning direction";
    infoDiv.appendChild(directionLabel);

    const title = document.createElement("h3");
    title.style.cssText = "font-family: var(--font-display); font-weight: 800; font-size: 22px; color: #ffffff; margin: 0 0 12px; letter-spacing: -0.015em;";
    title.textContent = data.projectType;
    infoDiv.appendChild(title);

    const description = document.createElement("p");
    description.style.cssText = "font-family: var(--font-body); font-size: 14px; color: rgba(255,255,255,0.6); margin: 0 0 16px;";
    description.textContent = data.summary;
    infoDiv.appendChild(description);
    result.appendChild(infoDiv);

    const considDiv = document.createElement("div");
    considDiv.style.marginBottom = "20px";

    const considerations = Array.isArray(data.considerations) ? data.considerations : [];
    considerations.forEach((c) => {
      const item = document.createElement("div");
      item.style.cssText = "display: flex; gap: 12px; margin-bottom: 12px; align-items: flex-start;";

      const iconWrapper = document.createElement("div");
      iconWrapper.style.cssText = "width: 18px; height: 18px; border-radius: 50%; background: rgba(30,106,255,0.22); display: flex; align-items: center; justify-content: center; flex-shrink: 0;";
      iconWrapper.innerHTML = '<svg style="width: 10px; height: 10px; color: #7be7ff;" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      item.appendChild(iconWrapper);

      const text = document.createElement("div");
      text.style.cssText = "font-family: var(--font-body); font-size: 13.5px; color: rgba(255,255,255,0.65);";
      text.textContent = c;
      item.appendChild(text);

      considDiv.appendChild(item);
    });
    result.appendChild(considDiv);

    const tagsDiv = document.createElement("div");
    tagsDiv.style.cssText = "display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.06);";

    const timelineTag = document.createElement("div");
    timelineTag.style.cssText = "padding: 8px 16px; border-radius: 6px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); font-family: var(--font-mono); font-size: 11px; font-weight: 500; color: rgba(255,255,255,0.45); text-transform: uppercase;";
    timelineTag.textContent = "Timeline: " + data.timelineHint;
    tagsDiv.appendChild(timelineTag);

    const pathTag = document.createElement("div");
    pathTag.style.cssText = "padding: 8px 16px; border-radius: 6px; background: rgba(30,106,255,0.1); border: 1px solid rgba(30,106,255,0.2); font-family: var(--font-mono); font-size: 11px; font-weight: 500; color: #7be7ff; text-transform: uppercase;";
    pathTag.textContent = "Path: " + data.recommendedPathLabel;
    tagsDiv.appendChild(pathTag);
    result.appendChild(tagsDiv);

    const nextDiv = document.createElement("p");
    nextDiv.style.cssText = "font-family: var(--font-body); font-size: 13px; color: rgba(255,255,255,0.38); font-style: italic; margin: 16px 0 20px;";
    nextDiv.textContent = "Next: " + data.nextStep;
    result.appendChild(nextDiv);

    const actionsDiv = document.createElement("div");
    actionsDiv.style.cssText = "display: flex; gap: 12px; flex-wrap: wrap;";

    const exploreLink = document.createElement("a");
    exploreLink.href = "#solutions";
    exploreLink.style.cssText = "display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; background: #1e6aff; color: #ffffff; font-family: var(--font-display); font-weight: 700; font-size: 14px; border-radius: 9999px; text-decoration: none; transition: background var(--dur-fast);";
    exploreLink.textContent = "Explore " + data.recommendedPathLabel + " ";
    exploreLink.innerHTML += '<svg style="width: 14px; height: 14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
    actionsDiv.appendChild(exploreLink);

    const consultLink = document.createElement("a");
    consultLink.href = "#contact";
    consultLink.style.cssText = "display: inline-flex; align-items: center; padding: 12px 20px; background: transparent; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.75); font-family: var(--font-display); font-weight: 600; font-size: 14px; border-radius: 9999px; text-decoration: none; transition: all var(--dur-fast);";
    consultLink.textContent = "Book your consultation";
    actionsDiv.appendChild(consultLink);

    result.appendChild(actionsDiv);
  }
</script>
