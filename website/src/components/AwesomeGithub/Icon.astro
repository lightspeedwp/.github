---
import { getIconSvg } from "../../lib/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const svgContent = getIconSvg(name, size);
---

<span class:list={["ag-icon", className]} aria-hidden="true" set:html={svgContent} />

<style>
  .ag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 1;
  }

  .ag-icon svg {
    display: block;
  }
</style>
