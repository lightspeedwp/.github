---
import Icon from "./Icon.astro";
import { CATEGORIES } from "../../lib/catalogue";

interface Props {
  base: string;
  pathname: string;
}

const { base, pathname } = Astro.props;

const isActive = (path: string): boolean => {
  const norm = pathname.replace(/\/$/, "");
  const p = path.replace(/\/$/, "");
  return norm === p || norm.startsWith(p + "/");
};
---

<!-- Sticky nav bar -->
<header class="nav" role="banner">
  <div class="wrap">

    <!-- Brand / Logo -->
    <a href={base} class="nav-brand" aria-label="Awesome GitHub — home">
      <img class="brand-icon-light" src={base + "awesome-github/LS-Agency-Site-Icon-Blue.svg"} alt="" width="26" height="26" />
      <img class="brand-icon-dark" src={base + "awesome-github/LS-Agency-Site-Icon-Light-Blue.svg"} alt="" width="26" height="26" />
      <b>Awesome<span class="tld"> GitHub</span></b>
    </a>

    <!-- Desktop nav (hidden on mobile) -->
    <nav class="nav-primary" aria-label="Main navigation">
      <!-- Browse dropdown -->
      <div class="browse-wrapper" data-browse-menu>
        <button class="nav-btn" aria-expanded="false" aria-controls="browse-panel">
          Browse
          <span class="chev"><Icon name="ph:caret-down" size={15} /></span>
        </button>
        <div class="dropdown dd-cats" id="browse-panel" role="menu">
          {CATEGORIES.map((cat) => (
            <a href={`${base}c/${cat.id}/`} class="dd-item" role="menuitem">
              <div class="ddi"><Icon name={cat.icon} size={16} /></div>
              <div>
                <b>{cat.label}</b>
                <span>{cat.blurb}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Regular nav buttons -->
      <a href={`${base}cookbook/`} class="nav-btn" aria-current={isActive("/cookbook") ? "page" : undefined}>
        Cookbook
      </a>
      <a href={`${base}learn/`} class="nav-btn" aria-current={isActive("/learn") ? "page" : undefined}>
        Learn
      </a>

      <!-- Resources dropdown -->
      <div class="resources-wrapper" data-resources-menu>
        <button class="nav-btn" aria-expanded="false" aria-controls="resources-panel">
          Resources
          <span class="chev"><Icon name="ph:caret-down" size={15} /></span>
        </button>
        <div class="dropdown dd-res" id="resources-panel" role="menu">
          <a href={`${base}onboarding/`} class="dd-simple" role="menuitem">
            <Icon name="ph:lightning" size={16} class="ddi" />
            Onboarding journey
          </a>
          <a href={`${base}getting-started/`} class="dd-simple" role="menuitem">
            <Icon name="ph:download-simple" size={16} class="ddi" />
            Getting started
          </a>
          <a href={`${base}why/`} class="dd-simple" role="menuitem">
            <Icon name="ph:info" size={16} class="ddi" />
            Why this exists
          </a>
          <a href={`${base}glossary/`} class="dd-simple" role="menuitem">
            <Icon name="ph:book-open" size={16} class="ddi" />
            Glossary
          </a>
          <a href={`${base}references/`} class="dd-simple" role="menuitem">
            <Icon name="ph:github-logo" size={16} class="ddi" />
            References
          </a>
        </div>
      </div>
    </nav>

    <!-- Right-side actions -->
    <div class="nav-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="Search resources (⌘K)">
        <Icon name="ph:magnifying-glass" size={16} />
        <span class="stxt">Search resources</span>
        <span class="kbd">⌘K</span>
      </button>

      <div class="nav-extra">
        <!-- Branch toggle -->
        <div class="branch" role="group" aria-label="Repository branch">
          <button class="branch-btn" data-branch="main" aria-pressed="true">
            <span class="bdot"></span>main
          </button>
          <button class="branch-btn" data-branch="develop" aria-pressed="false">
            <span class="bdot"></span>dev
          </button>
        </div>

        <!-- Theme toggle -->
        <button class="icon-btn" type="button" data-awesome-github-theme-toggle aria-pressed="false" aria-label="Switch theme">
          <Icon name="ph:sun" size={18} class="sun-icon" />
          <Icon name="ph:moon" size={18} class="moon-icon" />
        </button>

        <!-- GitHub link -->
        <a href="https://github.com/lightspeedwp/.github" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub repository">
          <Icon name="ph:github-logo" size={18} />
        </a>
      </div>

      <!-- Hamburger menu (mobile only) -->
      <button class="burger" type="button" data-nav-hamburger aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open navigation">
        <Icon name="ph:list" size={20} class="menu-icon" />
        <Icon name="ph:x" size={20} class="close-icon" />
      </button>
    </div>

  </div>
</header>

<!-- Mobile overlay & drawer -->
<div class="drawer-scrim" id="mobile-scrim" aria-hidden="true" data-nav-overlay></div>

<aside class="drawer" id="mobile-drawer" aria-label="Navigation menu" aria-hidden="true" inert>
  <div class="drawer-head">
    <a href={base} class="nav-brand">
      <img class="brand-icon-light" src={base + "awesome-github/LS-Agency-Site-Icon-Blue.svg"} alt="" width="26" height="26" />
      <img class="brand-icon-dark" src={base + "awesome-github/LS-Agency-Site-Icon-Light-Blue.svg"} alt="" width="26" height="26" />
      <b>Awesome<span class="tld"> GitHub</span></b>
    </a>
    <button class="icon-btn" type="button" data-drawer-close aria-label="Close menu">
      <Icon name="ph:x" size={20} />
    </button>
  </div>

  <div class="drawer-body">
    <!-- Search -->
    <div class="drawer-sec">
      <button class="search-trigger" type="button" data-search-open style="width: 100%;" aria-label="Search resources">
        <Icon name="ph:magnifying-glass" size={16} />
        <span class="stxt" style="flex: 1; text-align: left;">Search resources</span>
      </button>
    </div>

    <!-- Browse categories -->
    <div class="drawer-sec">
      <h6>BROWSE</h6>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
        {CATEGORIES.map((cat) => (
          <a href={`${base}c/${cat.id}/`} class="drawer-link">
            <Icon name={cat.icon} size={18} class="dli" />
            <span>{cat.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Cook & Learn -->
    <div class="drawer-sec">
      <h6>COOK & LEARN</h6>
      <a href={`${base}cookbook/`} class="drawer-link">
        <Icon name="ph:cooking-pot" size={18} class="dli" />
        <span>Cookbook</span>
      </a>
      <a href={`${base}learn/`} class="drawer-link">
        <Icon name="ph:graduation-cap" size={18} class="dli" />
        <span>Learning Centre</span>
      </a>
    </div>

    <!-- Resources -->
    <div class="drawer-sec">
      <h6>RESOURCES</h6>
      <a href={`${base}onboarding/`} class="drawer-link">
        <Icon name="ph:lightning" size={18} class="dli" />
        <span>Onboarding journey</span>
      </a>
      <a href={`${base}getting-started/`} class="drawer-link">
        <Icon name="ph:download-simple" size={18} class="dli" />
        <span>Getting started</span>
      </a>
      <a href={`${base}why/`} class="drawer-link">
        <Icon name="ph:info" size={18} class="dli" />
        <span>Why this exists</span>
      </a>
      <a href={`${base}glossary/`} class="drawer-link">
        <Icon name="ph:book-open" size={18} class="dli" />
        <span>Glossary</span>
      </a>
      <a href={`${base}references/`} class="drawer-link">
        <Icon name="ph:github-logo" size={18} class="dli" />
        <span>References</span>
      </a>
    </div>

    <!-- Install source (branch + theme) -->
    <div class="drawer-sec">
      <h6>INSTALL SOURCE</h6>
      <div class="drawer-row">
        <span class="rl">Branch</span>
        <div class="branch">
          <button class="branch-btn" data-branch="main" aria-pressed="true">
            <span class="bdot"></span>main
          </button>
          <button class="branch-btn" data-branch="develop" aria-pressed="false">
            <span class="bdot"></span>dev
          </button>
        </div>
      </div>
      <div class="drawer-row">
        <span class="rl">Theme</span>
        <button class="icon-btn" type="button" data-awesome-github-theme-toggle aria-pressed="false">
          <Icon name="ph:sun" size={18} class="sun-icon" />
          <Icon name="ph:moon" size={18} class="moon-icon" />
        </button>
      </div>
    </div>

    <!-- External -->
    <div class="drawer-sec">
      <h6>EXTERNAL</h6>
      <a href="https://github.com/lightspeedwp/.github" target="_blank" rel="noopener noreferrer" class="drawer-link">
        <Icon name="ph:github-logo" size={18} class="dli" />
        <span>.github repository</span>
        <Icon name="ph:arrow-square-out" size={14} class="ext" />
      </a>
      <a href="https://lightspeedwp.agency/" target="_blank" rel="noopener noreferrer" class="drawer-link">
        <Icon name="ph:lightning" size={18} class="dli" />
        <span>LightSpeed site</span>
        <Icon name="ph:arrow-square-out" size={14} class="ext" />
      </a>
    </div>
  </div>
</aside>

<script>
  // ── Browse dropdown ────────────────────────────────────────────────
  const browseWrapper = document.querySelector<HTMLElement>("[data-browse-menu]");
  const browseTrigger = browseWrapper?.querySelector<HTMLButtonElement>(".nav-btn");
  const browsePanel = document.getElementById("browse-panel");

  if (browseWrapper && browseTrigger && browsePanel) {
    const openBrowse = () => {
      browseWrapper.dataset.open = "";
      browseTrigger.setAttribute("aria-expanded", "true");
    };
    const closeBrowse = () => {
      delete browseWrapper.dataset.open;
      browseTrigger.setAttribute("aria-expanded", "false");
    };

    browseWrapper.addEventListener("mouseenter", openBrowse);
    browseWrapper.addEventListener("mouseleave", closeBrowse);

    browseTrigger.addEventListener("click", () => {
      browseWrapper.hasAttribute("data-open") ? closeBrowse() : openBrowse();
    });

    browseWrapper.addEventListener("focusout", (e) => {
      const related = (e as FocusEvent).relatedTarget;
      if (related instanceof Element && browseWrapper.contains(related)) return;
      closeBrowse();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && browseWrapper.hasAttribute("data-open")) {
        closeBrowse();
        browseTrigger.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (e.target instanceof Element && !browseWrapper.contains(e.target)) {
        closeBrowse();
      }
    });

    browsePanel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeBrowse);
    });
  }

  // ── Resources dropdown ────────────────────────────────────────────────
  const resourcesWrapper = document.querySelector<HTMLElement>("[data-resources-menu]");
  const resourcesTrigger = resourcesWrapper?.querySelector<HTMLButtonElement>(".nav-btn");
  const resourcesPanel = document.getElementById("resources-panel");

  if (resourcesWrapper && resourcesTrigger && resourcesPanel) {
    const openResources = () => {
      resourcesWrapper.dataset.open = "";
      resourcesTrigger.setAttribute("aria-expanded", "true");
    };
    const closeResources = () => {
      delete resourcesWrapper.dataset.open;
      resourcesTrigger.setAttribute("aria-expanded", "false");
    };

    resourcesWrapper.addEventListener("mouseenter", openResources);
    resourcesWrapper.addEventListener("mouseleave", closeResources);

    resourcesTrigger.addEventListener("click", () => {
      resourcesWrapper.hasAttribute("data-open") ? closeResources() : openResources();
    });

    resourcesWrapper.addEventListener("focusout", (e) => {
      const related = (e as FocusEvent).relatedTarget;
      if (related instanceof Element && resourcesWrapper.contains(related)) return;
      closeResources();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && resourcesWrapper.hasAttribute("data-open")) {
        closeResources();
        resourcesTrigger.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (e.target instanceof Element && !resourcesWrapper.contains(e.target)) {
        closeResources();
      }
    });

    resourcesPanel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeResources);
    });
  }

  // ── Branch toggle ──────────────────────────────────────────────────────
  const BRANCH_STORAGE_KEY = "github_branch";
  const branchBtns = document.querySelectorAll<HTMLButtonElement>(".branch-btn");

  const initBranch = () => {
    const saved = localStorage.getItem(BRANCH_STORAGE_KEY) || "main";
    branchBtns.forEach((btn) => {
      const branch = btn.getAttribute("data-branch");
      btn.setAttribute("aria-pressed", branch === saved ? "true" : "false");
    });
  };

  initBranch();

  branchBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const branch = btn.getAttribute("data-branch");
      localStorage.setItem(BRANCH_STORAGE_KEY, branch || "main");
      branchBtns.forEach((b) => {
        b.setAttribute("aria-pressed", b.getAttribute("data-branch") === branch ? "true" : "false");
      });
    });
  });

  // ── Mobile drawer ──────────────────────────────────────────────────────
  const hamburger = document.querySelector<HTMLButtonElement>("[data-nav-hamburger]");
  const drawer = document.getElementById("mobile-drawer");
  const scrim = document.getElementById("mobile-scrim");
  const drawerClose = drawer?.querySelector<HTMLButtonElement>("[data-drawer-close]");

  if (hamburger && drawer && scrim) {
    const bgEls = Array.from(document.querySelectorAll<HTMLElement>("body > :not(header):not(aside):not(.drawer-scrim)"));

    const openDrawer = () => {
      hamburger.setAttribute("aria-expanded", "true");
      drawer.setAttribute("aria-hidden", "false");
      drawer.removeAttribute("inert");
      scrim.setAttribute("aria-hidden", "false");
      document.body.classList.add("ag-drawer-open");
      bgEls.forEach((el) => el.setAttribute("inert", ""));
    };

    const closeDrawer = () => {
      hamburger.setAttribute("aria-expanded", "false");
      drawer.setAttribute("aria-hidden", "true");
      drawer.setAttribute("inert", "");
      scrim.setAttribute("aria-hidden", "true");
      document.body.classList.remove("ag-drawer-open");
      bgEls.forEach((el) => el.removeAttribute("inert"));
    };

    hamburger.addEventListener("click", () => {
      hamburger.getAttribute("aria-expanded") === "true" ? closeDrawer() : openDrawer();
    });

    drawerClose?.addEventListener("click", closeDrawer);
    scrim.addEventListener("click", closeDrawer);

    drawer.querySelectorAll("a, [data-search-open]").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && hamburger.getAttribute("aria-expanded") === "true") {
        closeDrawer();
        hamburger.focus();
      }
    });

    window.matchMedia("(min-width: 1025px)").addEventListener("change", (e) => {
      if (e.matches) closeDrawer();
    });
  }

  // ── Theme toggle icon visibility & aria-pressed sync ────────────────────
  const syncThemePressed = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    document.querySelectorAll<HTMLElement>("[data-awesome-github-theme-toggle]").forEach((btn) => {
      btn.setAttribute("aria-pressed", isDark ? "true" : "false");
    });
  };

  syncThemePressed();
  document.addEventListener("theme-changed", syncThemePressed);
</script>

<style>
  /* ── Nav bar ───────────────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hair);
  }

  .wrap {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 64px;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ── Brand ──────────────────────────────────────────────────────────── */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg-1);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-brand img {
    height: 26px;
    width: auto;
  }

  .brand-icon-light {
    display: inline;
  }

  .brand-icon-dark {
    display: none;
  }

  [data-theme="dark"] .brand-icon-light {
    display: none;
  }

  [data-theme="dark"] .brand-icon-dark {
    display: inline;
  }

  .nav-brand b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.02em;
  }

  .nav-brand .tld {
    color: var(--accent);
  }

  /* ── Primary nav ────────────────────────────────────────────────────── */
  .nav-primary {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 10px;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-2);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .nav-btn:hover,
  .nav-btn[aria-expanded="true"] {
    color: var(--fg-1);
    background: var(--panel-2);
  }

  .nav-btn[aria-current="page"] {
    color: var(--accent);
  }

  .nav-btn .chev {
    transition: transform var(--dur) var(--ease-out);
  }

  .nav-btn[aria-expanded="true"] .chev {
    transform: rotate(180deg);
  }

  /* ── Dropdowns ──────────────────────────────────────────────────────── */
  .browse-wrapper,
  .resources-wrapper {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: calc(100% - 4px);
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 10px;
    z-index: 55;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity var(--dur) var(--ease-out), visibility var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .browse-wrapper[data-open] .dropdown,
  .resources-wrapper[data-open] .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Browse dropdown: 2×4 grid */
  .dd-cats {
    width: min(620px, 92vw);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .dd-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur) var(--ease-out);
  }

  .dd-item:hover {
    background: var(--panel-2);
  }

  .dd-item .ddi {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    flex: none;
  }

  .dd-item b {
    font-size: 14px;
    color: var(--fg-1);
    font-family: var(--font-display);
    font-weight: 700;
    display: block;
  }

  .dd-item span {
    font-size: 12px;
    color: var(--fg-3);
    line-height: 1.4;
  }

  /* Resources dropdown: simple list */
  .dd-res {
    width: 250px;
  }

  .dd-simple {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: var(--radius-md);
    font-size: 14px;
    color: var(--fg-1);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .dd-simple:hover {
    background: var(--panel-2);
    color: var(--accent);
  }

  .dd-simple .ddi {
    color: var(--fg-3);
    transition: color var(--dur) var(--ease-out);
  }

  .dd-simple:hover .ddi {
    color: var(--accent);
  }

  /* ── Search trigger ────────────────────────────────────────────────── */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: var(--panel-2);
    border: 1px solid var(--hair);
    color: var(--fg-2);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    font-size: 13px;
    min-width: 200px;
    transition: border-color var(--dur) var(--ease-out);
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
  }

  .search-trigger .kbd {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--bg);
    border: 1px solid var(--hair);
    color: var(--fg-3);
  }

  /* ── Nav actions ────────────────────────────────────────────────────── */
  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-extra {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Branch toggle ──────────────────────────────────────────────────── */
  .branch {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hair);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--panel);
  }

  .branch-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-3);
    padding: 7px 11px;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .branch-btn:hover {
    color: var(--fg-1);
  }

  .branch-btn[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .bdot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* ── Icon button ────────────────────────────────────────────────────── */
  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--hair);
    border-radius: var(--radius-md);
    color: var(--fg-2);
    padding: 0;
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .icon-btn:hover {
    color: var(--fg-1);
    background: var(--panel-2);
  }

  /* Theme icon visibility */
  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: inline-flex;
  }

  [data-theme="dark"] .sun-icon {
