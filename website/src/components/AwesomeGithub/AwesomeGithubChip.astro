---
interface Props {
  variant?: "default" | "success" | "warning" | "error" | "info";
  size?: "sm" | "md";
  class?: string;
}

const { variant = "default", size = "md", class: className = "" } = Astro.props;
---

<span class={`ag-chip ag-chip--${variant} ag-chip--${size} ${className}`}>
  <slot />
</span>

<style>
  .ag-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-body-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent);
    white-space: nowrap;
  }

  /* Variants */
  .ag-chip--default {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
  }

  .ag-chip--success {
    background: rgba(22, 163, 74, 0.1);
    color: var(--c-status-success);
    border-color: var(--c-status-success);
  }

  .ag-chip--warning {
    background: rgba(245, 158, 11, 0.1);
    color: var(--c-status-warning);
    border-color: var(--c-status-warning);
  }

  .ag-chip--error {
    background: rgba(239, 68, 68, 0.1);
    color: var(--c-status-error);
    border-color: var(--c-status-error);
  }

  .ag-chip--info {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Sizes */
  .ag-chip--sm {
    padding: var(--space-1) var(--space-2);
    font-size: 12px;
  }

  .ag-chip--md {
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-body-sm);
  }

  /* Dark mode adjustments */
  [data-theme="dark"] .ag-chip--success {
    background: rgba(34, 197, 94, 0.15);
  }

  [data-theme="dark"] .ag-chip--warning {
    background: rgba(245, 158, 11, 0.15);
  }

  [data-theme="dark"] .ag-chip--error {
    background: rgba(239, 68, 68, 0.15);
  }
</style>
