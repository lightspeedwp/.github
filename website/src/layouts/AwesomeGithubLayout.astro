---
import "../styles/global.css";
import "../styles/awesome-github.css";
import Header from "../components/Header.astro";
import AwesomeGithubFooter from "../components/AwesomeGithub/AwesomeGithubFooter.astro";
import SearchPalette from "../components/SearchPalette.astro";

const base = import.meta.env.BASE_URL;

const {
  title = "Awesome GitHub",
  description = "Governance, not opinions.",
} = Astro.props;

const themeInitScript = `(function(){try{var s='ag-theme',t=localStorage.getItem(s),m=window.matchMedia&&matchMedia('(prefers-color-scheme:dark)').matches;if(t!=='light'&&t!=='dark')t=m?'dark':'light';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}catch(e){}})();`;
---

<!doctype html>
<html lang="en-GB" class="awesome-github">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Theme init: runs before stylesheets paint to prevent flash-of-wrong-theme -->
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body class="awesome-github">
    <a href="#main-content" class="ag-skip-link">Skip to main content</a>
    <Header />
    <SearchPalette />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <AwesomeGithubFooter />
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ag-skip-link {
    position: absolute;
    top: -100%;
    left: var(--gutter, 32px);
    z-index: 9999;
    padding: 12px 24px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-body, system-ui, sans-serif);
    text-decoration: none;
    border-radius: 0 0 8px 8px;
    transition: top 0.1s;
  }

  .ag-skip-link:focus {
    top: 0;
    outline: 2px solid var(--accent-contrast);
    outline-offset: -3px;
  }
</style>
