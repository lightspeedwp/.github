---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(base, "/");

const navSections = [
  {
    label: "WCEU 2026",
    links: [
      {
        href: `${base}wceu-2026/`,
        path: "/wceu-2026/",
        label: "Talk",
      },
    ],
  },
  {
    label: "Site",
    links: [
      {
        href: base,
        path: "/",
        label: "Home",
      },
      {
        href: `${base}why-this-exists/`,
        path: "/why-this-exists/",
        label: "Why this exists",
      },
      {
        href: `${base}references/`,
        path: "/references/",
        label: "References",
      },
    ],
  },
];

const {
  title = "Awesome GitHub",
  description = "A conference-ready website for the Awesome GitHub project.",
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="nav" aria-label="Primary">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-copy">
            <span class="brand-name">Awesome GitHub</span>
            <span class="brand-subtitle">Conference site on GitHub Pages</span>
          </span>
        </a>
        <div class="nav-menus">
          {navSections.map((section) => (
            <section class="nav-group" aria-label={section.label}>
              <span class="nav-group-label">{section.label}</span>
              <nav class="nav-links">
                {section.links.map((link) => (
                  <a href={link.href} aria-current={pathname === link.path ? "page" : undefined}>
                    {link.label}
                  </a>
                ))}
              </nav>
            </section>
          ))}
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <div class="footer-copy">
          <strong>Awesome GitHub</strong>
          <span>Conference site and reference index for the WCEU 2026 talk.</span>
        </div>
        <div class="footer-links" aria-label="Footer links">
          <a href={base}>Home</a>
          <a href={`${base}wceu-2026/`}>WCEU 2026 talk</a>
          <a href={`${base}references/`}>References</a>
        </div>
      </footer>
    </div>
  </body>
</html>
