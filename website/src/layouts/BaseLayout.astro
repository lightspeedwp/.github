---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(base, "/");

const navSections = [
  {
    label: "Docs",
    isDropdown: true,
    links: [
      {
        href: `${base}getting-started/`,
        path: "/getting-started/",
        label: "Getting Started",
        exact: false,
      },
      {
        href: `${base}introduction/`,
        path: "/introduction/",
        label: "Introduction",
        exact: false,
      },
      {
        href: `${base}agents/`,
        path: "/agents/",
        label: "Agents",
        exact: false,
      },
      {
        href: `${base}instructions/`,
        path: "/instructions/",
        label: "Instructions",
        exact: false,
      },
      {
        href: `${base}skills/`,
        path: "/skills/",
        label: "Skills",
        exact: false,
      },
      {
        href: `${base}hooks/`,
        path: "/hooks/",
        label: "Hooks",
        exact: false,
      },
      {
        href: `${base}plugins/`,
        path: "/plugins/",
        label: "Plugins",
        exact: false,
      },
      {
        href: `${base}workflows/`,
        path: "/workflows/",
        label: "Workflows",
        exact: false,
      },
      {
        href: `${base}tools/`,
        path: "/tools/",
        label: "Tools",
        exact: false,
      },
      {
        href: `${base}learning-hub/`,
        path: "/learning-hub/",
        label: "Learning Hub",
        exact: false,
      },
    ],
  },
  {
    label: "Talk",
    links: [
      {
        href: `${base}talk/`,
        path: "/talk/",
        label: "WCEU 2026",
        exact: false,
      },
    ],
  },
];

const {
  title = "Awesome GitHub",
  description = "A conference-ready website for the Awesome GitHub project.",
} = Astro.props;

const themeInitScript = `
  (() => {
    const storageKey = "awesome-github-theme";
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: light)");
    let saved = null;

    try {
      saved = localStorage.getItem(storageKey);
    } catch (_) {
      saved = null;
    }

    const theme = saved === "light" || saved === "dark" ? saved : media.matches ? "light" : "dark";
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
  })();
`;

const themeToggleScript = `
  (() => {
    const storageKey = "awesome-github-theme";
    const root = document.documentElement;
    const button = document.querySelector("[data-theme-toggle]");
    const label = document.querySelector("[data-theme-label]");

    if (!button || !label) {
      return;
    }

    const apply = (theme) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      button.setAttribute("aria-pressed", String(theme === "light"));
      label.textContent = theme === "light" ? "Light mode" : "Dark mode";
    };

    const current = root.dataset.theme === "light" || root.dataset.theme === "dark"
      ? root.dataset.theme
      : (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");

    apply(current);

    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      try {
        localStorage.setItem(storageKey, next);
      } catch (_) {
        /* ignore storage errors */
      }
      apply(next);
    });
  })();
`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body>
    <div class="shell">
      <header class="nav" aria-label="Primary">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-copy">
            <span class="brand-name">Awesome GitHub</span>
            <span class="brand-subtitle">Conference site on GitHub Pages</span>
          </span>
        </a>
        <div class="nav-menus">
          {navSections.map((section) => (
            <section class="nav-group">
              <span class="nav-group-label">{section.label}</span>
              <nav class="nav-links" aria-label={section.label}>
                {section.links.map((link) => (
                  <a
                    href={link.href}
                    aria-current={
                      link.exact
                        ? pathname === link.path
                          ? "page"
                          : undefined
                        : pathname.startsWith(link.path)
                          ? "page"
                          : undefined
                    }
                  >
                    {link.label}
                  </a>
                ))}
              </nav>
            </section>
          ))}
        </div>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Toggle light and dark mode"
        >
          <span class="theme-toggle-label" data-theme-label>Dark mode</span>
        </button>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <div class="footer-copy">
          <strong>© 2026 LightSpeed</strong>
          <span>Built for the WordPress ecosystem.</span>
        </div>
        <nav class="footer-links" aria-label="Footer links">
          <a href="https://lightspeedwp.agency/" target="_blank" rel="noreferrer">LightSpeed Website</a>
          <a href="https://github.com/lightspeedwp/.github" target="_blank" rel="noreferrer">.github Repository</a>
          <a href={`${base}talk/`}>WCEU 2026 Talk</a>
        </nav>
      </footer>
    </div>
    <script is:inline set:html={themeToggleScript}></script>
  </body>
</html>
